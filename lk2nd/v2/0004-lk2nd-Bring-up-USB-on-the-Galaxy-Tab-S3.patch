diff --git a/platform/msm_shared/qmp_usb30_phy.c b/platform/msm_shared/qmp_usb30_phy.c
index c2904c0a7..2a537edd5 100644
--- a/platform/msm_shared/qmp_usb30_phy.c
+++ b/platform/msm_shared/qmp_usb30_phy.c
@@ -38,6 +38,7 @@
 #include <qtimer.h>
 #include <platform.h>
 #include <target.h>
+#include <lk2nd/device.h>
 
 #define HS_PHY_COMMON_CTRL             0xEC
 #define USE_CORECLK                    BIT(14)
@@ -261,6 +262,19 @@ void usb30_qmp_phy_init(void)
 	uint32_t qmp_reg_size;
 	uint32_t i;
 
+	/*
+	 * Some devices route the SuperSpeed lanes through a redriver or a
+	 * Type-C orientation switch that lk2nd does not set up. The
+	 * controller then retries SuperSpeed forever instead of falling back
+	 * to high speed, and the host never sees it. Take the same path as
+	 * a QMP PHY that fails to initialize.
+	 */
+	if (lk2nd_device_usb_high_speed_only()) {
+		dprintf(INFO, "USB: high speed only, QMP PHY left alone\n");
+		hsonly_mode = true;
+		return;
+	}
+
 
 #if USE_TARGET_QMP_SETTINGS
 	struct qmp_reg *target_qmp_settings = NULL;
diff --git a/platform/msm_shared/usb30_dwc.c b/platform/msm_shared/usb30_dwc.c
index 8d58aa9b8..8b73849ce 100644
--- a/platform/msm_shared/usb30_dwc.c
+++ b/platform/msm_shared/usb30_dwc.c
@@ -1577,6 +1577,9 @@ void dwc_device_init(dwc_dev_t *dev)
 	/* 16. initialize global control reg for device mode operation */
 	dwc_gctl_init(dev);
 
+	/* SuperSpeed, or high speed when the QMP PHY is not used */
+	dwc_device_set_max_speed(dev);
+
 	/* 17. AXI master config */
 	dwc_axi_master_config(dev);
 
diff --git a/platform/msm_shared/usb30_dwc_hw.c b/platform/msm_shared/usb30_dwc_hw.c
index baa7be2cf..95444bbb4 100644
--- a/platform/msm_shared/usb30_dwc_hw.c
+++ b/platform/msm_shared/usb30_dwc_hw.c
@@ -361,6 +361,17 @@ void dwc_device_set_addr(dwc_dev_t *dev, uint16_t addr)
 	REG_WRITE_FIELD(dev, DCFG, DEVADDR, addr);
 }
 
+/* set the fastest speed the device may connect at */
+void dwc_device_set_max_speed(dwc_dev_t *dev)
+{
+	/* In high-speed only mode the SuperSpeed PHY is not set up. Left at
+	 * SuperSpeed (the reset value), the core keeps trying to detect a
+	 * SuperSpeed receiver and never connects at high speed.
+	 */
+	REG_WRITE_FIELD(dev, DCFG, DEVSPD,
+			use_hsonly_mode() ? DSTS_CONNECTSPD_HS : DSTS_CONNECTSPD_SS);
+}
+
 /* reset device */
 void dwc_device_reset(dwc_dev_t *dev)
 {
