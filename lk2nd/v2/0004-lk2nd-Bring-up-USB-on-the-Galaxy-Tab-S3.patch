+bool lk2nd_device_usb_high_speed_only(void);
 #else
 static inline const char *const *lk2nd_device_get_dtb_hints(void) { return NULL; };
 static inline uint32_t lk2nd_device_get_sd_mmc_slot_num(void) { return 0; };
