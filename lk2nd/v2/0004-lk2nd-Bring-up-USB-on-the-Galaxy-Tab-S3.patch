index 4c3398624..4ca062b64 100644
--- a/lk2nd/include/lk2nd/device.h
+++ b/lk2nd/include/lk2nd/device.h
@@ -13,9 +13,11 @@ void lk2nd_device2nd_copy_atags(void *tags, const char *cmdline,
 #if WITH_LK2ND_DEVICE
 const char *const *lk2nd_device_get_dtb_hints(void);
