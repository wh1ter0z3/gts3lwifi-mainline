From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Fri, 30 Oct 2026 12:21:10 +0530
Subject: [PATCH 3/6] dts: msm8996: Add support for Samsung Galaxy Tab S3

WIP, parked: S-Boot needs the Samsung packing (scripts/pack-lk2nd-samsung.sh
in gts3lwifi-mainline) on top of the plain lk2nd build.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Documentation/devices.md                      |  1 +
 .../dts/msm8996/msm8996-samsung-gts3llte.dts  | 32 +++++++++++++++++++
 .../dts/msm8996/msm8996-samsung-gts3lwifi.dts | 32 +++++++++++++++++++
 lk2nd/device/dts/msm8996/rules.mk             |  2 ++
 4 files changed, 67 insertions(+)
 create mode 100644 lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts
 create mode 100644 lk2nd/device/dts/msm8996/msm8996-samsung-gts3lwifi.dts

diff --git a/Documentation/devices.md b/Documentation/devices.md
index 004c4f92f..ac1c4efd2 100644
--- a/Documentation/devices.md
+++ b/Documentation/devices.md
@@ -232,6 +232,7 @@
 - LG V20 - h990
 - OnePlus 3
 - OnePlus 3T
+- Samsung Galaxy Tab S3 - SM-T820, SM-T825
 - Xiaomi Mi 5 - gemini
 - Xiaomi Mi 5s - capricorn
 - Xiaomi Mi 5s Plus - natrium
diff --git a/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts
new file mode 100644
index 000000000..33978ee5d
--- /dev/null
+++ b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <skeleton64.dtsi>
+#include <lk2nd.dtsi>
+
+/ {
+	/* MSM8996 with PM8994 + PM8004, the same PMICs as the Wi-Fi model */
+	qcom,msm-id = <QCOM_ID_MSM8996 0x10000>;
+	qcom,board-id = <8 0>, <8 2>, <8 4>, <8 5>;
+	qcom,pmic-id = <0x20009 0x1000c 0x0 0x0>;
+};
+
+&lk2nd {
+	model = "Samsung Galaxy Tab S3 (LTE)";
+	compatible = "samsung,gts3llte";
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		/* PM8994 GPIO 2 is the Home key, GPIO 3 Volume Up */
+		volume-up {
+			lk2nd,code = <KEY_VOLUMEUP>;
+			gpios = <&pmic 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+		};
+
+		/* Volume Down is the PM8994 PON RESIN input, not a GPIO */
+		volume-down {
+			lk2nd,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pmic_pon GPIO_PMIC_RESIN 0>;
+		};
+	};
+};
diff --git a/lk2nd/device/dts/msm8996/msm8996-samsung-gts3lwifi.dts b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3lwifi.dts
new file mode 100644
index 000000000..0384184a7
--- /dev/null
+++ b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3lwifi.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <skeleton64.dtsi>
+#include <lk2nd.dtsi>
+
+/ {
+	/* From the stock SM-T820 DTB: APQ8096 with PM8994 + PM8004 */
+	qcom,msm-id = <QCOM_ID_APQ8096 0x30001>;
+	qcom,board-id = <8 0>, <8 2>, <8 4>, <8 5>;
+	qcom,pmic-id = <0x20009 0x1000c 0x0 0x0>;
+};
+
+&lk2nd {
+	model = "Samsung Galaxy Tab S3 (Wi-Fi)";
+	compatible = "samsung,gts3lwifi";
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		/* PM8994 GPIO 2 is the Home key, GPIO 3 Volume Up */
+		volume-up {
+			lk2nd,code = <KEY_VOLUMEUP>;
+			gpios = <&pmic 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+		};
+
+		/* Volume Down is the PM8994 PON RESIN input, not a GPIO */
+		volume-down {
+			lk2nd,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pmic_pon GPIO_PMIC_RESIN 0>;
+		};
+	};
+};
diff --git a/lk2nd/device/dts/msm8996/rules.mk b/lk2nd/device/dts/msm8996/rules.mk
index e38b966b2..95d0570cf 100644
--- a/lk2nd/device/dts/msm8996/rules.mk
+++ b/lk2nd/device/dts/msm8996/rules.mk
@@ -7,6 +7,8 @@ ADTBS += \
 	$(LOCAL_DIR)/msm8996-lg-h850.dtb \
 	$(LOCAL_DIR)/msm8996-lg-h990.dtb \
 	$(LOCAL_DIR)/msm8996-oneplus3.dtb \
+	$(LOCAL_DIR)/msm8996-samsung-gts3llte.dtb \
+	$(LOCAL_DIR)/msm8996-samsung-gts3lwifi.dtb \
 	$(LOCAL_DIR)/msm8996-xiaomi-mi5.dtb \
 	$(LOCAL_DIR)/msm8996-xiaomi-mi5s.dtb \
 	$(LOCAL_DIR)/msm8996-xiaomi-mi5s-plus.dtb \
