 	dprintf(INFO, "boot: Bootable file system not found. Reverting to android boot.\n");
@@ -72,12 +99,78 @@ static void lk2nd_scan_devices(void)
  */
 void lk2nd_boot(void)
 {
-	static bool init_done = false;
+	lk2nd_bdev_init_once();
