 /**
  * lk2nd_try_extlinux() - Try to boot with extlinux
+ * @root: mountpoint of the file system
+ * @name: label to boot, or NULL for the default label
  *
  * Check if /extlinux/extlinux.conf exists and try to
  * boot it if so.
  */
-void lk2nd_try_extlinux(const char *root)
+void lk2nd_try_extlinux(const char *root, const char *name)
 {
 	struct filehandle *fileh;
 	struct file_stat stat;
@@ -684,7 +696,7 @@ void lk2nd_try_extlinux(const char *root)
 	fs_read_file(fileh, data, 0, stat.size);
 	fs_close_file(fileh);
 
-	ret = parse_conf(data, stat.size, &label);
+	ret = parse_conf(data, stat.size, &label, name);
 	if (ret < 0)
 		goto error;
 
@@ -708,3 +720,41 @@ error:
 	dprintf(INFO, "Failed to parse extlinux.conf\n");
 	free(data);
 }
+
+/**
+ * lk2nd_extlinux_labels() - List the labels of an extlinux.conf
+ * @root: mountpoint of the file system
+ * @names: array to write the label names to
+ * @max: length of @names
+ *
+ * Returns: number of labels written, 0 if there is no extlinux.conf.
+ */
+int lk2nd_extlinux_labels(const char *root, char (*names)[LK2ND_LABEL_NAME_LEN], int max)
+{
+	struct filehandle *fileh;
+	struct file_stat stat;
+	char *command, *value;
+	char path[64];
+	char *data, *p;
+	size_t size;
+	int count = 0;
+
+	snprintf(path, sizeof(path), "%s/extlinux/extlinux.conf", root);
+	if (fs_open_file(path, &fileh) < 0)
+		return 0;
+
+	fs_stat_file(fileh, &stat);
+	data = malloc(stat.size + 1);
+	fs_read_file(fileh, data, 0, stat.size);
+	fs_close_file(fileh);
+
+	p = data;
+	size = stat.size;
+	while (count < max && parse_command(&p, &size, &command, &value) == 0) {
+		if (cmd_to_tok(command) == CMD_LABEL && value)
+			strlcpy(names[count++], value, LK2ND_LABEL_NAME_LEN);
+	}
+
+	free(data);
+	return count;
+}
