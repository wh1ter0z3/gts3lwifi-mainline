-		init_done = true;
+/**
+ * lk2nd_boot_extlinux_label() - Boot an extlinux label other than the default.
+ * @name: label to boot
+ *
+ * Returns only if the label could not be booted.
+ */
+void lk2nd_boot_extlinux_label(const char *name)
+{
+	lk2nd_bdev_init_once();
+	lk2nd_scan_devices(name);
+}
+
+/**
+ * lk2nd_boot_list_labels() - List the labels lk2nd can boot.
+ * @names: array to write the label names to
+ * @max: length of @names
+ *
+ * Lists the labels of the first extlinux.conf found, the one lk2nd boots
+ * from unless it fails.
+ *
+ * Returns: number of labels.
+ */
+int lk2nd_boot_list_labels(char (*names)[LK2ND_LABEL_NAME_LEN], int max)
+{
+	struct bdev_struct *bdevs = bio_get_bdevs();
+	char mountpoint[16];
+	bdev_t *bdev;
+	int count;
+
+	lk2nd_bdev_init_once();
+
+	list_for_every_entry(&bdevs->list, bdev, bdev_t, node) {
+		if (!lk2nd_mount(bdev, mountpoint, sizeof(mountpoint)))
+			continue;
+
+		count = lk2nd_extlinux_labels(mountpoint, names, max);
+		if (count > 0)
+			return count;
+	}
+
+	return 0;
+}
+
+static void cmd_oem_boot_label(const char *arg, void *data, unsigned sz)
+{
+	char names[8][LK2ND_LABEL_NAME_LEN];
+	int i, count;
+
+	while (*arg == ' ')
+		arg++;
+
+	count = lk2nd_boot_list_labels(names, ARRAY_SIZE(names));
+	for (i = 0; i < count; i++)
+		if (!strcmp(names[i], arg))
+			break;
+
+	if (i == count) {
+		fastboot_fail("no such extlinux label");
+		return;
 	}
 
-	lk2nd_scan_devices();
+	fastboot_okay("");
+	fastboot_stop();
+
+	lk2nd_boot_extlinux_label(arg);
+
+	/* The default label is the safe choice now that fastboot is gone. */
+	dprintf(CRITICAL, "Failed to boot '%s', rebooting\n", arg);
+	reboot_device(0);
 }
+FASTBOOT_REGISTER("oem boot-label", cmd_oem_boot_label);
