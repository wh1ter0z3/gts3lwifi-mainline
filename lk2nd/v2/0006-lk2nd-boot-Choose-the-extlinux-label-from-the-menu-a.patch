+/**
+ * lk2nd_mount() - Mount a partition that may hold a boot file system
+ * @bdev: block device to mount
+ * @mountpoint: buffer for the mountpoint
+ * @len: size of @mountpoint
+ *
+ * Returns: true if the file system is mounted at @mountpoint (now or before).
+ */
+static bool lk2nd_mount(bdev_t *bdev, char *mountpoint, size_t len)
+{
+	int ret;
+
+	/* Skip top level block devices. */
+	if (!bdev->is_leaf)
+		return false;
+
+	/*
+	 * Skip partitions that are too small to have a boot fs on.
+	 *
+	 * 'boot' partition is explicitly allowed to have a small fs on it
+	 * in case one installs next stage bootloader package (i.e. u-boot)
+	 * there but still wants to make use of lk2nd's device database.
+	 */
+	if (bdev->size < LK2ND_BOOT_MIN_SIZE &&
+	    !(bdev->label && !strncmp(bdev->label, "boot", strlen("boot"))))
+		return false;
+
+	snprintf(mountpoint, len, "/%s", bdev->name);
+	ret = fs_mount(mountpoint, "ext2", bdev->name);
+	return ret >= 0 || ret == ERR_ALREADY_MOUNTED;
+}
+
+static void lk2nd_bdev_init_once(void)
+{
+	static bool init_done = false;
+
+	if (!init_done) {
+		lk2nd_bdev_init();
+		init_done = true;
+	}
+}
