  */
-static int parse_conf(char *data, size_t size, struct label *label)
+static int parse_conf(char *data, size_t size, struct label *label, const char *name)
 {
 	char *command = NULL, *value = NULL;
 	char *overlay, *saveptr;
@@ -302,7 +303,9 @@ static int parse_conf(char *data, size_t size, struct label *label)
 		}
 	}
 
-	default_label = &labels[0];
+	default_label = name ? NULL : &labels[0];
+	if (name)
+		default_name = name;
 
 	for (i = 0; i < labels_count; ++i) {
 		if (!strcmp(default_name, labels[i].name)) {
@@ -311,6 +314,13 @@ static int parse_conf(char *data, size_t size, struct label *label)
 		}
 	}
 
+	if (!default_label) {
+		dprintf(INFO, "No label '%s' in the extlinux.conf\n", name);
+		free(labels);
+		free(commands);
+		return -1;
