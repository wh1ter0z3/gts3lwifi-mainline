-static struct {
+struct menu_option {
 	char *name;
 	unsigned color;
 	void (*action)(void);
-} menu_options[] = {
-	{ "  Reboot  ", GREEN,  opt_reboot },
-	{ " Continue ", WHITE,  opt_continue },
-	{ " Recovery ", ORANGE, opt_recovery },
-	{ "Bootloader", ORANGE, opt_bootloader },
-	{ "    EDL   ", RED,    opt_edl },
-	{ " Shutdown ", RED,    opt_shutdown },
+	const char *label; /* extlinux label to boot instead of the action */
 };
 
+static const struct menu_option fixed_options[] = {
+	{ "  Reboot  ", GREEN,  opt_reboot, NULL },
+	{ " Continue ", WHITE,  opt_continue, NULL },
+	{ " Recovery ", ORANGE, opt_recovery, NULL },
+	{ "Bootloader", ORANGE, opt_bootloader, NULL },
+	{ "    EDL   ", RED,    opt_edl, NULL },
+	{ " Shutdown ", RED,    opt_shutdown, NULL },
+};
+
+/*
+ * The operating systems in extlinux.conf come first, so one can choose what
+ * to boot on devices that have more than one.
+ */
+#define MAX_LABELS	4
+static char label_names[MAX_LABELS][LK2ND_LABEL_NAME_LEN];
+static char label_titles[MAX_LABELS][LK2ND_LABEL_NAME_LEN + 5];
+static struct menu_option menu_options[MAX_LABELS + ARRAY_SIZE(fixed_options)];
+static unsigned int menu_options_count;
+
+static void build_menu_options(void)
+{
+	int i, count = 0, len, pad;
+
+#if WITH_LK2ND_BOOT
+	count = lk2nd_boot_list_labels(label_names, MAX_LABELS);
+#endif
+	menu_options_count = 0;
+	for (i = 0; i < count; i++) {
+		/* Center the name in the width of the other options. */
+		len = strlen(label_names[i]);
+		pad = len < 10 ? (10 - len) / 2 : 0;
+		memset(label_titles[i], ' ', sizeof(label_titles[i]) - 1);
+		memcpy(label_titles[i] + pad, label_names[i], len);
+		label_titles[i][max(10, pad + len)] = '\0';
+
+		menu_options[menu_options_count++] = (struct menu_option) {
+			label_titles[i], GREEN, NULL, label_names[i],
+		};
+	}
+	for (i = 0; i < (int)ARRAY_SIZE(fixed_options); i++)
+		menu_options[menu_options_count++] = fixed_options[i];
+}
