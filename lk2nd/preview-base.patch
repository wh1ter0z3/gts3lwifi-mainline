diff --git a/lk2nd/device/2nd/samsung-muic-usb.c b/lk2nd/device/2nd/samsung-muic-usb.c
new file mode 100644
index 00000000..bd29c17c
--- /dev/null
+++ b/lk2nd/device/2nd/samsung-muic-usb.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <bits.h>
+#include <debug.h>
+
+#include <libfdt.h>
+#include <lk2nd/hw/gpio_i2c.h>
+
+#include "device.h"
+
+/*
+ * Samsung MUICs such as the SM5703 and SM5705 only connect D+/D- to the USB
+ * PHY on their own when they recognize the cable from the resistance on the
+ * ID pin. Behind a USB Type-C port the ID pin may read as some accessory
+ * instead, and the downstream kernel switches D+/D- to USB manually. Without
+ * that, the USB controller runs but the host never sees the device.
+ */
+#define MUIC_REG_CONTROL		0x02
+#define MUIC_CONTROL_AUTO_SWITCH	BIT(2)
+#define MUIC_REG_MANUAL_SW1		0x13
+#define MUIC_MANUAL_SW1_DM_DP_MASK	0xfc
+#define MUIC_MANUAL_SW1_DM_DP_USB	(1 << 5 | 1 << 2)
+
+static int samsung_muic_usb_switch(const void *dtb, int node)
+{
+	uint8_t addr, val;
+	gpio_i2c_info_t i2c;
+	status_t status;
+
+	status = gpio_i2c_get(dtb, node, &i2c, &addr);
+	if (status)
+		return status;
+
+	/* Set the switch first, then stop the MUIC from changing it */
+	status = gpio_i2c_read_reg_bytes(&i2c, addr, MUIC_REG_MANUAL_SW1, &val, 1);
+	if (!status) {
+		val = (val & ~MUIC_MANUAL_SW1_DM_DP_MASK) | MUIC_MANUAL_SW1_DM_DP_USB;
+		status = gpio_i2c_write_reg_bytes(&i2c, addr, MUIC_REG_MANUAL_SW1, &val, 1);
+	}
+	if (!status)
+		status = gpio_i2c_read_reg_bytes(&i2c, addr, MUIC_REG_CONTROL, &val, 1);
+	if (!status) {
+		val &= ~MUIC_CONTROL_AUTO_SWITCH;
+		status = gpio_i2c_write_reg_bytes(&i2c, addr, MUIC_REG_CONTROL, &val, 1);
+	}
+	if (status) {
+		dprintf(CRITICAL, "muic-usb-switch: I2C error: %d\n", status);
+		return status;
+	}
+
+	dprintf(INFO, "muic-usb-switch: D+/D- connected to USB\n");
+	return 0;
+}
+LK2ND_DEVICE_INIT("samsung,muic-usb-switch", samsung_muic_usb_switch);
