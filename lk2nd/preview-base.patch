diff --git a/platform/msm_shared/usb30_dwc_hw.c b/platform/msm_shared/usb30_dwc_hw.c
index baa7be2c..95444bbb 100644
--- a/platform/msm_shared/usb30_dwc_hw.c
+++ b/platform/msm_shared/usb30_dwc_hw.c
@@ -361,6 +361,17 @@ void dwc_device_set_addr(dwc_dev_t *dev, uint16_t addr)
 	REG_WRITE_FIELD(dev, DCFG, DEVADDR, addr);
 }
 
+/* set the fastest speed the device may connect at */
+void dwc_device_set_max_speed(dwc_dev_t *dev)
+{
+	/* In high-speed only mode the SuperSpeed PHY is not set up. Left at
+	 * SuperSpeed (the reset value), the core keeps trying to detect a
+	 * SuperSpeed receiver and never connects at high speed.
+	 */
+	REG_WRITE_FIELD(dev, DCFG, DEVSPD,
+			use_hsonly_mode() ? DSTS_CONNECTSPD_HS : DSTS_CONNECTSPD_SS);
+}
+
 /* reset device */
