diff --git a/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts
new file mode 100644
--- /dev/null
+++ b/lk2nd/device/dts/msm8996/msm8996-samsung-gts3llte.dts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <skeleton64.dtsi>
+#include <lk2nd.dtsi>
+
+#define I2C_GPIO_FLAGS	(GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_BIAS_DISABLE)
+
+/ {
+	/* Values from the stock SM-T825 rev05 DTB: MSM8996 (246), PM8994 + PM8004 */
+	qcom,msm-id = <246 0x30001>;
+	qcom,board-id = <8 0>, <8 2>, <8 4>, <8 5>;
+	qcom,pmic-id = <0x20009 0x1000c 0x0 0x0>;
+};
+
+&lk2nd {
+	model = "Samsung Galaxy Tab S3 (LTE)";
+	compatible = "samsung,gts3llte";
+
+	/* SuperSpeed needs the s2mm005 Type-C controller and a redriver */
+	lk2nd,usb-high-speed-only;
+
+	/* SM5705 MUIC: the stock SM-T825 DTB has it on the same bus as the SM-T820 */
+	muic-usb-switch {
+		compatible = "samsung,muic-usb-switch";
+		i2c-reg = <0x25>;
+		i2c-sda-gpios = <&tlmm 33 I2C_GPIO_FLAGS>;
+		i2c-scl-gpios = <&tlmm 32 I2C_GPIO_FLAGS>;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		/* PM8994 GPIO 2 is the Home key; Volume Up is GPIO 3 */
+		volume-up {
+			lk2nd,code = <KEY_VOLUMEUP>;
+			gpios = <&pmic 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+		};
+
+		/* Volume Down is the PM8994 PON RESIN input, not a GPIO */
+		volume-down {
+			lk2nd,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pmic_pon GPIO_PMIC_RESIN 0>;
+		};
+	};
+};
diff --git a/lk2nd/device/dts/msm8996/rules.mk b/lk2nd/device/dts/msm8996/rules.mk
