diff --git a/lk2nd/display/cont-splash/refresh.c b/lk2nd/display/cont-splash/refresh.c
index 9b71a92b..48fe74b8 100644
--- a/lk2nd/display/cont-splash/refresh.c
+++ b/lk2nd/display/cont-splash/refresh.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: BSD-3-Clause
