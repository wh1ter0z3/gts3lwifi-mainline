diff --git a/hybris/common/o/linker_soinfo.cpp b/hybris/common/o/linker_soinfo.cpp
index 84e2e94..f43fa20 100644
--- a/hybris/common/o/linker_soinfo.cpp
+++ b/hybris/common/o/linker_soinfo.cpp
@@ -439,7 +439,13 @@ void soinfo::call_constructors() {
         fprintf(stderr, "Could not initialize android system properties!\n");
         abort();
     }
-    bionic___system_properties_init();
+    /* hybris: bionic's property area (/dev/__properties__) only exists on an
+     * Android host; all __system_property_* calls are hooked anyway, so skip
+     * the bionic init when the area is absent instead of faulting in it. */
+    if (access("/dev/__properties__", F_OK) == 0)
+      bionic___system_properties_init();
+    else
+      DEBUG("HYBRIS: no /dev/__properties__, skipping bionic property init\n");
     constructors_called = true;
     return;
   }
