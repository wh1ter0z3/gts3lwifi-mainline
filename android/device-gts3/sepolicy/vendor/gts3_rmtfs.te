# rmtfs (Linaro's): the modem DSP's file system from its partitions, read
# only (-r), and the modem's start through its remoteproc (-s)

type gts3_rmtfs, domain;
type gts3_rmtfs_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(gts3_rmtfs)

allow gts3_rmtfs self:qipcrtr_socket create_socket_perms_no_ioctl;
allow gts3_rmtfs gts3_rmtfs_device:chr_file rw_file_perms;
allow gts3_rmtfs block_device:dir r_dir_perms;
allow gts3_rmtfs gts3_modem_efs_block_device:blk_file r_file_perms;
# The remoteproc: found in sysfs, started through its state file
allow gts3_rmtfs sysfs:dir r_dir_perms;
allow gts3_rmtfs sysfs:file rw_file_perms;
allow gts3_rmtfs sysfs:lnk_file read;
