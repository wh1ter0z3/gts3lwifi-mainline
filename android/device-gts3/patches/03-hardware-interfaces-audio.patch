+static binder_status_t registerServiceWithRetry(AIBinder* binder, const char* name, int maxAttempts = 20) {
+    binder_status_t status = STATUS_UNKNOWN_ERROR;
+    for (int attempt = 1; attempt <= maxAttempts; ++attempt) {
+        status = AServiceManager_addService(binder, name);
+        if (status == STATUS_OK) return STATUS_OK;
+        LOG(WARNING) << "Failed to register service \"" << name << "\" (attempt "
+                     << attempt << "/" << maxAttempts << ", status: " << status
+                     << "), retrying in 500ms...";
+        usleep(500000);
+    }
+    return status;
+}
