+++ b/cros_gralloc/cros_gralloc_helpers.cc
@@ -32,7 +32,19 @@ uint32_t cros_gralloc_convert_format(int format)
 	case HAL_PIXEL_FORMAT_RGBA_8888:
 		return DRM_FORMAT_ABGR8888;
 	case HAL_PIXEL_FORMAT_RGBX_8888:
-		return DRM_FORMAT_XBGR8888;
+		/*
+		 * Report the alpha-carrying format even though the client asked
+		 * for the X variant. The memory layout is identical - 32bpp,
+		 * 8:8:8:8 - only the declared meaning of the fourth channel
+		 * differs, so nothing about the allocation changes.
+		 *
+		 * freedreno on a3xx does not accept XBGR8888 when importing a
+		 * dmabuf, which left SurfaceFlinger unable to build a texture
+		 * for its 720x1280 target ("Failed to create a valid texture
+		 * ... format:2") and killed the RenderEngine thread on every
+		 * frame - a black screen with the GPU otherwise working.
+		 */
+		return DRM_FORMAT_ABGR8888;
 	case HAL_PIXEL_FORMAT_RGB_888:
 		return DRM_FORMAT_BGR888;
