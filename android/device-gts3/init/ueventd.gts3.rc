#
# Installed as /vendor/etc/ueventd.rc: the system's ueventd.rc imports it by
# that name only.

# Kernel modules by modalias (gsi-init's host modprobe covers devices that
# appear while Android runs).
modalias_handling enabled

# Firmware: the vendor's own (linux-firmware parts, links into the tablet's
# partitions under /vendor/firmware/.part).
firmware_directories /vendor/firmware/

/dev/dri/*              0666    root        graphics
/dev/dma_heap/*         0666    system      graphics
/dev/video*             0660    mediacodec  camera
/dev/media*             0660    system      camera
/dev/v4l-subdev*        0660    system      camera
/dev/iio:device*        0660    system      system
/dev/rfkill             0660    bluetooth   bluetooth
/dev/snd/*              0660    system      audio
/dev/uhid               0660    uhid        uhid
/dev/uinput             0660    system      bluetooth
/dev/tun                0660    system      vpn
/dev/watchdog           0600    root        root
/dev/qseecom            0660    system      system

# Backlight and the touch key LED for the lights HAL (runs as system)
/sys/class/backlight/*  brightness  0664  system  system
/sys/class/leds/*       brightness  0664  system  system

# CPU frequency limits for the power HAL
/sys/devices/system/cpu/cpu*  cpufreq/scaling_min_freq  0664  system  system
/sys/devices/system/cpu/cpu*  cpufreq/scaling_max_freq  0664  system  system

# Sensors (qcom_smgr IIO devices): the multihal runs as system and turns
# their buffers and channels on, sets the rate and the timestamp clock.
# ueventd matches /sys/bus/iio/devices/<dev> for the iio subsystem.
/sys/bus/iio/devices/iio:device*  buffer/enable  0664  system  system
/sys/bus/iio/devices/iio:device*  current_timestamp_clock  0664  system  system
/sys/bus/iio/devices/iio:device*  in_accel_sampling_frequency  0664  system  system
/sys/bus/iio/devices/iio:device*  in_anglvel_sampling_frequency  0664  system  system
/sys/bus/iio/devices/iio:device*  in_magn_sampling_frequency  0664  system  system
/sys/bus/iio/devices/iio:device*  in_intensity_both_sampling_frequency  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_accel_x_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_accel_y_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_accel_z_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_anglvel_x_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_anglvel_y_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_anglvel_z_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_magn_x_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_magn_y_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_magn_z_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_intensity_both_en  0664  system  system
/sys/bus/iio/devices/iio:device*  scan_elements/in_timestamp_en  0664  system  system
