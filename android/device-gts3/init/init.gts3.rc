#
# Galaxy Tab S3, mainline kernel: the vendor's board init. gsi-init (our boot
# ramdisk) has already mounted the images, /data, binderfs and the tablet's
# firmware partitions, and set the boot properties (androidboot.*).

on early-init
    # No ashmem in mainline: libcutils uses memfd only when this is true (FMQ
    # for the composer and sensors, codec buffers, ...).
    setprop sys.use_memfd true

# Some system images (OneUI) set it false in their own init.rc: put it back.
on property:sys.use_memfd=false
    setprop sys.use_memfd true

on init
    # The GPU (render node) and the display controller: Mesa in every app, the
    # composer, the allocator.
    chmod 0666 /dev/dri/renderD128

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on boot
    # MSM8996: CPUs 0-1 are the low-power pair, 2-3 the fast pair. Background
    # work stays on the slow pair; AOSP's init.rc only copies all CPUs into
    # every group and leaves the split to the vendor.
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/restricted/cpus 0-1

    # Mixer routes for the speakers and built-in mics (bin/gts3-audio-init.sh)
    start vendor.gts3-audio-init

on post-fs-data
    # Wi-Fi's directories: Android 16 GSIs leave them to the vendor, and
    # without them wpa_supplicant can't write its configuration.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

    # The modem DSP, which holds the GNSS engine: rmtfs serves it its file
    # system from the modemst1/2, fsg and fsc partitions (in memory only, -r:
    # nothing is written back) and starts it (-s); tqftpserv serves it files,
    # its own read-write ones from here.
    mkdir /data/vendor/tmp 0770 root system
    start vendor.tqftpserv
    start vendor.rmtfs

on shutdown
    stop vendor.rmtfs

service vendor.gts3-audio-init /vendor/bin/gts3-audio-init.sh
    class core
    user audio
    group audio
    oneshot
    disabled

# Linaro's (device/linaro/dragonboard/shared/utils). A tablet without the
# modem DSP in its DT (the SM-T825 for now) has nothing for rmtfs to start:
# it exits, and oneshot keeps it from being started again.
service vendor.rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system
    oneshot
    disabled

service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    oneshot
    disabled
