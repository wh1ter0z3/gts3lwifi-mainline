# The generic vendor_file_contexts only label the AOSP sample binary names
# (...-service.example). Ours and the ones installed outside their APEX would
# stay vendor_file, and init refuses to start a service it can't put into a
# domain (even when permissive). From SamuraiArtem's j5xnlte tree.

/vendor/bin/hw/android\.hardware\.health-service\.gts3                       u:object_r:hal_health_default_exec:s0
/vendor/bin/hw/android\.hardware\.lights-service\.gts3                       u:object_r:hal_light_default_exec:s0
/vendor/bin/hw/vendor\.samsung\.hardware\.seh-stubs                          u:object_r:hal_health_default_exec:s0
/vendor/bin/hw/android\.hardware\.security\.keymint-service\.nonsecure       u:object_r:hal_keymint_default_exec:s0
/vendor/bin/hw/android\.hardware\.media\.c2-service-v4l2                     u:object_r:mediacodec_exec:s0
/vendor/bin/hw/android\.hardware\.composer\.hwc3-service\.drm                u:object_r:hal_graphics_composer_default_exec:s0
/vendor/bin/hw/android\.hardware\.graphics\.allocator-service\.minigbm_msm   u:object_r:hal_graphics_allocator_default_exec:s0

/vendor/bin/gts3-audio-init\.sh                                              u:object_r:gts3_audio_init_exec:s0

# Mesa in every process that draws (apps included)
/vendor/lib(64)?/libgallium_dri\.so                                          u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/egl/lib(EGL|GLESv1_CM|GLESv2)_mesa\.so                      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/mapper\.minigbm\.so                                      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/gralloc\.minigbm_msm\.so                                 u:object_r:same_process_hal_file:s0

# The SLPI's sensors (qcom_smgr IIO devices, under the remoteproc's QRTR node)
/sys/devices/platform/soc@0/1c00000\.remoteproc/remoteproc/remoteproc[0-9]+/.+/iio:device[0-9]+(/.*)?  u:object_r:sysfs_gts3_iio:s0

# GNSS: our HAL, and the modem DSP's helpers (Linaro's rmtfs and tqftpserv)
/vendor/bin/hw/android\.hardware\.gnss-service\.gts3                         u:object_r:hal_gnss_default_exec:s0
/vendor/bin/rmtfs                                                            u:object_r:gts3_rmtfs_exec:s0
/vendor/bin/tqftpserv                                                        u:object_r:gts3_tqftpserv_exec:s0
/dev/qcom_rmtfs_mem[0-9]+                                                    u:object_r:gts3_rmtfs_device:s0
/dev/block/platform/soc@0/7464900\.mmc/by-name/(modemst1|modemst2|fsg|fsc)   u:object_r:gts3_modem_efs_block_device:s0
/dev/block/by-name/(modemst1|modemst2|fsg|fsc)                               u:object_r:gts3_modem_efs_block_device:s0
/data/vendor/tmp(/.*)?                                                       u:object_r:gts3_tqftpserv_data_file:s0

# Camera: ST's AIDL provider (libcamera's HAL3 module inside), CAMSS nodes
/vendor/bin/hw/android\.hardware\.camera\.provider-service\.libcamera        u:object_r:hal_camera_default_exec:s0
/vendor/bin/libcamera/simple_ipa_proxy                                       u:object_r:hal_camera_default_exec:s0
/dev/media[0-9]+                                                             u:object_r:video_device:s0
/dev/v4l-subdev[0-9]+                                                        u:object_r:video_device:s0
