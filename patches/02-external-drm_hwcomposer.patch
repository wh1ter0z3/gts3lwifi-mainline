new file mode 100644
index 0000000..dcb0236
--- /dev/null
+++ b/compositor/SolidFillFb.cpp
@@ -0,0 +1,60 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#define LOG_TAG "drmhwc"
+
+#include "SolidFillFb.h"
+
+#include <ui/GraphicBufferAllocator.h>
+
+#include "bufferinfo/BufferInfoGetter.h"
+#include "drm/DrmDevice.h"
+#include "utils/log.h"
+
+namespace android {
+
+auto SolidFillFb::Get(DrmDevice *drm) -> std::shared_ptr<SolidFillFb> {
+  /* One per process is enough: the contents are never read. */
+  static std::weak_ptr<SolidFillFb> cached;
+
+  if (auto existing = cached.lock())
+    return existing;
+
+  auto self = std::shared_ptr<SolidFillFb>(new SolidFillFb());
+
+  uint32_t stride = 0;
+  auto err = GraphicBufferAllocator::get()
+                 .allocate(1, 1, HAL_PIXEL_FORMAT_RGBA_8888, 1,
+                           GRALLOC_USAGE_HW_COMPOSER | GRALLOC_USAGE_HW_RENDER,
+                           &self->handle_, &stride, "drmhwc-solid-fill");
+  if (err != ::android::OK || self->handle_ == nullptr) {
+    ALOGE("Failed to allocate the solid-fill placeholder buffer: %d", err);
+    return {};
+  }
+
+  auto bi = BufferInfoGetter::GetInstance()->GetBoInfo(self->handle_);
+  if (!bi) {
+    ALOGE("Failed to read back the solid-fill placeholder buffer");
+    return {};
+  }
+  self->bi_ = *bi;
+
+  self->fb_ = drm->GetDrmFbImporter().GetOrCreateFbId(&self->bi_);
+  if (!self->fb_) {
+    ALOGE("Failed to import the solid-fill placeholder buffer");
+    return {};
+  }
+
+  cached = self;
+  return self;
+}
+
+SolidFillFb::~SolidFillFb() {
+  if (handle_ != nullptr)
+    GraphicBufferAllocator::get().free(handle_);
+}
+
+}  // namespace android
diff --git a/compositor/SolidFillFb.h b/compositor/SolidFillFb.h
new file mode 100644
index 0000000..af9dddc
--- /dev/null
+++ b/compositor/SolidFillFb.h
@@ -0,0 +1,49 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <memory>
+#include <optional>
+
+#include "bufferinfo/BufferInfo.h"
+#include "drm/DrmFbImporter.h"
+
+namespace android {
+
+class DrmDevice;
+
+/*
+ * A single tiny buffer shared by every solid-colour layer.
+ *
+ * MDP5 can paint a plane with a constant colour and fetch nothing from memory,
+ * but the atomic modeset core still refuses a plane that has a CRTC and no
+ * framebuffer ("[PLANE] CRTC set but no FB", drm_atomic_plane_check). So one
+ * 1x1 buffer is allocated once and handed to every such plane; the driver
+ * ignores its contents while SOLID_FILL is set.
+ */
+class SolidFillFb {
+ public:
+  static auto Get(DrmDevice *drm) -> std::shared_ptr<SolidFillFb>;
+
+  auto GetFb() const -> const std::shared_ptr<DrmFbIdHandle> & {
+    return fb_;
+  }
+  auto GetBufferInfo() const -> const BufferInfo & {
+    return bi_;
+  }
+
+  ~SolidFillFb();
+
+ private:
+  SolidFillFb() = default;
+
+  BufferInfo bi_{};
+  std::shared_ptr<DrmFbIdHandle> fb_;
+  buffer_handle_t handle_{};
+};
+
+}  // namespace android
