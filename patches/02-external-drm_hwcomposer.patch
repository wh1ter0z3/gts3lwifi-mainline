+std::optional<uint32_t> AidlToSolidColor(
+    const std::optional<::aidl::android::hardware::graphics::composer3::Color>&
+        color) {
+  if (!color) {
+    return std::nullopt;
+  }
+  /* Float 0..1 per channel in, packed ARGB8888 out. */
+  auto to_u8 = [](float v) -> uint32_t {
+    return static_cast<uint32_t>(std::clamp(v, 0.0F, 1.0F) * 255.0F + 0.5F);
+  };
+  return (to_u8(color->a) << 24) | (to_u8(color->r) << 16) |
+         (to_u8(color->g) << 8) | to_u8(color->b);
