#!/sbin/sh
# Galaxy Tab S3 installer for OrangeFox / TWRP (docs/dual-boot.md,
# docs/partitions.md): Nura (postmarketOS), an Android (any GSI on our
# vendor, or a LineageOS zip for the tablet: Awesometic's, Jayden's), or Nura
# and one Android side by side on internal storage, with lk2nd v2 to choose.
#
# Put this zip in one folder on the microSD card or a USB drive with
#   nura-root.img.xz                  -> Nura
#   a GSI (named *system* or *gsi*:   -> Android on our vendor
#   .img, .img.xz, or a zip with system.img)
#   lineage-*.zip                     -> LineageOS (its own kernel and vendor)
# (Nura and an Android -> both side by side), then Install this zip. It ERASES the userdata
# partition (internal storage: all Android data, a postmarketOS install),
# makes the layout in it with only what is installed, writes the systems and
# flashes lk2nd v2 to the start of the boot partition. Each way it adds
# OrangeFox on our kernel as lk2nd's "orangefox" entry, if the zip has it
# (android/recovery).
#
# Runs under the zip's busybox (recoveries differ in their tools, and their
# mksh computes in 32 bits). From the recovery: sgdisk, mke2fs, e2fsck,
# resize2fs, simg2img, and toybox's losetup (offsets and sizes).
# Arguments (update-binary protocol): <api> <outfd> <zip>
# Test overrides: MODEL, DATA_DEV, BOOT_DEV, RECOVERY_DEV, DISK_DEV, GSI, LOS,
# SYSTEM, VENDOR, DATA, LOS_DATA, WORK
#
# Staged, for a PC over adb (setup.sh, setup.ps1), with the big images on
# the PC instead of next to the zip. GTS3_STAGE picks the stage:
#   layout  GTS3_SETUP=nura|android|both|lineage|nura-lineage: everything
#           but Nura's root, the GSI and the LineageOS zip: the layout, the
#           boot partition, Android's vendor and data. The partitions stay
#           attached for the next stages
#   recv    GTS3_PART=nura|android_system|lineage, GTS3_FORMAT=xz|raw,
#           GTS3_SHA256=<the sha256 of what is sent>: writes the image on
#           stdin to that partition (adb shell -T ... < image; not adb
#           exec-in, which returns before the tablet is done and without
#           its output). It fails if the stream's sha256 differs (busybox's
#           xzcat, the fallback, doesn't check xz's CRC64). lineage: the zip, kept on
#           LineageOS's data partition until finish installs it
#           With GTS3_FDE_KEY=<file with the passphrase> (nura, both,
#           nura-lineage): Nura's partition becomes LUKS2 (docs/encryption.md,
#           "The whole of Nura"), opened for the next stages
#   finish  Nura's root checked and grown; GTS3_ANSWERS=<dir> (optional):
#           gts3-firstsetup with those answers and GTS3_UTC=<the PC's time>;
#           the LineageOS zip; then lk2nd v2
# Without GTS3_STAGE, all of it in one go from the files next to the zip.
OUTFD=$2
ZIP=$3
case "$0" in /*) SELF=$0 ;; *) SELF=$PWD/$0 ;; esac
case "$ZIP" in /*) ;; *) ZIP=$PWD/$ZIP ;; esac
if [ -z "${GTS3_BB:-}" ]; then
	B=/tmp/gts3-bb
	rm -rf "$B" && mkdir -p "$B" && cd "$B" &&
		unzip -o "$ZIP" tools/busybox > /dev/null 2>&1 &&
		chmod 0755 tools/busybox && "$B/tools/busybox" --install -s "$B" || {
		echo "ui_print ERROR: can't unpack tools/busybox from $ZIP" >&"$OUTFD"
		exit 1
	}
	# the recovery's e2fsprogs and losetup, not busybox's
	rm -f "$B/mke2fs" "$B/mkfs.ext2" "$B/tune2fs" "$B/e2fsck" "$B/fsck" "$B/losetup"
	export GTS3_BB=$B PATH="$B:$PATH"
	exec "$B/tools/busybox" sh "$SELF" "$1" "$2" "$ZIP"
fi
DATA_DEV=${DATA_DEV:-/dev/block/bootdevice/by-name/userdata}
BOOT_DEV=${BOOT_DEV:-/dev/block/bootdevice/by-name/boot}
RECOVERY_DEV=${RECOVERY_DEV:-/dev/block/bootdevice/by-name/recovery}
CACHE_DEV=${CACHE_DEV:-/dev/block/bootdevice/by-name/cache}
DISK=${DISK_DEV:-/dev/block/mmcblk0}
SYSTEM=${SYSTEM:-4G} VENDOR=${VENDOR:-1G} DATA=${DATA:-4G} LOS_DATA=${LOS_DATA:-8G}
# the recovery's PATH, for LineageOS's own installer
RPATH=${PATH#"$GTS3_BB":}
W=${WORK:-/tmp/gts3-install}
G=$W/dev
WB=$W/bdwlan30.bin
DIR=$(dirname "$ZIP")
STAGE=${GTS3_STAGE:-all}
# the stages after the layout keep its partitions attached, also on errors
KEEP=
[ "$STAGE" = all ] || [ "$STAGE" = layout ] || KEEP=1

ui() { echo "ui_print $*" >&"$OUTFD"; echo "ui_print" >&"$OUTFD"; }
die() {
	ui "ERROR: $*"
	[ -n "${ERASED:-}" ] && ui "userdata was changed: run this installer again" ||
		ui "Nothing on the tablet was changed."
	cleanup
	exit 1
}
cleanup() {
	umount "$W/nura/boot" "$W/nura/sys" "$W/nura/proc" "$W/nura/dev" "$W/nura" "$W/mnt" "$W/los" 2> /dev/null
	[ -z "$KEEP" ] || return 0
	[ ! -e "/dev/mapper/$CRYPT" ] || cs close "$CRYPT" 2> /dev/null
	for l in $(cat "$W/loops" 2> /dev/null); do losetup -d "$l" 2> /dev/null; done
	rm -f "$W/loops"
}
case "$STAGE" in all | layout | recv | finish) ;; *) die "GTS3_STAGE: layout, recv or finish" ;; esac
# the recovery's tools (not the zip's busybox)
tool() {
	for c in $(which -a "$1" 2> /dev/null) /system/bin/$1 /sbin/$1; do
		case "$c" in "$GTS3_BB"/*) continue ;; esac
		[ -x "$c" ] && { echo "$c"; return 0; }
	done
	return 1
}
SGDISK=$(tool sgdisk) || die "this recovery has no sgdisk"
# xz to stdout: the zip's (XZ Utils 5.8, static: unpacks the image's blocks
# on all four cores, 5x busybox's xzcat; the eMMC is then the limit), else
# the recovery's, else busybox's
unxz() {
	if [ -x "$W/tools/xz" ] && "$W/tools/xz" --version > /dev/null 2>&1; then
		"$W/tools/xz" -dc -T0 "$@"
	elif x=$(tool xz); then
		"$x" -dc "$@"
	else
		xzcat "$@"
	fi
}
MKE2FS=$(tool mke2fs) || die "this recovery has no mke2fs"
E2FSCK=$(tool e2fsck) || die "this recovery has no e2fsck"
RESIZE2FS=$(tool resize2fs) || die "this recovery has no resize2fs"
TUNE2FS=$(tool tune2fs) || TUNE2FS=
SIMG2IMG=$(tool simg2img) || die "this recovery has no simg2img"
LOSETUP=$(tool losetup) || die "this recovery has no losetup"

ui "Galaxy Tab S3: Nura, Android, or both"
# the model: from the device tree on our kernel (one recovery for both),
# else from the recovery's build (Samsung's kernel)
if [ -z "${MODEL:-}" ]; then
	c=$(tr '\0' ' ' < /proc/device-tree/compatible 2> /dev/null)
	case "$c" in
	*samsung,gts3lwifi*) MODEL=gts3lwifi ;;
	*samsung,gts3llte*) MODEL=gts3llte ;;
	*) MODEL=$(getprop ro.product.device) ;;
	esac
fi
case "$MODEL" in
gts3lwifi) DTB=apq8096-samsung-gts3lwifi.dtb ;;
gts3llte) DTB=msm8996-samsung-gts3llte.dtb ;;
*) die "not a Galaxy Tab S3 (model: '$MODEL')" ;;
esac
mkdir -p "$W" "$G" "$W/mnt"
cd "$W" || die "no $W"

# Nura's root once it is written: checked, and grown to its partition
fixroot() {
	ui "Nura: checking its root..."
	$E2FSCK -fy "$G/nura" > /dev/null 2>&1
	[ $? -le 1 ] || die "e2fsck of Nura's root"
	$RESIZE2FS "$G/nura" > /dev/null 2>&1 || die "resize2fs of Nura's root"
	# ext4's encrypt feature, for fscrypt (existing files are unaffected)
	[ -z "$TUNE2FS" ] || $TUNE2FS -O encrypt "$G/nura" > /dev/null 2>&1 ||
		ui "Nura: couldn't turn on ext4's encrypt feature (encryption stays off)"
}
# Nura encrypted (LUKS2, like a normal Linux install): the zip's cryptsetup
# (Alpine's, with its musl and libraries: tools/cs/), the device-mapper
# nodes made by itself (no udev in a recovery)
CRYPT=gts3-nura-crypt
cs() {
	# its lock directory, which a recovery hasn't got
	mkdir -p /run/cryptsetup 2> /dev/null
	DM_DISABLE_UDEV=1 "$W/tools/cs/ld-musl-aarch64.so.1" --library-path "$W/tools/cs" "$W/tools/cs/cryptsetup" "$@"
}
fde_format() {	# <key file>: Nura's partition becomes LUKS2, opened as $G/nura
	ui "Nura: encrypting its partition (LUKS2, AES-XTS)..."
	[ -x "$W/tools/cs/cryptsetup" ] || die "no cryptsetup in the zip (tools/cs)"
	[ -s "$1" ] || die "no passphrase in $1"
	d=$(readlink -f "$G/nura")
	# Argon2id (1 s, 256 MiB: fits the tablet's RAM when unlocking), 4 KiB
	# sectors; discards and no work queues (lower latency on flash) kept in
	# the header, so every unlock uses them
	cs luksFormat --batch-mode --type luks2 --cipher aes-xts-plain64 --key-size 512 \
		--pbkdf argon2id --pbkdf-memory 262144 --iter-time 1000 --sector-size 4096 \
		--key-file "$1" "$d" > "$W/cs.log" 2>&1 || die "cryptsetup luksFormat: $(tail -n 1 "$W/cs.log")"
	cs open --persistent --allow-discards --perf-no_read_workqueue --perf-no_write_workqueue \
		--key-file "$1" "$d" "$CRYPT" > "$W/cs.log" 2>&1 || die "cryptsetup open: $(tail -n 1 "$W/cs.log")"
	[ -b "/dev/mapper/$CRYPT" ] || die "no /dev/mapper/$CRYPT"
	FDE_UUID=$(cs luksUUID "$d") || die "cryptsetup luksUUID"
	ln -sf "/dev/mapper/$CRYPT" "$G/nura"
}
# the unlock screen in Nura's initramfs: postmarketOS's own (unl0kr), from
# the zip if Nura's root hasn't got it, then its initramfs made again inside
# Nura's root. fde/ is an offline repository: postmarketOS's signed index
# (aarch64/APKINDEX.tar.gz, which Nura's root trusts) and the two packages
# it lists (postmarketOS signs the index, each package only with its
# builder's own key: apk trusts them through the index)
fde_unlock() {
	ui "Nura: the passphrase screen at start..."
	mkdir -p "$W/nura"
	mount -t ext4 "$G/nura" "$W/nura" || die "mount Nura's root"
	mount -t ext2 "$G/gts3_boot" "$W/nura/boot" 2> /dev/null || mount -t ext4 "$G/gts3_boot" "$W/nura/boot" ||
		die "mount boot"
	for d in dev proc sys; do mount --bind "/$d" "$W/nura/$d" || die "bind /$d"; done
	ch() { chroot "$W/nura" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root "$@"; }
	# the initramfs is made from Nura's root: it must have this zip's layout
	# hook (an older image's finds our layout in userdata only)
	h=usr/share/mkinitfs/hooks/20-gts3-dualboot.sh
	[ -s pc/20-gts3-dualboot.sh ] || die "no pc/20-gts3-dualboot.sh in the zip"
	cmp -s pc/20-gts3-dualboot.sh "$W/nura/$h" || cp pc/20-gts3-dualboot.sh "$W/nura/$h" || die "the layout hook"
	if ! ch apk info -e postmarketos-buffybox-unl0kr > /dev/null 2>&1; then
		[ -s fde/aarch64/APKINDEX.tar.gz ] || die "no unlock screen packages in the zip (fde/)"
		rm -rf "$W/nura/tmp/gts3-fde" && mkdir -p "$W/nura/tmp/gts3-fde" && cp -r fde/aarch64 "$W/nura/tmp/gts3-fde/" ||
			die "copying the packages"
		# its triggers make the initramfs again (mkinitfs, boot-deploy);
		# postmarketos-base-nofde stands in for the unlock screen: it goes
		ch apk add --no-network --no-interactive --repositories-file /dev/null --repository /tmp/gts3-fde \
			postmarketos-buffybox-unl0kr '!postmarketos-base-nofde' > "$W/fde.log" 2>&1 ||
			die "adding the unlock screen: $(grep -i error "$W/fde.log" | tail -n 1)"
		rm -rf "$W/nura/tmp/gts3-fde"
	else
		ch mkinitfs > "$W/fde.log" 2>&1 || die "mkinitfs: $(tail -n 1 "$W/fde.log")"
	fi
	# the initramfs (all its archives) must have cryptsetup and the unlock
	# screen now
	ch sh -c 'zstd -dc /boot/initramfs 2>/dev/null || gzip -dc /boot/initramfs' > "$W/initramfs.cpio"
	grep -a -q 'bin/cryptsetup' "$W/initramfs.cpio" && grep -a -q 'bin/fde-unlock' "$W/initramfs.cpio" ||
		die "the new initramfs has no cryptsetup or no unlock screen"
	rm -f "$W/initramfs.cpio"
	sync
	umount "$W/nura/sys" "$W/nura/proc" "$W/nura/dev" "$W/nura/boot" "$W/nura" || die "umount"
}
# The Wi-Fi board data in Nura's root too: the driver loads before
# gts3-firmware copies it from the boot partition, so without this Nura's
# first start has the world regulatory domain (5 GHz limited)
wb_root() {
	[ -s "$WB" ] || return 0
	mkdir -p "$W/nura"
	mount -t ext4 "$G/nura" "$W/nura" || die "mount Nura's root"
	mkdir -p "$W/nura/lib/firmware/updates/ath10k/QCA6174/hw3.0" &&
		cp "$WB" "$W/nura/lib/firmware/updates/ath10k/QCA6174/hw3.0/board.bin" || die "the Wi-Fi board data"
	umount "$W/nura" || die "umount Nura's root"
}
# Nura's root mount options with inlinecrypt, so fscrypt encrypts on the
# eMMC's inline crypto engine (docs/encryption.md); harmless without fscrypt
ice_cmdline() {
	case " $1 " in
	*inlinecrypt*) printf '%s' "$1" ;;
	*" pmos_rootfsopts="*) printf '%s' "$1" | sed -E 's/(pmos_rootfsopts=[^ ]*)/\1,inlinecrypt/' ;;
	*) printf '%s pmos_rootfsopts=defaults,inlinecrypt' "$1" ;;
	esac
}
# the last step: lk2nd v2 to the start of the boot partition; with
# LineageOS (its kernel in the boot partition) to the recovery partition:
# Samsung's recovery start (Power + Volume Up + Home, "reboot recovery")
# then gives lk2nd's menu
haslk2nd() { head -c 4194304 "$1" 2> /dev/null | grep -a -q lk2nd; }
flashlk2nd() {
	if [ -n "$HAS_LOS" ]; then
		if ! haslk2nd "$RECOVERY_DEV"; then
			# what was there first (a TWRP, Samsung's recovery), to the zip's folder
			SN=$(cat /sys/block/${DISK##*/}/device/serial 2> /dev/null)
			RB=gts3-recovery-before-${MODEL}-${SN:-0}.img.gz
			gzip -c "$RECOVERY_DEV" > "$DIR/$RB" 2> /dev/null || { rm -f "$DIR/$RB"; RB=; }
			[ -z "$RB" ] || ui "The recovery partition as it was: $DIR/$RB"
		fi
		ui "lk2nd v2 to the recovery partition..."
		dd if="$W/$LK2ND" of="$RECOVERY_DEV" bs=4096 conv=notrunc,fsync 2> /dev/null || die "writing lk2nd"
		ui "Done ($SETUP). Reboot: LineageOS"
		ui "(Power + Volume Up + Home at power-on, or \"reboot recovery\": lk2nd's menu, with $([ -n "$1" ] && echo "nura and ")orangefox)."
		return 0
	fi
	ui "lk2nd v2..."
	dd if="$W/$LK2ND" of="$BOOT_DEV" bs=4096 conv=notrunc,fsync 2> /dev/null || die "writing lk2nd"
	if [ -n "$1" ]; then
		ui "Done ($SETUP). Reboot: lk2nd starts Nura"
	else
		ui "Done ($SETUP). Reboot: lk2nd starts Android"
	fi
	ui "(Volume Down at power-on: lk2nd's menu, with orangefox)."
}

# LineageOS's own installer from its zip, as a recovery runs it: it writes
# Samsung's system and boot partitions by name. /cache (its stash) is
# Samsung's cache partition, made ext4 if it isn't (LineageOS formats it
# anyway). Then its /data goes on the layout's android_data.
runlos() {	# <zip>
	ui "LineageOS: $(basename "$1") (a few minutes)..."
	unzip -p "$1" META-INF/com/google/android/update-binary > "$W/los-updater" && [ -s "$W/los-updater" ] ||
		die "no installer in $(basename "$1")"
	chmod 0755 "$W/los-updater"
	umount /cache 2> /dev/null
	# a recovery without a cache partition in its list links /cache to
	# /data/cache (in its RAM): a mount point of its own instead
	[ ! -L /cache ] || rm -f /cache
	mkdir -p /cache
	if ! mount -t ext4 "$CACHE_DEV" /cache 2> /dev/null; then
		$MKE2FS -q -F -t ext4 "$CACHE_DEV" > /dev/null 2>&1 && mount -t ext4 "$CACHE_DEV" /cache ||
			die "mount the cache partition"
	fi
	(cd /tmp && PATH=$RPATH "$W/los-updater" 3 "$OUTFD" "$1")
	rc=$?
	umount /cache 2> /dev/null || umount -l /cache
	[ $rc = 0 ] || die "LineageOS's installer failed (above)"
	# its /data: a dm-linear device over android_data (scripts/dualboot/lineage)
	ui "LineageOS: its /data on android_data..."
	[ -s "$W/lineage/update-binary-data" ] || die "no lineage/update-binary-data in the zip"
	DATA_DEV=$DATA_DEV sh "$W/lineage/update-binary-data" 3 "$OUTFD" "$ZIP" || die "LineageOS's /data add-on failed (above)"
}
los_device() {	# <zip>: for this model (LineageOS's installer checks it too)
	unzip -p "$1" META-INF/com/google/android/updater-script 2> /dev/null > "$W/los-script"
	grep -q 'by-name/system' "$W/los-script" || die "$(basename "$1") isn't a LineageOS zip for the Tab S3"
	grep -q "\"$MODEL\"" "$W/los-script" || die "$(basename "$1") is for another model (this is $MODEL)"
}
lospath() {	# the zip as the PC sent it, on LineageOS's data (android_data)
	mkdir -p "$W/los"
	awk -v m="$W/los" '$2 == m { found = 1 } END { exit !found }' /proc/mounts ||
		mount -t ext4 "$G/android_data" "$W/los" || die "mount LineageOS's data partition"
	echo "$W/los/lineage.zip"
}

# after a layout stage userdata is changed, whatever fails
[ -z "$KEEP" ] || [ ! -f stage.env ] || ERASED=1
if [ "$STAGE" = recv ]; then
	P=${GTS3_PART:-} F=${GTS3_FORMAT:-xz}
	case "$P" in nura | android_system | lineage) ;; *) die "GTS3_PART: nura, android_system or lineage" ;; esac
	case "$F" in xz | raw) ;; *) die "GTS3_FORMAT: xz or raw" ;; esac
	printf '%s' "${GTS3_SHA256:-}" | grep -Eq '^[0-9a-f]{64}$' || die "GTS3_SHA256: the sha256 of the image as sent"
	OUT=$G/$P
	if [ "$P" = lineage ]; then
		[ -f stage.env ] && [ -b "$G/android_data" ] || die "no LineageOS layout: run the layout stage first"
		[ "$F" = raw ] || die "the LineageOS zip goes as it is (GTS3_FORMAT=raw)"
		OUT=$(lospath)
	fi
	[ -f stage.env ] && { [ "$P" = lineage ] || [ -b "$OUT" ]; } || die "no $P partition: run the layout stage first"
	rm -f "got-$P" recv.fifo recv.sum
	mkfifo recv.fifo || die "mkfifo"
	# the sha256 of the stream as sent, for the PC to compare
	sha256sum < recv.fifo > recv.sum &
	set -o pipefail
	if [ "$F" = xz ]; then
		tee recv.fifo | unxz > "$OUT"
	else
		tee recv.fifo | dd of="$OUT" bs=4M 2> /dev/null
	fi
	rc=$?
	set +o pipefail
	wait
	sync
	[ $rc = 0 ] || die "writing $P: a damaged image, or larger than its partition"
	if [ "$P" = android_system ] && [ "$(od -An -tx1 -N4 "$OUT" | tr -d ' ')" = 3aff26ed ]; then
		die "the GSI is a sparse image: unpack it first (simg2img)"
	fi
	s=$(cut -d' ' -f1 recv.sum)
	[ "$P" != lineage ] || umount "$W/los" || die "umount LineageOS's data partition"
	[ "$s" = "$GTS3_SHA256" ] || die "$P arrived damaged (sha256 $s): send it again"
	echo "$s" > "got-$P"
	ui "$P: written, sha256 matches"
	exit 0
fi

if [ "$STAGE" = finish ]; then
	[ -f stage.env ] || die "run the layout stage first"
	. ./stage.env
	[ -z "$HAS_NURA" ] || [ -f got-nura ] || die "Nura's root wasn't sent"
	[ -z "$HAS_GSI" ] || [ -f got-android_system ] || die "the GSI wasn't sent"
	[ -z "$HAS_LOS" ] || [ -f got-lineage ] || die "the LineageOS zip wasn't sent"
	if [ -n "$HAS_NURA" ]; then
		[ -z "${FDE_UUID:-}" ] || [ -b "/dev/mapper/$CRYPT" ] ||
			die "Nura's encrypted partition isn't open: run the layout stage again"
		fixroot
		wb_root
		[ -z "${FDE_UUID:-}" ] || fde_unlock
		if [ -n "${GTS3_ANSWERS:-}" ]; then
			ui "Nura: your settings..."
			[ -d "$GTS3_ANSWERS" ] || die "no answers in $GTS3_ANSWERS"
			mkdir -p "$W/nura"
			mount -t ext4 "$G/nura" "$W/nura" || die "mount Nura's root"
			mount -t ext2 "$G/gts3_boot" "$W/mnt" 2> /dev/null || mount -t ext4 "$G/gts3_boot" "$W/mnt" || die "mount boot"
			sh tools/gts3-firstsetup "$W/nura" "$W/mnt" "$GTS3_ANSWERS" ${GTS3_UTC:-} > firstsetup.log 2>&1
			rc=$?
			while read -r l; do ui "${l#gts3-firstsetup: }"; done < firstsetup.log
			[ $rc = 0 ] || die "Nura's settings weren't all applied: fix the answer above, run finish again"
			umount "$W/nura" && umount "$W/mnt" || die "umount"
		fi
	fi
	if [ -n "$HAS_LOS" ]; then
		Z=$(lospath)
		los_device "$Z"
		runlos "$Z"
		rm -f "$Z"
		umount "$W/los" || die "umount LineageOS's data partition"
	fi
	KEEP=
	cleanup
	flashlk2nd "$HAS_NURA"
	exit 0
fi

rm -f stage.env got-* recv.* firstsetup.log
# Small files here; the big ones (Nura's boot files, the vendor image) are
# checked and later written straight from the zip: /tmp is RAM in a recovery
BIG="nura-boot.tar android/vendor.img"
unzip -o -q "$ZIP" -x 'META-INF/*' $BIG || die "can't unpack the zip"
grep -v -e ' nura-boot\.tar$' -e ' android/vendor\.img$' SHA256SUMS > sums.small
sha256sum -c -s sums.small 2> /dev/null || die "the zip's files are damaged, download it again"
chmod 0755 tools/* lineage/* 2> /dev/null
zsum() {	# the sha256 of $1 in the zip is the listed one
	[ "$(unzip -p "$ZIP" "$1" | sha256sum | cut -d' ' -f1)" = "$(awk -v f="$1" '$2 == f { print $1 }' SHA256SUMS)" ]
}
. ./nura.env || die "no nura.env in the zip"
LK2ND=lk2nd-$MODEL.img
[ -s "$LK2ND" ] || die "no $LK2ND in the zip: no lk2nd v2 for this model yet"
# Nura's root: raw and xz'd (releases), or a sparse image; none: no Nura
ROOT=$DIR/nura-root.img.xz
[ -f "$ROOT" ] || ROOT=$DIR/nura-root.simg
[ -f "$ROOT" ] || ROOT=
# our Android's files for this model, and the recovery's
ADTB=
if [ -s android/Image.gz ]; then
	ADTB=android/dtb/$DTB
	[ -s "$ADTB" ] || ADTB=android/gts3.dtb
fi
RDTB=
[ -s android/recovery/ramdisk ] && [ -s "android/recovery/$DTB" ] && RDTB=android/recovery/$DTB
# the GSI: a system image by its name (other images may be in the folder);
# staged: the PC has them, GTS3_SETUP says which
if [ "$STAGE" = layout ]; then
	LOS=
	case "${GTS3_SETUP:-}" in
	nura) ROOT=pc GSI= ;;
	android) ROOT= GSI=pc ;;
	both) ROOT=pc GSI=pc ;;
	lineage) ROOT= GSI= LOS=pc ;;
	nura-lineage) ROOT=pc GSI= LOS=pc ;;
	*) die "GTS3_SETUP: nura, android, both, lineage or nura-lineage" ;;
	esac
else
	[ -n "${GSI:-}" ] || GSI=$(ls "$DIR"/*system*.img "$DIR"/*system*.img.xz "$DIR"/*gsi*.img "$DIR"/*gsi*.img.xz \
		"$DIR"/*system*.zip "$DIR"/*gsi*.zip 2> /dev/null | grep -v -e nura-root -e "$(basename "$ZIP")" | head -n 1)
	[ -n "${LOS:-}" ] || LOS=$(ls "$DIR"/lineage-*.zip 2> /dev/null | head -n 1)
fi
[ -z "$GSI" ] || [ -z "$LOS" ] || die "one Android: a GSI or a LineageOS zip, not both"
[ -z "$GSI" ] || [ -s "$ADTB" ] || die "this zip has no Android files for $MODEL"
[ -n "$ROOT$GSI$LOS" ] || die "put nura-root.img.xz (Nura) and/or a GSI or a LineageOS zip (Android) next to this zip"
A="Android"
[ -z "$LOS" ] || A="LineageOS"
if [ -n "$ROOT" ] && [ -n "$GSI$LOS" ]; then SETUP="Nura and $A"
elif [ -n "$ROOT" ]; then SETUP="Nura only"
else SETUP="$A only"; fi
ui "Installing: $SETUP"
if [ "$STAGE" = all ]; then
	[ -z "$ROOT" ] || ui "Nura: $(basename "$ROOT")"
	[ -z "$GSI" ] || ui "Android: $(basename "$GSI")"
	[ -z "$LOS" ] || ui "LineageOS: $(basename "$LOS")"
	[ -z "$LOS" ] || los_device "$LOS"
fi
ui "Checking the zip..."
[ -z "$ROOT" ] || zsum nura-boot.tar || die "nura-boot.tar in the zip is damaged, download it again"
[ -z "$GSI" ] || zsum android/vendor.img || die "the vendor image in the zip is damaged, download it again"
if [ "$STAGE" = all ] && [ -n "$ROOT" ] && [ -f "$ROOT.sha256" ]; then
	ui "Checking $(basename "$ROOT")..."
	[ "$(sha256sum "$ROOT" | cut -d' ' -f1)" = "$(cut -d' ' -f1 "$ROOT.sha256")" ] || die "$(basename "$ROOT") is damaged, download it again"
fi

# Where the layout goes (docs/partitions.md). Samsung's partition table
# can't be changed outside Download mode: its bootloader write-protects the
# start of the eMMC. So ours is a GPT inside one of Samsung's partitions:
#  - Nura, our Android: at the start of Samsung's system partition, the GPT
#    spanning system, cache, hidden and userdata (contiguous to the end of
#    the eMMC, as Samsung lays them out: 28.6 GiB);
#  - LineageOS (it keeps Samsung's system, cache and hidden), another table,
#    or GTS3_NESTED=1: at the start of userdata.
# lk2nd reads a table inside a partition only as MBR: a hybrid MBR there
# points it at gts3_boot. Nura's initramfs, OrangeFox and gsi-init look for
# the GPT at the start of system, then of userdata.
row() {	# <name>: number, first and last sector of that eMMC partition
	awk -v n="$1" '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $NF == n { print $1, $2, $3 }' "$W/gpt-disk"
}
tail_check() {	# Samsung's last four, contiguous to the end: sets TSTART, TLAST
	TLAST=$(sed -n 's/.*last usable sector is \([0-9]*\).*/\1/p' "$W/gpt-disk")
	set -- $(row system)
	[ $# = 3 ] || return 1
	TSTART=$2 k=" $1 " l=$3
	for p in cache hidden userdata; do
		set -- $(row $p)
		[ $# = 3 ] && [ "$2" = $((l + 1)) ] || return 1
		k="$k$1 " l=$3
	done
	[ "$l" = "$TLAST" ] || return 1
	# nothing else from system's start on
	[ -z "$(awk -v b="$TSTART" -v k="$k" \
		'$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $2 >= b && index(k, " " $1 " ") == 0' "$W/gpt-disk")" ] || return 1
	# at least 10 GiB
	[ $((TLAST - TSTART + 1)) -ge $((10240 * 2048)) ]
}
sectors() {	# <size with M or G>: in 512-byte sectors
	case "$1" in
	*G) echo $((${1%G} * 2097152)) ;;
	*M) echo $((${1%M} * 2048)) ;;
	*) echo "$1" ;;
	esac
}
$SGDISK --print "$DISK" > "$W/gpt-disk" 2>&1 || die "can't read the eMMC's partition table"
WHOLE=
if [ -z "$LOS" ] && [ -z "${GTS3_NESTED:-}" ]; then
	if tail_check; then
		WHOLE=1
		ui "On the whole internal storage (Samsung's system, cache, hidden, userdata)"
	else
		ui "Samsung's last partitions aren't as expected: the layout goes in userdata"
	fi
fi

# Samsung's partitions free: the recovery may have them mounted, or (our
# layout) loop devices on them with /data on one of them
mounts() { awk '{ print $1, $2 }' /proc/mounts | while read -r s m; do [ "$(readlink -f "$s")" = "$1" ] && echo "$m"; done; }
for m in /data /sdcard /cache /system_root /system; do umount "$m" 2> /dev/null; done
WD=$(readlink -f "$DATA_DEV")
for p in system cache hidden userdata; do
	set -- $(row $p)
	[ $# = 3 ] && [ -b "${DISK}p$1" ] && WD="$WD ${DISK}p$1"
done
# an encrypted Nura opened by an earlier run
[ ! -e "/dev/mapper/$CRYPT" ] || cs close "$CRYPT" || die "can't close /dev/mapper/$CRYPT"
LOOPS=
for l in $($LOSETUP -a 2> /dev/null | cut -d: -f1); do
	case "$($LOSETUP -a 2> /dev/null | grep "^$l:")" in *"(${DISK})"* | *"(${DISK#/dev/block/})"* | *"($(readlink -f "$DATA_DEV"))"*) LOOPS="$LOOPS $l" ;; esac
done
for d in $WD $LOOPS; do
	for m in $(mounts "$d"); do umount "$m" 2> /dev/null || umount -l "$m"; done
done
for d in $WD $LOOPS; do
	[ -z "$(mounts "$d")" ] || die "$d is still mounted"
done
for l in $LOOPS; do $LOSETUP -d "$l" || die "can't free $l"; done

# start and last sector of partition $1 (a number or a name)
first() { awk -v n="$1" '$1 == n || $NF == n { print $2 }' "$W/gpt"; }
last() { awk -v n="$1" '$1 == n || $NF == n { print $3 }' "$W/gpt"; }
# loop devices: toybox's losetup (the recovery's) takes -S for the size,
# util-linux's --sizelimit
attach() {	# <loop device> <offset> <size>, in bytes, <file>
	if $LOSETUP --help 2>&1 | grep -q -e --sizelimit; then
		$LOSETUP -o "$2" --sizelimit "$3" "$1" "$4"
	else
		$LOSETUP -o "$2" -S "$3" "$1" "$4"
	fi
}
# a free loop device. losetup -f may add one to the kernel and then fail to
# open it: in a recovery on our mainline kernel, ueventd makes no nodes after
# its coldboot. So the nodes are made here, then it is asked again.
loopnodes() {
	for s in /sys/block/loop*; do
		[ -r "$s/dev" ] || continue
		d=/dev/block/${s##*/}
		[ -b "$d" ] || { mm=$(cat "$s/dev") && mknod "$d" b "${mm%:*}" "${mm#*:}"; }
	done
}
newloop() {
	for t in 1 2 3 4; do
		loopnodes
		d=$($LOSETUP -f 2> /dev/null) && [ -b "$d" ] && { echo "$d"; return 0; }
		sleep 0.3
	done
	return 1
}
# a GPT header at sector 1 of $1 (a file or device) from sector $2 on
gpt_at() { [ "$(dd if="$1" bs=512 skip=$(($2 + 1)) count=1 2> /dev/null | head -c 8)" = "EFI PART" ]; }

# Samsung's Wi-Fi board data (etc/firmware/bdwlan30.bin: this tablet's
# radio calibration and regulatory domain; without it 5 GHz is limited to the
# world domain) is in its system partition, which the whole-storage layout
# takes. Kept on our boot partition, gts3/firmware/ (Nura's gts3-firmware
# reads it there): from Samsung's system or a ROM on it, else from the boot
# partition of an earlier layout of ours.
rm -f "$WB"
wb_from_fs() {	# <dir>: the board data in a mounted file system
	for f in etc/firmware/bdwlan30.bin system/etc/firmware/bdwlan30.bin vendor/firmware/bdwlan30.bin \
		system/vendor/firmware/bdwlan30.bin gts3/firmware/bdwlan30.bin; do
		[ -s "$1/$f" ] && cp "$1/$f" "$WB" && return 0
	done
	return 1
}
wb_from() {	# <eMMC sector>: a file system there, or our layout's boot partition
	[ -b "$DISK" ] || return 1
	mkdir -p "$W/wb"
	l=$(newloop) || return 1
	$LOSETUP -r -o $(($1 * 512)) "$l" "$DISK" || return 1
	if mount -t ext4 -o ro,noload "$l" "$W/wb" 2> /dev/null || mount -t ext2 -o ro "$l" "$W/wb" 2> /dev/null; then
		wb_from_fs "$W/wb"; r=$?
		umount "$W/wb"
	elif gpt_at "$DISK" "$1"; then
		# our layout: its gts3_boot (the first partition) through the hybrid MBR
		$SGDISK --print "$l" > "$W/wb.gpt" 2>&1
		set -- $(awk '$NF == "gts3_boot" { print $2 }' "$W/wb.gpt") "$1"
		$LOSETUP -d "$l"
		[ $# = 2 ] || return 1
		$LOSETUP -r -o $((($2 + $1) * 512)) "$l" "$DISK" || return 1
		mount -t ext2 -o ro "$l" "$W/wb" 2> /dev/null && { wb_from_fs "$W/wb"; r=$?; umount "$W/wb"; } || r=1
	else
		r=1
	fi
	$LOSETUP -d "$l" 2> /dev/null
	return $r
}
set -- $(row system)
[ $# = 3 ] && wb_from "$2" || { set -- $(row userdata); [ $# = 3 ] && wb_from "$2"; } || :
[ -s "$WB" ] && ui "Wi-Fi board data: kept" ||
	ui "No Wi-Fi board data found (Samsung's system was erased before): 5 GHz stays limited, see docs/wifi.md"

ERASED=1
SYS=$(row system)
if [ -n "$WHOLE" ]; then
	ui "Making the layout in system, cache, hidden and userdata..."
	# userdata's start: an older layout's table there would be found too
	set -- $(row userdata)
	dd if=/dev/zero of="$DISK" bs=512 seek="$2" count=2048 conv=notrunc,fsync 2> /dev/null || die "clearing userdata's start"
	# the GPT on a loop device over the four, so it ends where userdata ends
	CDEV=$(newloop) || die "no free loop device"
	attach "$CDEV" $((TSTART * 512)) $(((TLAST - TSTART + 1) * 512)) "$DISK" || die "losetup for the layout"
	SRC=$DISK PBASE=$((TSTART * 512))
else
	ui "Making the layout in userdata..."
	# system's start: a whole-storage layout's table there would be found first
	set -- $SYS
	if [ $# = 3 ] && gpt_at "$DISK" "$2"; then
		dd if=/dev/zero of="$DISK" bs=512 seek="$2" count=2048 conv=notrunc,fsync 2> /dev/null || die "clearing system's start"
	fi
	CDEV=$DATA_DEV SRC=$DATA_DEV PBASE=0
fi
# long options only: the recoveries' sgdisk (Android's build) has no short ones
# Only what is installed; the last partition gets the rest. Nura only in
# userdata: android_data stays, small, for the recovery's /data (it must not
# be userdata: that holds the layout). Everything finds them by name.
NP=1 PARTS="--new=1:2048:+512M --typecode=1:EF00 --change-name=1:gts3_boot"
addpart() { NP=$((NP + 1)); PARTS="$PARTS --new=$NP:0:$2 --typecode=$NP:8300 --change-name=$NP:$1"; }
if [ -n "$GSI" ]; then
	addpart android_system "+$SYSTEM"
	addpart android_vendor "+$VENDOR"
fi
if [ -z "$ROOT" ]; then
	addpart android_data 0
elif [ -n "$GSI" ]; then
	addpart android_data "+$DATA"
	addpart nura 0
elif [ -n "$LOS" ]; then
	addpart android_data "+$LOS_DATA"
	addpart nura 0
elif [ -n "$WHOLE" ]; then
	addpart nura 0
else
	addpart android_data +256M
	addpart nura 0
fi
$SGDISK --zap-all "$CDEV" > /dev/null 2>&1
# shellcheck disable=SC2086
$SGDISK --clear $PARTS "$CDEV" > "$W/sgdisk.log" 2>&1 || die "sgdisk: $(tail -n 1 "$W/sgdisk.log")"
$SGDISK --print "$CDEV" > "$W/gpt" 2>&1 || die "no GPT after sgdisk"
# the last partition (the rest) a whole number of 4 KiB blocks, as the others
# are: an encrypted Nura uses 4 KiB sectors
lf=$(first $NP) ll=$(last $NP) ln=$(awk -v n="$NP" '$1 == n { print $NF }' "$W/gpt")
le=$((lf + (ll - lf + 1) / 8 * 8 - 1))
if [ "$le" != "$ll" ]; then
	$SGDISK --delete=$NP --new=$NP:$lf:$le --typecode=$NP:8300 --change-name=$NP:$ln "$CDEV" > "$W/sgdisk.log" 2>&1 ||
		die "sgdisk: $(tail -n 1 "$W/sgdisk.log")"
	$SGDISK --print "$CDEV" > "$W/gpt" 2>&1 || die "no GPT after sgdisk"
fi

# Hybrid MBR (lk2nd reads only MBR): entry 0 = gts3_boot, entry 1 = 0xEE
le32() { printf '\\%03o\\%03o\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)); }
bs=$(first 1); bl=$(($(last 1) - bs + 1))
chs='\376\377\377'
{
	printf "\\000$chs\\203$chs$(le32 "$bs")$(le32 "$bl")\\000$chs\\356$chs$(le32 1)$(le32 $((bs - 1)))"
	dd if=/dev/zero bs=32 count=1 2> /dev/null
	printf '\125\252'
} > "$W/mbr"
[ "$(stat -c %s "$W/mbr")" = 66 ] || die "hybrid MBR"
dd if="$W/mbr" of="$CDEV" bs=1 seek=446 conv=notrunc,fsync 2> /dev/null || die "writing the MBR"
sync
[ -z "$WHOLE" ] || $LOSETUP -d "$CDEV" || die "can't free $CDEV"

# A loop device for each partition, $G/<name>
# links from an earlier run would point at loop devices now used otherwise
rm -f "$G"/*
: > "$W/loops"
for n in $(awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { print $1 }' "$W/gpt"); do
	f=$(first $n) l=$(last $n)
	name=$(awk -v n="$n" '$1 == n { print $NF }' "$W/gpt")
	dev=$(newloop) || die "no free loop device"
	attach "$dev" $((PBASE + f * 512)) $(((l - f + 1) * 512)) "$SRC" || die "losetup $name"
	echo "$dev" >> "$W/loops"
	ln -sf "$dev" "$G/$name"
done
FDE_UUID=
if [ -n "${GTS3_FDE_KEY:-}" ]; then
	[ -n "$ROOT" ] || die "GTS3_FDE_KEY: there is no Nura to encrypt"
	[ "$STAGE" = layout ] || die "GTS3_FDE_KEY: from the PC only (setup.sh, setup.ps1)"
	fde_format "$GTS3_FDE_KEY"
fi

ui "Boot partition: lk2nd's menu, kernels..."
$MKE2FS -q -F -t ext2 -b 1024 -L pmOS_boot -U "$BOOT_UUID" "$G/gts3_boot" > /dev/null 2>&1 || die "mke2fs boot"
mount -t ext2 "$G/gts3_boot" "$W/mnt" 2> /dev/null || mount -t ext4 "$G/gts3_boot" "$W/mnt" || die "mount boot"
[ -z "$ROOT" ] || unzip -p "$ZIP" nura-boot.tar | tar -x -C "$W/mnt" || die "Nura's boot files"
if [ -s "$WB" ]; then
	mkdir -p "$W/mnt/gts3/firmware" && cp "$WB" "$W/mnt/gts3/firmware/bdwlan30.bin" || die "the Wi-Fi board data"
fi
if [ -n "$GSI" ] || [ -n "$RDTB" ]; then
	mkdir -p "$W/mnt/gts3/android"
	cp android/Image.gz "$W/mnt/gts3/android/" || die "Android's kernel"
fi
if [ -n "$GSI" ]; then
	cp "$ADTB" "$W/mnt/gts3/android/gts3.dtb" && cp android/initramfs "$W/mnt/gts3/android/" || die "Android's boot files"
fi
if [ -n "$RDTB" ]; then
	mkdir -p "$W/mnt/gts3/recovery"
	cp android/recovery/ramdisk "$W/mnt/gts3/recovery/" && cp "$RDTB" "$W/mnt/gts3/recovery/gts3.dtb" ||
		die "the recovery's files"
fi
mkdir -p "$W/mnt/extlinux"
{
	echo "# Galaxy Tab S3 ($SETUP). lk2nd boots the default label; switch with"
	echo "# gts3-boot, or Volume Down at power-on for lk2nd's menu."
	if [ -n "$ROOT" ]; then
		echo "default nura"
		echo
		echo "label nura"
		echo "	linux /vmlinuz"
		echo "	initrd /initramfs"
		echo "	fdt /$DTB"
		if [ -n "$FDE_UUID" ]; then
			# the root is the LUKS container (the initramfs unlocks it); no
			# inlinecrypt: dm-crypt encrypts, the eMMC's engine isn't reached
			echo "	append $(printf '%s' "$NURA_CMDLINE" | sed "s/pmos_root_uuid=[^ ]*/pmos_root_uuid=$FDE_UUID/")"
		else
			echo "	append $(ice_cmdline "$NURA_CMDLINE")"
		fi
	elif [ -n "$LOS" ]; then
		echo "default orangefox"
	else
		echo "default android"
	fi
	if [ -n "$GSI" ]; then
		echo
		echo "label android"
		echo "	linux /gts3/android/Image.gz"
		echo "	initrd /gts3/android/initramfs"
		echo "	fdt /gts3/android/gts3.dtb"
		echo "	append $(cat android/cmdline) gsi.parts=1${WHOLE:+ gsi.disk=system}"
	fi
	if [ -n "$RDTB" ]; then
		echo
		echo "label orangefox"
		echo "	linux /gts3/android/Image.gz"
		echo "	initrd /gts3/recovery/ramdisk"
		echo "	fdt /gts3/recovery/gts3.dtb"
		echo "	append $(cat android/recovery/cmdline)"
	fi
} > "$W/mnt/extlinux/extlinux.conf"
sync
umount "$W/mnt" || die "umount boot"

if [ "$STAGE" = all ] && [ -n "$ROOT" ]; then
	ui "Nura: its root (a few minutes)..."
	case "$ROOT" in
	*.xz)
		if [ -n "${ROOT_BYTES:-}" ]; then
			[ "$ROOT_BYTES" -le $((($(last nura) - $(first nura) + 1) * 512)) ] || die "Nura's root is larger than its partition"
		fi
		unxz "$ROOT" > "$G/nura" || die "unpacking $(basename "$ROOT")" ;;
	*) $SIMG2IMG "$ROOT" "$G/nura" || die "simg2img $(basename "$ROOT")" ;;
	esac
	fixroot
	wb_root
fi

if [ -e "$G/android_data" ]; then
	if [ -n "$GSI" ]; then ui "Android: data..."
	elif [ -n "$LOS" ]; then ui "LineageOS: data..."
	else ui "The recovery's data partition..."; fi
	$MKE2FS -q -F -t ext4 -L android_data "$G/android_data" > /dev/null 2>&1 || die "mke2fs android_data"
fi
if [ -n "$GSI" ]; then
	ui "Android: vendor, system..."
	unzip -p "$ZIP" android/vendor.img | dd of="$G/android_vendor" bs=4M conv=fsync 2> /dev/null || die "vendor image"
fi
if [ "$STAGE" = all ] && [ -n "$GSI" ]; then
	# zip64 (GSI zips over 4 GB): gsi-unzip from the Android release
	UNZIP=unzip
	[ -x "$W/tools/gsi-unzip" ] && UNZIP=$W/tools/gsi-unzip
	case "$GSI" in
	*.zip)
		n=$($UNZIP -Z1 "$GSI" 2> /dev/null | grep -E '(^|/)system\.img$' | head -n 1)
		[ -n "$n" ] || die "no system.img in $(basename "$GSI")"
		$UNZIP -p "$GSI" "$n" > "$G/android_system" || die "system image" ;;
	*.xz) unxz "$GSI" > "$G/android_system" || die "system image" ;;
	*)
		if [ "$(od -An -tx1 -N4 "$GSI" | tr -d ' ')" = 3aff26ed ]; then
			$SIMG2IMG "$GSI" "$G/android_system" || die "system image"
		else
			dd if="$GSI" of="$G/android_system" bs=4M conv=fsync 2> /dev/null || die "system image"
		fi ;;
	esac
fi
sync
HAS_LOS=${LOS:+1}
if [ "$STAGE" = layout ]; then
	# for the next stages; the partitions stay attached
	{
		echo "SETUP='$SETUP'"
		echo "HAS_NURA=${ROOT:+1}"
		echo "FDE_UUID=$FDE_UUID"
		echo "HAS_GSI=${GSI:+1}"
		echo "HAS_LOS=$HAS_LOS"
		echo "LK2ND=$LK2ND"
		echo "WHOLE=$WHOLE"
	} > stage.env
	n=
	[ -z "$ROOT" ] || n="Nura's root"
	[ -z "$GSI" ] || n="${n:+$n and }the GSI"
	[ -z "$LOS" ] || n="${n:+$n and }the LineageOS zip"
	ui "Layout done. Next: the PC sends $n"
	exit 0
fi
[ "$STAGE" != all ] || [ -z "$LOS" ] || runlos "$LOS"
cleanup
flashlk2nd "$ROOT"
exit 0
