#!/sbin/sh
# Galaxy Tab S3 installer for OrangeFox / TWRP (docs/dual-boot.md): Nura
# (postmarketOS), our Android (any GSI on our vendor), or both side by side
# on internal storage, with lk2nd v2 to choose.
#
# Put this zip in one folder on the microSD card or a USB drive with
#   nura-root.img.xz                  -> Nura
#   a GSI (named *system* or *gsi*:   -> Android
#   .img, .img.xz, or a zip with system.img)
# (both -> both side by side), then Install this zip. It ERASES the userdata
# partition (internal storage: all Android data, a postmarketOS install),
# makes the layout in it with only what is installed, writes the systems and
# flashes lk2nd v2 to the start of the boot partition. Each way it adds
# OrangeFox on our kernel as lk2nd's "orangefox" entry, if the zip has it
# (android/recovery).
#
# Runs under the zip's busybox (recoveries differ in their tools, and their
# mksh computes in 32 bits). From the recovery: sgdisk, mke2fs, e2fsck,
# resize2fs, simg2img, and toybox's losetup (offsets and sizes).
# Arguments (update-binary protocol): <api> <outfd> <zip>
# Test overrides: MODEL, DATA_DEV, BOOT_DEV, GSI, SYSTEM, VENDOR, DATA, WORK
#
# Staged, for a PC over adb (setup.sh, setup.ps1), with the big images on
# the PC instead of next to the zip. GTS3_STAGE picks the stage:
#   layout  GTS3_SETUP=nura|android|both: everything but Nura's root and the
#           GSI: the layout, the boot partition, Android's vendor and data.
#           The partitions stay attached for the next stages
#   recv    GTS3_PART=nura|android_system, GTS3_FORMAT=xz|raw,
#           GTS3_SHA256=<the sha256 of what is sent>: writes the image on
#           stdin to that partition (adb shell -T ... < image; not adb
#           exec-in, which returns before the tablet is done and without
#           its output). It fails if the stream's sha256 differs (the zip's
#           xzcat doesn't check xz's CRC64)
#   finish  Nura's root checked and grown; GTS3_ANSWERS=<dir> (optional):
#           gts3-firstsetup with those answers and GTS3_UTC=<the PC's time>;
#           then lk2nd v2
# Without GTS3_STAGE, all of it in one go from the files next to the zip.
OUTFD=$2
ZIP=$3
case "$0" in /*) SELF=$0 ;; *) SELF=$PWD/$0 ;; esac
case "$ZIP" in /*) ;; *) ZIP=$PWD/$ZIP ;; esac
if [ -z "${GTS3_BB:-}" ]; then
	B=/tmp/gts3-bb
	rm -rf "$B" && mkdir -p "$B" && cd "$B" &&
		unzip -o "$ZIP" tools/busybox > /dev/null 2>&1 &&
		chmod 0755 tools/busybox && "$B/tools/busybox" --install -s "$B" || {
		echo "ui_print ERROR: can't unpack tools/busybox from $ZIP" >&"$OUTFD"
		exit 1
	}
	# the recovery's e2fsprogs and losetup, not busybox's
	rm -f "$B/mke2fs" "$B/mkfs.ext2" "$B/tune2fs" "$B/e2fsck" "$B/fsck" "$B/losetup"
	export GTS3_BB=$B PATH="$B:$PATH"
	exec "$B/tools/busybox" sh "$SELF" "$1" "$2" "$ZIP"
fi
DATA_DEV=${DATA_DEV:-/dev/block/bootdevice/by-name/userdata}
BOOT_DEV=${BOOT_DEV:-/dev/block/bootdevice/by-name/boot}
SYSTEM=${SYSTEM:-4G} VENDOR=${VENDOR:-1G} DATA=${DATA:-4G}
W=${WORK:-/tmp/gts3-install}
G=$W/dev
DIR=$(dirname "$ZIP")
STAGE=${GTS3_STAGE:-all}
# the stages after the layout keep its partitions attached, also on errors
KEEP=
[ "$STAGE" = all ] || [ "$STAGE" = layout ] || KEEP=1

ui() { echo "ui_print $*" >&"$OUTFD"; echo "ui_print" >&"$OUTFD"; }
die() {
	ui "ERROR: $*"
	[ -n "${ERASED:-}" ] && ui "userdata was changed: run this installer again" ||
		ui "Nothing on the tablet was changed."
	cleanup
	exit 1
}
cleanup() {
	umount "$W/nura/sys" "$W/nura/proc" "$W/nura/dev" "$W/nura" "$W/mnt" 2> /dev/null
	[ -z "$KEEP" ] || return 0
	for l in $(cat "$W/loops" 2> /dev/null); do losetup -d "$l" 2> /dev/null; done
	rm -f "$W/loops"
}
case "$STAGE" in all | layout | recv | finish) ;; *) die "GTS3_STAGE: layout, recv or finish" ;; esac
# the recovery's tools (not the zip's busybox)
tool() {
	for c in $(which -a "$1" 2> /dev/null) /system/bin/$1 /sbin/$1; do
		case "$c" in "$GTS3_BB"/*) continue ;; esac
		[ -x "$c" ] && { echo "$c"; return 0; }
	done
	return 1
}
SGDISK=$(tool sgdisk) || die "this recovery has no sgdisk"
MKE2FS=$(tool mke2fs) || die "this recovery has no mke2fs"
E2FSCK=$(tool e2fsck) || die "this recovery has no e2fsck"
RESIZE2FS=$(tool resize2fs) || die "this recovery has no resize2fs"
SIMG2IMG=$(tool simg2img) || die "this recovery has no simg2img"
LOSETUP=$(tool losetup) || die "this recovery has no losetup"

ui "Galaxy Tab S3: Nura, Android, or both"
# the model: from the device tree on our kernel (one recovery for both),
# else from the recovery's build (Samsung's kernel)
if [ -z "${MODEL:-}" ]; then
	c=$(tr '\0' ' ' < /proc/device-tree/compatible 2> /dev/null)
	case "$c" in
	*samsung,gts3lwifi*) MODEL=gts3lwifi ;;
	*samsung,gts3llte*) MODEL=gts3llte ;;
	*) MODEL=$(getprop ro.product.device) ;;
	esac
fi
case "$MODEL" in
gts3lwifi) DTB=apq8096-samsung-gts3lwifi.dtb ;;
gts3llte) DTB=msm8996-samsung-gts3llte.dtb ;;
*) die "not a Galaxy Tab S3 (model: '$MODEL')" ;;
esac
mkdir -p "$W" "$G" "$W/mnt"
cd "$W" || die "no $W"

# Nura's root once it is written: checked, and grown to its partition
fixroot() {
	ui "Nura: checking its root..."
	$E2FSCK -fy "$G/nura" > /dev/null 2>&1
	[ $? -le 1 ] || die "e2fsck of Nura's root"
	$RESIZE2FS "$G/nura" > /dev/null 2>&1 || die "resize2fs of Nura's root"
}
# the last step: lk2nd v2 to the start of the boot partition
flashlk2nd() {
	ui "lk2nd v2..."
	dd if="$W/$LK2ND" of="$BOOT_DEV" bs=4096 conv=notrunc,fsync 2> /dev/null || die "writing lk2nd"
	if [ -n "$1" ]; then
		ui "Done ($SETUP). Reboot: lk2nd starts Nura"
	else
		ui "Done ($SETUP). Reboot: lk2nd starts Android"
	fi
	ui "(Volume Down at power-on: lk2nd's menu, with orangefox)."
}

# after a layout stage userdata is changed, whatever fails
[ -z "$KEEP" ] || [ ! -f stage.env ] || ERASED=1
if [ "$STAGE" = recv ]; then
	P=${GTS3_PART:-} F=${GTS3_FORMAT:-xz}
	case "$P" in nura | android_system) ;; *) die "GTS3_PART: nura or android_system" ;; esac
	case "$F" in xz | raw) ;; *) die "GTS3_FORMAT: xz or raw" ;; esac
	printf '%s' "${GTS3_SHA256:-}" | grep -Eq '^[0-9a-f]{64}$' || die "GTS3_SHA256: the sha256 of the image as sent"
	[ -f stage.env ] && [ -b "$G/$P" ] || die "no $P partition: run the layout stage first"
	rm -f "got-$P" recv.fifo recv.sum
	mkfifo recv.fifo || die "mkfifo"
	# the sha256 of the stream as sent, for the PC to compare
	sha256sum < recv.fifo > recv.sum &
	set -o pipefail
	if [ "$F" = xz ]; then
		tee recv.fifo | xzcat > "$G/$P"
	else
		tee recv.fifo | dd of="$G/$P" bs=4M 2> /dev/null
	fi
	rc=$?
	set +o pipefail
	wait
	sync
	[ $rc = 0 ] || die "writing $P: a damaged image, or larger than its partition"
	if [ "$P" = android_system ] && [ "$(od -An -tx1 -N4 "$G/$P" | tr -d ' ')" = 3aff26ed ]; then
		die "the GSI is a sparse image: unpack it first (simg2img)"
	fi
	s=$(cut -d' ' -f1 recv.sum)
	[ "$s" = "$GTS3_SHA256" ] || die "$P arrived damaged (sha256 $s): send it again"
	echo "$s" > "got-$P"
	ui "$P: written, sha256 matches"
	exit 0
fi

if [ "$STAGE" = finish ]; then
	[ -f stage.env ] || die "run the layout stage first"
	. ./stage.env
	[ -z "$HAS_NURA" ] || [ -f got-nura ] || die "Nura's root wasn't sent"
	[ -z "$HAS_GSI" ] || [ -f got-android_system ] || die "the GSI wasn't sent"
	if [ -n "$HAS_NURA" ]; then
		fixroot
		if [ -n "${GTS3_ANSWERS:-}" ]; then
			ui "Nura: your settings..."
			[ -d "$GTS3_ANSWERS" ] || die "no answers in $GTS3_ANSWERS"
			mkdir -p "$W/nura"
			mount -t ext4 "$G/nura" "$W/nura" || die "mount Nura's root"
			mount -t ext2 "$G/gts3_boot" "$W/mnt" 2> /dev/null || mount -t ext4 "$G/gts3_boot" "$W/mnt" || die "mount boot"
			sh tools/gts3-firstsetup "$W/nura" "$W/mnt" "$GTS3_ANSWERS" ${GTS3_UTC:-} > firstsetup.log 2>&1
			rc=$?
			while read -r l; do ui "${l#gts3-firstsetup: }"; done < firstsetup.log
			[ $rc = 0 ] || die "Nura's settings weren't all applied: fix the answer above, run finish again"
			umount "$W/nura" && umount "$W/mnt" || die "umount"
		fi
	fi
	KEEP=
	cleanup
	flashlk2nd "$HAS_NURA"
	exit 0
fi

rm -f stage.env got-* recv.* firstsetup.log
# Small files here; the big ones (Nura's boot files, the vendor image) are
# checked and later written straight from the zip: /tmp is RAM in a recovery
BIG="nura-boot.tar android/vendor.img"
unzip -o -q "$ZIP" -x 'META-INF/*' $BIG || die "can't unpack the zip"
grep -v -e ' nura-boot\.tar$' -e ' android/vendor\.img$' SHA256SUMS > sums.small
sha256sum -c -s sums.small 2> /dev/null || die "the zip's files are damaged, download it again"
zsum() {	# the sha256 of $1 in the zip is the listed one
	[ "$(unzip -p "$ZIP" "$1" | sha256sum | cut -d' ' -f1)" = "$(awk -v f="$1" '$2 == f { print $1 }' SHA256SUMS)" ]
}
. ./nura.env || die "no nura.env in the zip"
LK2ND=lk2nd-$MODEL.img
[ -s "$LK2ND" ] || die "no $LK2ND in the zip: no lk2nd v2 for this model yet"
# Nura's root: raw and xz'd (releases), or a sparse image; none: no Nura
ROOT=$DIR/nura-root.img.xz
[ -f "$ROOT" ] || ROOT=$DIR/nura-root.simg
[ -f "$ROOT" ] || ROOT=
# our Android's files for this model, and the recovery's
ADTB=
if [ -s android/Image.gz ]; then
	ADTB=android/dtb/$DTB
	[ -s "$ADTB" ] || ADTB=android/gts3.dtb
fi
RDTB=
[ -s android/recovery/ramdisk ] && [ -s "android/recovery/$DTB" ] && RDTB=android/recovery/$DTB
# the GSI: a system image by its name (other images may be in the folder);
# staged: the PC has them, GTS3_SETUP says which
if [ "$STAGE" = layout ]; then
	case "${GTS3_SETUP:-}" in
	nura) ROOT=pc GSI= ;;
	android) ROOT= GSI=pc ;;
	both) ROOT=pc GSI=pc ;;
	*) die "GTS3_SETUP: nura, android or both" ;;
	esac
elif [ -z "${GSI:-}" ]; then
	GSI=$(ls "$DIR"/*system*.img "$DIR"/*system*.img.xz "$DIR"/*gsi*.img "$DIR"/*gsi*.img.xz \
		"$DIR"/*system*.zip "$DIR"/*gsi*.zip 2> /dev/null | grep -v -e nura-root -e "$(basename "$ZIP")" | head -n 1)
fi
[ -z "$GSI" ] || [ -s "$ADTB" ] || die "this zip has no Android files for $MODEL"
[ -n "$ROOT$GSI" ] || die "put nura-root.img.xz (Nura) and/or a GSI (Android) next to this zip"
if [ -n "$ROOT" ] && [ -n "$GSI" ]; then SETUP="Nura and Android"
elif [ -n "$ROOT" ]; then SETUP="Nura only"
else SETUP="Android only"; fi
ui "Installing: $SETUP"
if [ "$STAGE" = all ]; then
	[ -z "$ROOT" ] || ui "Nura: $(basename "$ROOT")"
	[ -z "$GSI" ] || ui "Android: $(basename "$GSI")"
fi
ui "Checking the zip..."
[ -z "$ROOT" ] || zsum nura-boot.tar || die "nura-boot.tar in the zip is damaged, download it again"
[ -z "$GSI" ] || zsum android/vendor.img || die "the vendor image in the zip is damaged, download it again"
if [ "$STAGE" = all ] && [ -n "$ROOT" ] && [ -f "$ROOT.sha256" ]; then
	ui "Checking $(basename "$ROOT")..."
	[ "$(sha256sum "$ROOT" | cut -d' ' -f1)" = "$(cut -d' ' -f1 "$ROOT.sha256")" ] || die "$(basename "$ROOT") is damaged, download it again"
fi

# userdata free: the recovery may have it mounted, or (dual boot mode) loop
# devices on it with /data on one of them
UD=$(readlink -f "$DATA_DEV")
LOOPS=$($LOSETUP -a 2> /dev/null | grep -F "($UD)" | cut -d: -f1)
for d in "$UD" $LOOPS; do
	for m in $(awk -v d="$d" '$1 == d { print $2 }' /proc/mounts); do umount "$m" 2> /dev/null || umount -l "$m"; done
done
for m in /data /sdcard; do umount "$m" 2> /dev/null; done
for d in "$UD" $LOOPS; do
	awk -v d="$d" '$1 == d { found = 1 } END { exit !found }' /proc/mounts && die "$d is still mounted"
done
for l in $LOOPS; do $LOSETUP -d "$l" || die "can't free $l"; done

ui "Making the layout in userdata..."
ERASED=1
# long options only: the recoveries' sgdisk (Android's build) has no short ones
# Only what is installed. Nura only: android_data stays, small, for the
# recovery's /data (it must not be userdata: that holds the layout). The
# last partition gets the rest. Everything finds them by name.
NP=1 PARTS="--new=1:2048:+512M --typecode=1:EF00 --change-name=1:gts3_boot"
addpart() { NP=$((NP + 1)); PARTS="$PARTS --new=$NP:0:$2 --typecode=$NP:8300 --change-name=$NP:$1"; }
if [ -n "$GSI" ]; then
	addpart android_system "+$SYSTEM"
	addpart android_vendor "+$VENDOR"
fi
if [ -z "$ROOT" ]; then
	addpart android_data 0
elif [ -z "$GSI" ]; then
	addpart android_data +256M
	addpart nura 0
else
	addpart android_data "+$DATA"
	addpart nura 0
fi
$SGDISK --zap-all "$DATA_DEV" > /dev/null 2>&1
# shellcheck disable=SC2086
$SGDISK --clear $PARTS "$DATA_DEV" > "$W/sgdisk.log" 2>&1 || die "sgdisk: $(tail -n 1 "$W/sgdisk.log")"
$SGDISK --print "$DATA_DEV" > "$W/gpt" 2>&1 || die "no GPT after sgdisk"

# start and last sector of partition $1 (a number or a name)
first() { awk -v n="$1" '$1 == n || $NF == n { print $2 }' "$W/gpt"; }
last() { awk -v n="$1" '$1 == n || $NF == n { print $3 }' "$W/gpt"; }

# Hybrid MBR (lk2nd reads only MBR): entry 0 = gts3_boot, entry 1 = 0xEE
le32() { printf '\\%03o\\%03o\\%03o\\%03o' $(($1 & 255)) $((($1 >> 8) & 255)) $((($1 >> 16) & 255)) $((($1 >> 24) & 255)); }
bs=$(first 1); bl=$(($(last 1) - bs + 1))
chs='\376\377\377'
{
	printf "\\000$chs\\203$chs$(le32 "$bs")$(le32 "$bl")\\000$chs\\356$chs$(le32 1)$(le32 $((bs - 1)))"
	dd if=/dev/zero bs=32 count=1 2> /dev/null
	printf '\125\252'
} > "$W/mbr"
[ "$(stat -c %s "$W/mbr")" = 66 ] || die "hybrid MBR"
dd if="$W/mbr" of="$DATA_DEV" bs=1 seek=446 conv=notrunc,fsync 2> /dev/null || die "writing the MBR"

# A loop device for each partition, $G/<name>: toybox's losetup (the
# recovery's) takes -S for the size, util-linux's --sizelimit
attach() {	# <loop device> <offset> <size>, in bytes
	if $LOSETUP --help 2>&1 | grep -q -e --sizelimit; then
		$LOSETUP -o "$2" --sizelimit "$3" "$1" "$DATA_DEV"
	else
		$LOSETUP -o "$2" -S "$3" "$1" "$DATA_DEV"
	fi
}
# a free loop device. losetup -f may add one to the kernel and then fail to
# open it: in a recovery on our mainline kernel, ueventd makes no nodes after
# its coldboot. So the nodes are made here, then it is asked again.
loopnodes() {
	for s in /sys/block/loop*; do
		[ -r "$s/dev" ] || continue
		d=/dev/block/${s##*/}
		[ -b "$d" ] || { mm=$(cat "$s/dev") && mknod "$d" b "${mm%:*}" "${mm#*:}"; }
	done
}
newloop() {
	for t in 1 2 3 4; do
		loopnodes
		d=$($LOSETUP -f 2> /dev/null) && [ -b "$d" ] && { echo "$d"; return 0; }
		sleep 0.3
	done
	return 1
}
: > "$W/loops"
for n in $(awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { print $1 }' "$W/gpt"); do
	f=$(first $n) l=$(last $n)
	name=$(awk -v n="$n" '$1 == n { print $NF }' "$W/gpt")
	dev=$(newloop) || die "no free loop device"
	attach "$dev" $((f * 512)) $(((l - f + 1) * 512)) || die "losetup $name"
	echo "$dev" >> "$W/loops"
	ln -sf "$dev" "$G/$name"
done

ui "Boot partition: lk2nd's menu, kernels..."
$MKE2FS -q -F -t ext2 -b 1024 -L pmOS_boot -U "$BOOT_UUID" "$G/gts3_boot" > /dev/null 2>&1 || die "mke2fs boot"
mount -t ext2 "$G/gts3_boot" "$W/mnt" 2> /dev/null || mount -t ext4 "$G/gts3_boot" "$W/mnt" || die "mount boot"
[ -z "$ROOT" ] || unzip -p "$ZIP" nura-boot.tar | tar -x -C "$W/mnt" || die "Nura's boot files"
if [ -n "$GSI" ] || [ -n "$RDTB" ]; then
	mkdir -p "$W/mnt/gts3/android"
	cp android/Image.gz "$W/mnt/gts3/android/" || die "Android's kernel"
fi
if [ -n "$GSI" ]; then
	cp "$ADTB" "$W/mnt/gts3/android/gts3.dtb" && cp android/initramfs "$W/mnt/gts3/android/" || die "Android's boot files"
fi
if [ -n "$RDTB" ]; then
	mkdir -p "$W/mnt/gts3/recovery"
	cp android/recovery/ramdisk "$W/mnt/gts3/recovery/" && cp "$RDTB" "$W/mnt/gts3/recovery/gts3.dtb" ||
		die "the recovery's files"
fi
mkdir -p "$W/mnt/extlinux"
{
	echo "# Galaxy Tab S3 ($SETUP). lk2nd boots the default label; switch with"
	echo "# gts3-boot, or Volume Down at power-on for lk2nd's menu."
	if [ -n "$ROOT" ]; then
		echo "default nura"
		echo
		echo "label nura"
		echo "	linux /vmlinuz"
		echo "	initrd /initramfs"
		echo "	fdt /$DTB"
		echo "	append $NURA_CMDLINE"
	else
		echo "default android"
	fi
	if [ -n "$GSI" ]; then
		echo
		echo "label android"
		echo "	linux /gts3/android/Image.gz"
		echo "	initrd /gts3/android/initramfs"
		echo "	fdt /gts3/android/gts3.dtb"
		echo "	append $(cat android/cmdline) gsi.parts=1"
	fi
	if [ -n "$RDTB" ]; then
		echo
		echo "label orangefox"
		echo "	linux /gts3/android/Image.gz"
		echo "	initrd /gts3/recovery/ramdisk"
		echo "	fdt /gts3/recovery/gts3.dtb"
		echo "	append $(cat android/recovery/cmdline)"
	fi
} > "$W/mnt/extlinux/extlinux.conf"
sync
umount "$W/mnt" || die "umount boot"

if [ "$STAGE" = all ] && [ -n "$ROOT" ]; then
	ui "Nura: its root (a few minutes)..."
	case "$ROOT" in
	*.xz)
		if [ -n "${ROOT_BYTES:-}" ]; then
			[ "$ROOT_BYTES" -le $((($(last nura) - $(first nura) + 1) * 512)) ] || die "Nura's root is larger than its partition"
		fi
		xzcat "$ROOT" > "$G/nura" || die "unpacking $(basename "$ROOT")" ;;
	*) $SIMG2IMG "$ROOT" "$G/nura" || die "simg2img $(basename "$ROOT")" ;;
	esac
	fixroot
fi

[ -n "$GSI" ] && ui "Android: data..." || ui "The recovery's data partition..."
$MKE2FS -q -F -t ext4 -L android_data "$G/android_data" > /dev/null 2>&1 || die "mke2fs android_data"
if [ -n "$GSI" ]; then
	ui "Android: vendor, system..."
	unzip -p "$ZIP" android/vendor.img | dd of="$G/android_vendor" bs=4M conv=fsync 2> /dev/null || die "vendor image"
fi
if [ "$STAGE" = all ] && [ -n "$GSI" ]; then
	# zip64 (GSI zips over 4 GB): gsi-unzip from the Android release
	UNZIP=unzip
	[ -x "$W/tools/gsi-unzip" ] && UNZIP=$W/tools/gsi-unzip
	case "$GSI" in
	*.zip)
		n=$($UNZIP -Z1 "$GSI" 2> /dev/null | grep -E '(^|/)system\.img$' | head -n 1)
		[ -n "$n" ] || die "no system.img in $(basename "$GSI")"
		$UNZIP -p "$GSI" "$n" > "$G/android_system" || die "system image" ;;
	*.xz) xzcat "$GSI" > "$G/android_system" || die "system image" ;;
	*)
		if [ "$(od -An -tx1 -N4 "$GSI" | tr -d ' ')" = 3aff26ed ]; then
			$SIMG2IMG "$GSI" "$G/android_system" || die "system image"
		else
			dd if="$GSI" of="$G/android_system" bs=4M conv=fsync 2> /dev/null || die "system image"
		fi ;;
	esac
fi
sync
if [ "$STAGE" = layout ]; then
	# for the next stages; the partitions stay attached
	{
		echo "SETUP='$SETUP'"
		echo "HAS_NURA=${ROOT:+1}"
		echo "HAS_GSI=${GSI:+1}"
		echo "LK2ND=$LK2ND"
	} > stage.env
	n=
	[ -z "$ROOT" ] || n="Nura's root"
	[ -z "$GSI" ] || n="${n:+$n and }the GSI"
	ui "Layout done. Next: the PC sends $n"
	exit 0
fi
cleanup
flashlk2nd "$ROOT"
exit 0
