#!/bin/sh
# Make the dual boot layout on a disk: a GPT with
#
#   gts3_boot       ext2 "pmOS_boot": extlinux.conf for lk2nd, both kernels
#   android_system  raw: the GSI's system image
#   android_vendor  raw: our vendor image
#   android_data    ext4 "android_data": Android's /data
#   nura            ext4 "pmOS_root": Nura's root
#   shared          exFAT "Shared": files for both (the rest of the disk)
#
# and the hybrid MBR entry lk2nd needs to find gts3_boot (it reads MBR only;
# Linux keeps using the GPT). The disk is the userdata partition (the layout
# then sits in it, as Nura's has so far), a microSD card, or an image file.
# ERASES the disk.
#
# usage: gts3-layout <disk> [yes]       (yes: don't ask)
#   sizes (sfdisk units: M, G): BOOT=512M SYSTEM=8G VENDOR=1G DATA=6G NURA=7G
# Needs sfdisk, mke2fs; mkfs.exfat for the shared partition (else left empty).
set -eu

[ $# -ge 1 ] || { sed -n '2,20p' "$0" >&2; exit 1; }
DISK=$1
BOOT=${BOOT:-512M} SYSTEM=${SYSTEM:-8G} VENDOR=${VENDOR:-1G} DATA=${DATA:-6G} NURA=${NURA:-7G}
[ -e "$DISK" ] || { echo "no $DISK" >&2; exit 1; }

if [ "${2:-}" != yes ]; then
	echo "This ERASES everything on $DISK:"
	lsblk "$DISK" 2>/dev/null || ls -l "$DISK"
	printf 'Type yes to go on: '
	read -r a
	[ "$a" = yes ] || exit 1
fi

# GPT partition types: EFI system (as pmbootstrap gives pmOS_boot), Linux
# data, Microsoft basic data (exFAT)
ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
MSDATA=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7

sfdisk -q --wipe always --wipe-partitions always "$DISK" <<EOF
label: gpt
size=$BOOT, type=$ESP, name=gts3_boot
size=$SYSTEM, type=$LINUX, name=android_system
size=$VENDOR, type=$LINUX, name=android_vendor
size=$DATA, type=$LINUX, name=android_data
size=$NURA, type=$LINUX, name=nura
type=$MSDATA, name=shared
EOF

# start and size (512-byte sectors) of partition $1, from sfdisk's dump
part() {
	sfdisk -d "$DISK" | sed -n "s/^[^ ]*[^0-9]$1 : *start= *\([0-9]*\), *size= *\([0-9]*\),.*/\1 \2/p"
}

# shared up to the last sector: sfdisk ends it on a MiB boundary, and with
# any free space at the end of a nested GPT ("subpartitions") the pmOS
# initramfs runs `parted resizepart 2 100%` at boot (partition 2 is
# android_system here; parted refuses, but it shouldn't try)
last=$(sfdisk -d "$DISK" | sed -n 's/^last-lba: *//p')
set -- $(part 6)
echo "$1, $((last - $1 + 1))" | sfdisk -q --no-reread -N 6 "$DISK"

# Hybrid MBR: entry 0 = gts3_boot (type 0x83), entry 1 = 0xEE from LBA 1 up
# to it, so Linux still takes the disk as GPT. Bytes 446..511 of sector 0.
le32() { printf '\\%03o\\%03o\\%03o\\%03o' $(( $1 & 255 )) $(( ($1 >> 8) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 24) & 255 )); }
set -- $(part 1)
bstart=$1 bsize=$2
[ -n "$bstart" ] && [ "$bstart" -gt 1 ] || { echo "can't read the boot partition's start" >&2; exit 1; }
chs='\376\377\377'
printf "\\000$chs\\203$chs$(le32 "$bstart")$(le32 "$bsize")\\000$chs\\356$chs$(le32 1)$(le32 $((bstart - 1)))" > /tmp/gts3-mbr.$$
dd if=/dev/zero bs=32 count=1 2>/dev/null >> /tmp/gts3-mbr.$$
printf '\125\252' >> /tmp/gts3-mbr.$$
[ "$(wc -c < /tmp/gts3-mbr.$$)" -eq 66 ] || { echo "hybrid MBR: wrong size" >&2; exit 1; }
dd if=/tmp/gts3-mbr.$$ of="$DISK" bs=1 seek=446 conv=notrunc,fsync 2>/dev/null
rm -f /tmp/gts3-mbr.$$

# File systems, at their partitions' offsets (works for image files too);
# no discard: it must not touch the other partitions
fs() {	# <partition number> <type> <label>
	set -- $(part "$1") "$2" "$3"
	mke2fs -q -F -t "$3" -L "$4" -E offset=$(($1 * 512)),nodiscard "$DISK" $(($2 / 2))
}
fs 1 ext2 pmOS_boot
fs 4 ext4 android_data
fs 5 ext4 pmOS_root

# exFAT has no offset option: through the partition's own device
if command -v mkfs.exfat > /dev/null 2>&1; then
	if [ -b "$DISK" ]; then
		case $DISK in *[0-9]) pdev=${DISK}p6 ;; *) pdev=${DISK}6 ;; esac
		partprobe "$DISK" 2>/dev/null || blockdev --rereadpt "$DISK" 2>/dev/null || true
		[ -b "$pdev" ] && mkfs.exfat -L Shared "$pdev" > /dev/null || echo "shared: $pdev not formatted"
	else
		echo "shared: left empty (image file)"
	fi
else
	echo "shared: no mkfs.exfat, left empty"
fi

sfdisk -l "$DISK" | sed -n '/^Device/,$p'
