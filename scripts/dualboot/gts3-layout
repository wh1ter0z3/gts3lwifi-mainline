#!/bin/sh
# Make the layout on a disk: a GPT with
#
#   gts3_boot       ext2 "pmOS_boot": extlinux.conf for lk2nd, the kernels
#   android_system  raw: the GSI's system image (SYSTEM=0: none)
#   android_vendor  raw: our vendor image (VENDOR=0: none)
#   android_data    ext4 "android_data": Android's /data, and the recovery's
#   nura            ext4 "pmOS_root": Nura's root (NURA=no: none)
#   shared          exFAT "Shared": files for both (the rest of the disk);
#                   SHARED=no leaves it out (a microSD card is the shared
#                   storage) and nura gets the rest (without nura, android_data)
#
# Nura only: SYSTEM=0 VENDOR=0 DATA=256M (android_data stays: the recovery's
# /data must not be userdata, which holds the layout). Android only: NURA=no.
# Everything finds these partitions by name, never by number.
#
# and the hybrid MBR entry lk2nd needs to find gts3_boot (it reads MBR only;
# Linux keeps using the GPT). The disk is the userdata partition (the layout
# then sits in it, as Nura's has so far), a microSD card, or an image file.
# ERASES the disk.
#
# usage: gts3-layout <disk> [yes]       (yes: don't ask)
#   sizes (sfdisk units: M, G): BOOT=512M SYSTEM=8G VENDOR=1G DATA=6G NURA=7G
#   SYSTEM=0, VENDOR=0: no such partition; NURA=no: no Nura partition
#   SHARED=no: no shared partition, the last one to the end (its size ignored)
# Needs sfdisk, mke2fs; mkfs.exfat for the shared partition (else left empty).
set -eu

[ $# -ge 1 ] || { sed -n '2,20p' "$0" >&2; exit 1; }
DISK=$1
BOOT=${BOOT:-512M} SYSTEM=${SYSTEM:-8G} VENDOR=${VENDOR:-1G} DATA=${DATA:-6G} NURA=${NURA:-7G}
SHARED=${SHARED:-yes}
[ -e "$DISK" ] || { echo "no $DISK" >&2; exit 1; }
[ "$NURA" != no ] || [ "$SYSTEM" != 0 ] || { echo "neither Nura nor Android" >&2; exit 1; }

if [ "${2:-}" != yes ]; then
	echo "This ERASES everything on $DISK:"
	lsblk "$DISK" 2>/dev/null || ls -l "$DISK"
	printf 'Type yes to go on: '
	read -r a
	[ "$a" = yes ] || exit 1
fi

# GPT partition types: EFI system (as pmbootstrap gives pmOS_boot), Linux
# data, Microsoft basic data (exFAT)
ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
MSDATA=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7

# The partitions in order; the last one gets the rest of the disk
{
	echo "label: gpt"
	echo "size=$BOOT, type=$ESP, name=gts3_boot"
	[ "$SYSTEM" = 0 ] || echo "size=$SYSTEM, type=$LINUX, name=android_system"
	[ "$VENDOR" = 0 ] || echo "size=$VENDOR, type=$LINUX, name=android_vendor"
	if [ "$NURA" = no ] && [ "$SHARED" = no ]; then
		echo "type=$LINUX, name=android_data"
	else
		echo "size=$DATA, type=$LINUX, name=android_data"
	fi
	if [ "$NURA" != no ]; then
		if [ "$SHARED" = no ]; then
			echo "type=$LINUX, name=nura"
		else
			echo "size=$NURA, type=$LINUX, name=nura"
		fi
	fi
	[ "$SHARED" = no ] || echo "type=$MSDATA, name=shared"
} > /tmp/gts3-table.$$
sfdisk -q --wipe always --wipe-partitions always "$DISK" < /tmp/gts3-table.$$
rm -f /tmp/gts3-table.$$

# start and size (512-byte sectors) of partition $1, from sfdisk's dump
part() {
	sfdisk -d "$DISK" | sed -n "s/^[^ ]*[^0-9]$1 : *start= *\([0-9]*\), *size= *\([0-9]*\),.*/\1 \2/p"
}
# the number of the partition named $1 (empty: none)
num() {
	sfdisk -d "$DISK" | sed -n "s/^[^ ]*[^0-9]\([0-9]*\) : .*name=\"$1\".*/\1/p"
}
LAST=$(sfdisk -d "$DISK" | grep -c '^[^ ]*[0-9] : ')

# The last partition up to the last sector: sfdisk ends it on a MiB boundary, and with
# any free space at the end of a nested GPT ("subpartitions") the pmOS
# initramfs runs `parted resizepart 2 100%` at boot (partition 2 is
# android_system here; parted refuses, but it shouldn't try)
last=$(sfdisk -d "$DISK" | sed -n 's/^last-lba: *//p')
set -- $(part $LAST)
echo "$1, $((last - $1 + 1))" | sfdisk -q --no-reread -N $LAST "$DISK"

# Hybrid MBR: entry 0 = gts3_boot (type 0x83), entry 1 = 0xEE from LBA 1 up
# to it, so Linux still takes the disk as GPT. Bytes 446..511 of sector 0.
le32() { printf '\\%03o\\%03o\\%03o\\%03o' $(( $1 & 255 )) $(( ($1 >> 8) & 255 )) $(( ($1 >> 16) & 255 )) $(( ($1 >> 24) & 255 )); }
set -- $(part 1)
bstart=$1 bsize=$2
[ -n "$bstart" ] && [ "$bstart" -gt 1 ] || { echo "can't read the boot partition's start" >&2; exit 1; }
chs='\376\377\377'
printf "\\000$chs\\203$chs$(le32 "$bstart")$(le32 "$bsize")\\000$chs\\356$chs$(le32 1)$(le32 $((bstart - 1)))" > /tmp/gts3-mbr.$$
dd if=/dev/zero bs=32 count=1 2>/dev/null >> /tmp/gts3-mbr.$$
printf '\125\252' >> /tmp/gts3-mbr.$$
[ "$(wc -c < /tmp/gts3-mbr.$$)" -eq 66 ] || { echo "hybrid MBR: wrong size" >&2; exit 1; }
dd if=/tmp/gts3-mbr.$$ of="$DISK" bs=1 seek=446 conv=notrunc,fsync 2>/dev/null
rm -f /tmp/gts3-mbr.$$

# File systems, at their partitions' offsets (works for image files too);
# no discard: it must not touch the other partitions
fs() {	# <partition number> <type> <label> [mke2fs options]
	p=$(part "$1"); t=$2 l=$3; shift 3
	set -- "$@" $p
	eval "start=\${$(($# - 1))} size=\${$#}"
	n=$(($# - 2))
	# the options are the first $n arguments
	o=; i=0; for a in "$@"; do [ $i -lt $n ] && o="$o $a"; i=$((i + 1)); done
	# shellcheck disable=SC2086
	mke2fs -q -F -t "$t" -L "$l" $o -E offset=$((start * 512)),nodiscard "$DISK" $((size / 2))
}
# 1 KiB blocks for lk2nd, as pmbootstrap makes pmOS_boot
fs 1 ext2 pmOS_boot -b 1024
fs "$(num android_data)" ext4 android_data
[ "$NURA" = no ] || fs "$(num nura)" ext4 pmOS_root

# exFAT has no offset option: through the partition's own device
if [ "$SHARED" = no ]; then
	:
elif command -v mkfs.exfat > /dev/null 2>&1; then
	if [ -b "$DISK" ]; then
		n=$(num shared)
		case $DISK in *[0-9]) pdev=${DISK}p$n ;; *) pdev=${DISK}$n ;; esac
		partprobe "$DISK" 2>/dev/null || blockdev --rereadpt "$DISK" 2>/dev/null || true
		[ -b "$pdev" ] && mkfs.exfat -L Shared "$pdev" > /dev/null || echo "shared: $pdev not formatted"
	else
		echo "shared: left empty (image file)"
	fi
else
	echo "shared: no mkfs.exfat, left empty"
fi

sfdisk -l "$DISK" | sed -n '/^Device/,$p'
