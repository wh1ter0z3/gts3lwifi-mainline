diff --git a/internal/qrtr/conn_linux.go b/internal/qrtr/conn_linux.go
new file mode 100644
index 0000000..27268af
--- /dev/null
+++ b/internal/qrtr/conn_linux.go
@@ -0,0 +1,191 @@
+// Copyright 2026 Jayden Milne <gnss-share@jayd.ml>
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//go:build linux
+// +build linux
+
+package qrtr
+
+import (
+	"fmt"
+	"os"
+	"sync/atomic"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// rawSockaddr is struct sockaddr_qrtr
+type rawSockaddr struct {
+	Family uint16
+	_      uint16
+	Node   uint32
+	Port   uint32
+}
+
+// writeTimeout bounds a send that QRTR flow control holds back
+const writeTimeout = 5 * time.Second
+
+// Conn is an AF_QIPCRTR datagram socket. It is non-blocking and registered
+// with Go's poller, so Close interrupts a blocked ReadFrom.
+type Conn struct {
+	f      *os.File
+	rc     syscall.RawConn
+	local  Addr
+	closed int32
+}
+
+// Open creates a socket bound to a free port of the local node
+func Open() (*Conn, error) {
+	fd, err := unix.Socket(unix.AF_QIPCRTR, unix.SOCK_DGRAM|unix.SOCK_NONBLOCK|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("qrtr: socket: %w", err)
+	}
+
+	// An unbound socket has the local node and port 0 as its address.
+	// Binding to port 0 picks a free port; until then the socket can't be
+	// read (EADDRNOTAVAIL).
+	sa, err := getsockname(uintptr(fd))
+	if err == nil {
+		sa.Port = 0
+		_, _, e := syscall.Syscall(unix.SYS_BIND, uintptr(fd),
+			uintptr(unsafe.Pointer(&sa)), unsafe.Sizeof(sa))
+		if e != 0 {
+			err = fmt.Errorf("qrtr: bind: %w", e)
+		} else {
+			sa, err = getsockname(uintptr(fd))
+		}
+	}
+	if err != nil {
+		unix.Close(fd)
+		return nil, err
+	}
+
+	f := os.NewFile(uintptr(fd), "qrtr")
+	rc, err := f.SyscallConn()
+	if err != nil {
+		f.Close()
+		return nil, fmt.Errorf("qrtr: %w", err)
+	}
+
+	return &Conn{f: f, rc: rc, local: Addr{Node: sa.Node, Port: sa.Port}}, nil
+}
+
+func getsockname(fd uintptr) (rawSockaddr, error) {
+	var sa rawSockaddr
+	l := uint32(unsafe.Sizeof(sa))
+	_, _, e := syscall.Syscall(unix.SYS_GETSOCKNAME, fd,
+		uintptr(unsafe.Pointer(&sa)), uintptr(unsafe.Pointer(&l)))
+	if e != 0 {
+		return sa, fmt.Errorf("qrtr: getsockname: %w", e)
+	}
+	return sa, nil
+}
+
+// LocalAddr returns the socket's node and port
+func (c *Conn) LocalAddr() Addr {
+	return c.local
+}
+
+// ReadFrom reads one datagram. It blocks until one arrives, the read
+// deadline passes or the socket is closed.
+func (c *Conn) ReadFrom(b []byte) (int, Addr, error) {
+	var (
+		n    int
+		from Addr
+		serr error
+	)
+	err := c.rc.Read(func(fd uintptr) bool {
+		var sa rawSockaddr
+		l := uint32(unsafe.Sizeof(sa))
+		var p unsafe.Pointer
+		if len(b) > 0 {
+			p = unsafe.Pointer(&b[0])
+		}
+		for {
+			r, _, e := syscall.Syscall6(unix.SYS_RECVFROM, fd, uintptr(p), uintptr(len(b)), 0,
+				uintptr(unsafe.Pointer(&sa)), uintptr(unsafe.Pointer(&l)))
+			switch e {
+			case syscall.EINTR:
+				continue
+			case syscall.EAGAIN:
+				return false
+			case 0:
+				n, from = int(r), Addr{Node: sa.Node, Port: sa.Port}
+			default:
+				serr = e
+			}
+			return true
+		}
+	})
+	if err != nil {
+		return 0, Addr{}, c.wrapErr(err)
+	}
+	if serr != nil {
+		return 0, Addr{}, fmt.Errorf("qrtr: recvfrom: %w", serr)
+	}
+	return n, from, nil
+}
+
+// WriteTo sends b as one datagram to the address to
+func (c *Conn) WriteTo(b []byte, to Addr) error {
+	sa := rawSockaddr{Family: unix.AF_QIPCRTR, Node: to.Node, Port: to.Port}
+	var p unsafe.Pointer
+	if len(b) > 0 {
+		p = unsafe.Pointer(&b[0])
+	}
+
+	if err := c.f.SetWriteDeadline(time.Now().Add(writeTimeout)); err != nil {
+		return fmt.Errorf("qrtr: %w", err)
+	}
+
+	var serr error
+	err := c.rc.Write(func(fd uintptr) bool {
+		for {
+			_, _, e := syscall.Syscall6(unix.SYS_SENDTO, fd, uintptr(p), uintptr(len(b)), 0,
+				uintptr(unsafe.Pointer(&sa)), unsafe.Sizeof(sa))
+			switch e {
+			case syscall.EINTR:
+				continue
+			case syscall.EAGAIN:
+				return false
+			case 0:
+			default:
+				serr = e
+			}
+			return true
+		}
+	})
+	if err != nil {
+		return fmt.Errorf("qrtr: sendto: %w", c.wrapErr(err))
+	}
+	if serr != nil {
+		return fmt.Errorf("qrtr: sendto %d:%d: %w", to.Node, to.Port, serr)
+	}
+
+	return nil
+}
+
+// SetReadDeadline sets the deadline for ReadFrom
+func (c *Conn) SetReadDeadline(t time.Time) error {
+	return c.f.SetReadDeadline(t)
+}
+
+// Close closes the socket. The kernel tells every node that the port is
+// gone (DEL_CLIENT), so remote services drop the client's state, and the
+// name service drops the socket's lookups.
+func (c *Conn) Close() error {
+	atomic.StoreInt32(&c.closed, 1)
+	return c.f.Close()
+}
+
+// wrapErr turns the poller's error for a closed file into os.ErrClosed, as
+// os.File's own methods do
+func (c *Conn) wrapErr(err error) error {
+	if atomic.LoadInt32(&c.closed) != 0 {
+		return os.ErrClosed
+	}
+	return err
+}
diff --git a/internal/qrtr/conn_linux_test.go b/internal/qrtr/conn_linux_test.go
new file mode 100644
index 0000000..79d1679
--- /dev/null
+++ b/internal/qrtr/conn_linux_test.go
@@ -0,0 +1,117 @@
+// Copyright 2026 Jayden Milne <gnss-share@jayd.ml>
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//go:build linux
+// +build linux
+
+package qrtr
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"testing"
+	"time"
+)
+
+// A service number no remote processor offers, so the test never talks to
+// a real one
+const testService = 0x7f00
+
+func openOrSkip(t *testing.T) *Conn {
+	t.Helper()
+	c, err := Open()
+	if err != nil {
+		t.Skipf("no AF_QIPCRTR sockets here: %s", err)
+	}
+	return c
+}
+
+func readCtrl(t *testing.T, c *Conn) Ctrl {
+	t.Helper()
+	buf := make([]byte, 64)
+	if err := c.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	n, from, err := c.ReadFrom(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if from != (Addr{Node: c.LocalAddr().Node, Port: PortCtrl}) {
+		t.Fatalf("control packet from %+v", from)
+	}
+	ctrl, err := ParseCtrl(buf[:n])
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ctrl
+}
+
+// Publish a service on one socket, find it from another through the
+// kernel's name service, exchange datagrams, and see it go away when its
+// socket closes.
+func TestConnNameServiceRoundTrip(t *testing.T) {
+	client := openOrSkip(t)
+	defer client.Close()
+	server := openOrSkip(t)
+	defer server.Close()
+
+	if err := server.WriteTo(NewServer(testService, 1), Addr{Node: server.LocalAddr().Node, Port: PortCtrl}); err != nil {
+		t.Fatal(err)
+	}
+	if server.LocalAddr().Port == 0 {
+		t.Fatal("no port after the first send")
+	}
+	if err := Lookup(client, testService, 0); err != nil {
+		t.Fatal(err)
+	}
+
+	c := readCtrl(t, client)
+	want := Server{Service: testService, Instance: 1, Addr: server.LocalAddr()}
+	if c.Cmd != TypeNewServer || c.Server != want {
+		t.Fatalf("got %+v, want NEW_SERVER %+v", c, want)
+	}
+	if c = readCtrl(t, client); !c.EndOfListing() {
+		t.Fatalf("got %+v, want the end of the listing", c)
+	}
+
+	msg := []byte("hello")
+	if err := client.WriteTo(msg, want.Addr); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 64)
+	if err := server.SetReadDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	n, from, err := server.ReadFrom(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(buf[:n], msg) || from != client.LocalAddr() {
+		t.Fatalf("got %q from %+v, want %q from %+v", buf[:n], from, msg, client.LocalAddr())
+	}
+
+	server.Close()
+	if c = readCtrl(t, client); c.Cmd != TypeDelServer || c.Server != want {
+		t.Fatalf("got %+v, want DEL_SERVER %+v", c, want)
+	}
+}
+
+func TestConnCloseEndsRead(t *testing.T) {
+	c := openOrSkip(t)
+	errc := make(chan error, 1)
+	go func() {
+		_, _, err := c.ReadFrom(make([]byte, 16))
+		errc <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	c.Close()
+	select {
+	case err := <-errc:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Errorf("got %v, want os.ErrClosed", err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("ReadFrom still blocked after Close")
+	}
+}
