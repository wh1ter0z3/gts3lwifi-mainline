+
+//go:build !linux
+// +build !linux
+
+package qrtr
+
+import "errors"
+
+// Conn is an AF_QIPCRTR socket, which only Linux has
+type Conn struct{}
+
+// Open fails: QRTR sockets are Linux only
+func Open() (*Conn, error) {
+	return nil, errors.New("qrtr: not supported on this system")
+}
+
+func (c *Conn) ReadFrom(b []byte) (int, Addr, error) { return 0, Addr{}, errors.New("qrtr: closed") }
+func (c *Conn) WriteTo(b []byte, to Addr) error      { return errors.New("qrtr: closed") }
+func (c *Conn) LocalAddr() Addr                      { return Addr{} }
+func (c *Conn) Close() error                         { return nil }
diff --git a/internal/qrtr/qrtr.go b/internal/qrtr/qrtr.go
new file mode 100644
index 0000000..fa44380
--- /dev/null
+++ b/internal/qrtr/qrtr.go
@@ -0,0 +1,132 @@
+// Copyright 2026 Jayden Milne <gnss-share@jayd.ml>
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Package qrtr talks to services on Qualcomm remote processors (modem,
+// audio and sensor DSPs) over AF_QIPCRTR datagram sockets, and to the QRTR
+// name service that lists those services.
+//
+// The constants and the control packet layout are those of Linux's
+// include/uapi/linux/qrtr.h. The name service is the kernel's
+// (net/qrtr/ns.c): it answers a NEW_LOOKUP with one NEW_SERVER packet per
+// matching service and an empty NEW_SERVER that ends the listing, and keeps
+// the lookup open until the socket is closed. Later NEW_SERVER and
+// DEL_SERVER packets report services that appear and disappear, e.g. when a
+// remote processor boots, crashes or is stopped.
+package qrtr
+
+import (
+	"encoding/binary"
+	"errors"
+)
+
+const (
+	// NodeBroadcast is QRTR_NODE_BCAST
+	NodeBroadcast uint32 = 0xffffffff
+	// PortCtrl is QRTR_PORT_CTRL, the port of the name service
+	PortCtrl uint32 = 0xfffffffe
+)
+
+// Control packet types (enum qrtr_pkt_type)
+const (
+	TypeNewServer uint32 = 4
+	TypeDelServer uint32 = 5
+	TypeNewLookup uint32 = 10
+	TypeDelLookup uint32 = 11
+)
+
+// Addr is a QRTR address (struct sockaddr_qrtr without the family)
+type Addr struct {
+	Node uint32
+	Port uint32
+}
+
+// Server is a service as the name service reports it
+type Server struct {
+	Service uint32
+	// Instance is the QMI service version in bits 0-7 and the instance ID
+	// above them
+	Instance uint32
+	Addr     Addr
+}
+
+// Version returns the QMI service version of s
+func (s Server) Version() uint32 {
+	return s.Instance & 0xff
+}
+
+// Ctrl is a decoded control packet (struct qrtr_ctrl_pkt, server variant)
+type Ctrl struct {
+	Cmd    uint32
+	Server Server
+}
+
+// EndOfListing reports whether c is the empty NEW_SERVER packet that ends
+// the name service's answer to a lookup
+func (c Ctrl) EndOfListing() bool {
+	return c.Cmd == TypeNewServer && c.Server == (Server{})
+}
+
+// ctrlLen is sizeof(struct qrtr_ctrl_pkt): a le32 command and four le32
+// fields
+const ctrlLen = 20
+
+var errShortCtrl = errors.New("qrtr: control packet too short")
+
+// NewLookup returns the control packet that asks the name service for the
+// servers of service and instance, and to report changes to them. Zero
+// matches any service or instance.
+func NewLookup(service, instance uint32) []byte {
+	b := make([]byte, ctrlLen)
+	binary.LittleEndian.PutUint32(b[0:], TypeNewLookup)
+	binary.LittleEndian.PutUint32(b[4:], service)
+	binary.LittleEndian.PutUint32(b[8:], instance)
+	return b
+}
+
+// NewServer returns the control packet that publishes a service on the
+// sending socket. The name service takes the node and port of a local
+// server from the socket, not from the packet.
+func NewServer(service, instance uint32) []byte {
+	b := make([]byte, ctrlLen)
+	binary.LittleEndian.PutUint32(b[0:], TypeNewServer)
+	binary.LittleEndian.PutUint32(b[4:], service)
+	binary.LittleEndian.PutUint32(b[8:], instance)
+	return b
+}
+
+// ParseCtrl decodes a control packet
+func ParseCtrl(b []byte) (Ctrl, error) {
+	if len(b) < ctrlLen {
+		return Ctrl{}, errShortCtrl
+	}
+	le := binary.LittleEndian
+	return Ctrl{
+		Cmd: le.Uint32(b[0:]),
+		Server: Server{
+			Service:  le.Uint32(b[4:]),
+			Instance: le.Uint32(b[8:]),
+			Addr: Addr{
+				Node: le.Uint32(b[12:]),
+				Port: le.Uint32(b[16:]),
+			},
+		},
+	}, nil
+}
+
+// Socket is the part of Conn that users need; tests can replace it
+type Socket interface {
+	// ReadFrom reads one datagram into b and returns its length and source
+	ReadFrom(b []byte) (int, Addr, error)
+	// WriteTo sends b as one datagram to the address to
+	WriteTo(b []byte, to Addr) error
+	// LocalAddr returns the socket's address; the node is the local node,
+	// where the name service runs
+	LocalAddr() Addr
+	Close() error
+}
+
+// Lookup sends a NEW_LOOKUP for service and instance to the name service of
+// the local node. The answers arrive on s from Addr{local node, PortCtrl}.
+func Lookup(s Socket, service, instance uint32) error {
+	return s.WriteTo(NewLookup(service, instance), Addr{Node: s.LocalAddr().Node, Port: PortCtrl})
+}
diff --git a/internal/qrtr/qrtr_test.go b/internal/qrtr/qrtr_test.go
new file mode 100644
index 0000000..80b53b2
--- /dev/null
+++ b/internal/qrtr/qrtr_test.go
@@ -0,0 +1,88 @@
+// Copyright 2026 Jayden Milne <gnss-share@jayd.ml>
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package qrtr
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestNewLookup(t *testing.T) {
+	want := []byte{
+		10, 0, 0, 0, // QRTR_TYPE_NEW_LOOKUP
+		0x10, 0, 0, 0, // service
+		2, 0, 0, 0, // instance
+		0, 0, 0, 0,
+		0, 0, 0, 0,
+	}
+	if got := NewLookup(0x10, 2); !bytes.Equal(got, want) {
+		t.Errorf("NewLookup: got % x, want % x", got, want)
+	}
+}
+
+func TestParseCtrl(t *testing.T) {
+	b := []byte{
+		4, 0, 0, 0, // QRTR_TYPE_NEW_SERVER
+		0x10, 0, 0, 0,
+		0x02, 0x01, 0, 0, // version 2, instance 1
+		3, 0, 0, 0,
+		0x26, 0, 0, 0,
+	}
+	c, err := ParseCtrl(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := Ctrl{Cmd: TypeNewServer, Server: Server{Service: 0x10, Instance: 0x102, Addr: Addr{Node: 3, Port: 0x26}}}
+	if c != want {
+		t.Errorf("got %+v, want %+v", c, want)
+	}
+	if c.Server.Version() != 2 {
+		t.Errorf("version %d, want 2", c.Server.Version())
+	}
+	if c.EndOfListing() {
+		t.Error("a server is not the end of the listing")
+	}
+
+	end, err := ParseCtrl(make([]byte, ctrlLen))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if end.EndOfListing() {
+		t.Error("command 0 is not the end of the listing")
+	}
+	end.Cmd = TypeNewServer
+	if !end.EndOfListing() {
+		t.Error("an empty NEW_SERVER is the end of the listing")
+	}
+
+	if _, err := ParseCtrl(b[:ctrlLen-1]); err == nil {
+		t.Error("short packet accepted")
+	}
+}
+
+type recordSocket struct {
+	to  Addr
+	buf []byte
+}
+
+func (r *recordSocket) ReadFrom(b []byte) (int, Addr, error) { return 0, Addr{}, nil }
+func (r *recordSocket) WriteTo(b []byte, to Addr) error {
+	r.to, r.buf = to, append([]byte{}, b...)
+	return nil
+}
+func (r *recordSocket) LocalAddr() Addr { return Addr{Node: 7, Port: 0x4001} }
+func (r *recordSocket) Close() error    { return nil }
+
+func TestLookupGoesToLocalNameService(t *testing.T) {
+	r := &recordSocket{}
+	if err := Lookup(r, 0x10, 0); err != nil {
+		t.Fatal(err)
+	}
+	if r.to != (Addr{Node: 7, Port: PortCtrl}) {
+		t.Errorf("lookup sent to %+v", r.to)
+	}
+	if !bytes.Equal(r.buf, NewLookup(0x10, 0)) {
+		t.Errorf("lookup packet % x", r.buf)
+	}
+}
