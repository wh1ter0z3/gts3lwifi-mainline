+func TestSystemClockBounds(t *testing.T) {
+	_, unc, ok := systemClock()
+	if ok && (unc < qmiLocMinUncertainty || unc >= ntpPhaseLimit) {
+		t.Errorf("uncertainty %s out of bounds", unc)
+	}
