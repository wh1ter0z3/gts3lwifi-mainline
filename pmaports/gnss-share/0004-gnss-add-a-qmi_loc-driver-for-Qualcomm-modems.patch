+func TestQmiLocStartFailsThenRetries(t *testing.T) {
+	h := newHarness(t, true)
+	h.ctrl(qrtr.TypeNewServer, qmiLocService, 2, testLoc)
+
+	reg := h.request(qmiLocRegisterEvents, testLoc)
+	h.respond(reg, testLoc, 0, 0)
+	mode := h.request(qmiLocSetOperationMode, testLoc)
+	h.respond(mode, testLoc, 1, 0x1e) // not supported: start anyway
+	start := h.request(qmiLocStart, testLoc)
+	h.respond(start, testLoc, 1, 0x1a)
+
+	// After the retry delay the whole setup runs again
+	h.setUp(testLoc)
+	h.expectTimeInjection(testLoc)
+	h.stopAndExpectStop(testLoc)
+}
