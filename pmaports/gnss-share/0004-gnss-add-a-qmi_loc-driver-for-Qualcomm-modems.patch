+	h.setUp(testLoc)
+	h.expectTimeInjection(testLoc)
+
+	// No indication after the mode response: START follows anyway
+	h.ctrl(qrtr.TypeDelServer, qmiLocService, 2, testLoc)
+	h.ctrl(qrtr.TypeNewServer, qmiLocService, 2, testLoc)
+	reg := h.request(qmiLocRegisterEvents, testLoc)
+	h.respond(reg, testLoc, 0, 0)
+	mode := h.request(qmiLocSetOperationMode, testLoc)
+	h.respond(mode, testLoc, 0, 0)
+	start := h.request(qmiLocStart, testLoc)
+	h.respond(start, testLoc, 0, 0)
+	h.expectTimeInjection(testLoc)
+
+	// No answer to STOP: the socket closes anyway
+	close(h.stop)
+	h.request(qmiLocStop, testLoc)
+	h.expectClosed()
+}
