+
+//go:build linux
+// +build linux
+
+package gnss
+
+import (
+	"syscall"
+	"time"
+)
+
+// clockMaxError returns the kernel's maximum error estimate for the system
+// clock (struct timex maxerror, read with adjtimex() without changing
+// anything)
+func clockMaxError() (time.Duration, error) {
+	var tx syscall.Timex
+	if _, err := syscall.Adjtimex(&tx); err != nil {
+		return 0, err
+	}
+	return time.Duration(tx.Maxerror) * time.Microsecond, nil
+}
