+func TestNmeaSentences(t *testing.T) {
+	tables := []struct {
+		in, want string
+	}{
+		{"", ""},
+		{"\x00", ""},
+		{"$GPGGA,1*00", "$GPGGA,1*00\r\n"},
+		{"$GPGGA,1*00\r\n\x00garbage", "$GPGGA,1*00\r\n"},
+		{"$GPGSV,1*00\n$GLGSV,2*00\r\n", "$GPGSV,1*00\r\n$GLGSV,2*00\r\n"},
+		{"\r\n  $GPRMC,3*00  \r\n", "$GPRMC,3*00\r\n"},
+		{"!AIVDM,4*00", "!AIVDM,4*00\r\n"},
+		{"not nmea\n$GPVTG,5*00", "$GPVTG,5*00\r\n"},
+	}
+	for _, table := range tables {
+		if got := string(nmeaSentences([]byte(table.in))); got != table.want {
+			t.Errorf("%q: got %q, want %q", table.in, got, table.want)
+		}
+	}
+}
