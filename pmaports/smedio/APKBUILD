# Maintainer: psigod <psigod@example.com>
pkgname=smedio
pkgver=3.5.3
pkgrel=0
_commit="9329ee002fac13c508862a1c2dffcaea673742ab"
pkgdesc="YouTube and live TV, ad-free and hardware-decoded (VA-API, V4L2 video decoders)"
url="https://github.com/wh1ter0z3/smedio"
arch="noarch"
license="MIT"
# yt-dlp brings Deno and yt-dlp-ejs (what it needs for YouTube); ffmpeg is for downloads
depends="
	ffmpeg
	gtk4.0
	libadwaita
	py3-gobject3
	py3-mpv
	python3
	yt-dlp
	"
makedepends="python3"
options="!check" # no test suite
source="$pkgname-$_commit.tar.gz::https://github.com/wh1ter0z3/smedio/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"

package() {
	install -Dm644 smedio.py "$pkgdir"/usr/share/smedio/smedio.py
	python3 -m compileall -q -d /usr/share/smedio "$pkgdir"/usr/share/smedio

	# Started as a module (import smedio), so its helper processes import it by name
	mkdir -p "$pkgdir"/usr/bin
	cat >"$pkgdir"/usr/bin/smedio <<-'EOS'
	#!/bin/sh
	exec python3 -c 'import sys; sys.path.insert(0, "/usr/share/smedio"); import smedio; smedio.main()' "$@"
	EOS
	chmod 755 "$pkgdir"/usr/bin/smedio

	install -Dm644 dev.smedio.Smedio.desktop -t "$pkgdir"/usr/share/applications
	install -Dm644 dev.smedio.Smedio.svg -t "$pkgdir"/usr/share/icons/hicolor/scalable/apps
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
sha512sums="
cc50ac913dc1af26d4f6358783b8b51f082e9364d6abe3514c362be679f8eadb85b55aab90d25e61645e277d5dc450d020312f6cee9160dc1d03c96c9afaf016  smedio-9329ee002fac13c508862a1c2dffcaea673742ab.tar.gz
"
