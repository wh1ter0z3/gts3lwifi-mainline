#!/bin/sh
# Choose the operating system lk2nd boots: the default label of extlinux.conf
# on the boot partition. Works in Nura (/boot) and in Android (mounts the
# partition labelled pmOS_boot itself; needs root and busybox).
#
#   gts3-boot                  list the labels, * marks the default
#   gts3-boot <label>          boot <label> from now on
#   gts3-boot <label> reboot   ... and reboot into it now
set -eu

conf=/boot/extlinux/extlinux.conf
mnt=
cleanup() { [ -z "$mnt" ] || { umount "$mnt"; rmdir "$mnt"; }; }
trap cleanup EXIT

# the partition labelled pmOS_boot, if the kernel has it as a device
find_boot() {
	d=$(findfs LABEL=pmOS_boot 2>/dev/null) || d=$(blkid -L pmOS_boot 2>/dev/null) || d=
	[ -b "$d" ] && echo "$d"
}

if [ ! -f "$conf" ]; then
	dev=$(find_boot) || dev=
	if [ -z "$dev" ]; then
		# the layout's GPT on the userdata partition isn't attached (Android
		# from another disk): attach it to see its partitions
		ud=$(readlink -f /dev/block/by-name/userdata 2>/dev/null || readlink -f /dev/disk/by-partlabel/userdata 2>/dev/null) || ud=
		# (Android: toybox's losetup has no -P, and busybox's looks for free
		# devices in /dev, not /dev/block: toybox names one, busybox attaches)
		if [ -b "$ud" ]; then
			losetup -f -P "$ud" 2>/dev/null || {
				lo=$(losetup -f 2>/dev/null) || lo=
				[ -b "$lo" ] && busybox losetup -P "$lo" "$ud"
			}
			sleep 1
		fi
		dev=$(find_boot) || dev=
	fi
	[ -n "$dev" ] || { echo "no partition labelled pmOS_boot" >&2; exit 1; }
	mnt=$(mktemp -d)
	mount -t ext2 "$dev" "$mnt"
	conf=$mnt/extlinux/extlinux.conf
fi

labels=$(sed -n 's/^[[:space:]]*label[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' "$conf")
default=$(sed -n 's/^[[:space:]]*default[[:space:]]\{1,\}\([^[:space:]]*\).*/\1/p' "$conf" | tail -n 1)

if [ $# -eq 0 ]; then
	for l in $labels; do
		[ "$l" = "$default" ] && echo "* $l" || echo "  $l"
	done
	exit 0
fi

echo "$labels" | grep -qx "$1" || { echo "no label '$1' in $conf" >&2; exit 1; }
if [ "$1" != "$default" ]; then
	# Write a copy and rename it, so a crash leaves the old or the new file.
	sed "s/^\([[:space:]]*default[[:space:]]\{1,\}\).*/\1$1/" "$conf" > "$conf.new"
	grep -q "^[[:space:]]*default[[:space:]]" "$conf.new" || echo "default $1" >> "$conf.new"
	sync "$conf.new" 2>/dev/null || sync
	mv "$conf.new" "$conf"
	sync
fi
echo "lk2nd boots $1"

if [ "${2:-}" = reboot ]; then
	cleanup
	mnt=
	# With LineageOS lk2nd lives in the recovery partition (docs/partitions.md):
	# a plain reboot would start LineageOS, so restart through the recovery path
	how=
	for b in /dev/disk/by-partlabel/boot /dev/block/by-name/boot /dev/block/bootdevice/by-name/boot; do
		[ -b "$b" ] || continue
		head -c 4194304 "$b" | grep -a -q lk2nd || how=recovery
		break
	done
	if command -v setprop >/dev/null 2>&1 && [ -n "$(getprop sys.boot_completed 2>/dev/null)" ]; then
		setprop sys.powerctl "reboot${how:+,$how}"
	elif [ -n "$how" ] && command -v systemctl >/dev/null 2>&1; then
		systemctl reboot --reboot-argument="$how"
	else
		reboot ${how:+"$how"}
	fi
fi
