#!/bin/sh
# Copy what this tablet needs but nobody may redistribute from its own
# partitions into /lib/firmware/updates (searched before /lib/firmware):
#  - apnhlos: Samsung-signed GPU zap shader, Venus and SLPI (sensor core)
#    firmware
#  - modem: Samsung-signed ADSP (audio DSP) firmware, and the modem DSP's
#    (MSS: GNSS, on the SM-T825 also LTE) MBA and modem images with the
#    modem_pr configuration tree it fetches over QRTR TFTP (tqftpserv).
#    Used once rmtfs starts the modem (device-samsung-gts3lwifi-gnss); copied
#    only where the device tree enables the MSS (both models' main DTs)
#  - system (Android): the Wi-Fi board data, etc/firmware/bdwlan30.bin ->
#    ath10k board.bin. apnhlos has a bdwlan30.bin too, but a different one;
#    Wi-Fi was brought up with this one (docs/wifi.md)
#  - efs: the sensor registry with this unit's factory calibration
#  - apnhlos: the Samsung-signed TrustZone apps that /dev/qseecom clients
#    (keymaster, the fingerprint HAL, DRM) load by name from
#    qcom/msm8996/samsung/gts3/tz/; cmnlib first, then the app
# Only missing or changed files are written. Remote processors that could
# not start for lack of firmware are started afterwards, except the modem
# DSP, which rmtfs starts once it serves the modem's file system; Wi-Fi
# picks up its board data on the next boot.
set -eu

DEST=/lib/firmware/updates
FW=$DEST/qcom/msm8996/samsung/gts3
# qcom_sns_reg looks for sns.reg-<first root compatible>: samsung,gts3lwifi
# on the SM-T820, samsung,gts3llte on the SM-T825
model=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n1)
tmp=$(mktemp -d)
changed=0

cleanup() {
	for m in "$tmp"/*; do
		[ -d "$m" ] && umount "$m" 2>/dev/null || true
	done
	rm -rf "$tmp"
}
trap cleanup EXIT

mount_part() {
	dev=/dev/disk/by-partlabel/$1
	[ -e "$dev" ] || { echo "gts3-firmware: no $1 partition" >&2; return 1; }
	mkdir -p "$tmp/$1"
	mount -o ro "$dev" "$tmp/$1"
}

copy() {
	[ -f "$1" ] || return 0
	if [ ! -f "$2" ] || ! cmp -s "$1" "$2"; then
		install -Dm644 "$1" "$2"
		echo "gts3-firmware: installed $2"
		changed=1
	fi
}

if mount_part apnhlos; then
	for f in "$tmp"/apnhlos/image/a530_zap.* "$tmp"/apnhlos/image/venus.* \
		 "$tmp"/apnhlos/image/slpi.*; do
		copy "$f" "$FW/${f##*/}"
	done
	# TrustZone apps: libraries, keymaster, fingerprint (dualfp + authhat),
	# Widevine. Not fingerpr (20 MiB, unused by the fingerprint HAL)
	for a in cmnlib cmnlib64 skeymast dualfp authhat widevine; do
		for f in "$tmp"/apnhlos/image/$a.*; do
			copy "$f" "$FW/tz/${f##*/}"
		done
	done
fi

if mount_part modem; then
	for f in "$tmp"/modem/image/adsp.*; do
		copy "$f" "$FW/${f##*/}"
	done
	if [ -e /sys/bus/platform/devices/2080000.remoteproc ]; then
		for f in "$tmp"/modem/image/mba.mbn "$tmp"/modem/image/modem.*; do
			copy "$f" "$FW/${f##*/}"
		done
		# Paths have no spaces (mcfg_hw/.../7+5_mode/...)
		for f in $(cd "$tmp/modem/image" && find modem_pr -type f 2>/dev/null); do
			copy "$tmp/modem/image/$f" "$FW/$f"
		done
	fi
fi

if mount_part system; then
	for f in "$tmp/system/etc/firmware/bdwlan30.bin" \
		 "$tmp/system/system/etc/firmware/bdwlan30.bin"; do
		copy "$f" "$DEST/ath10k/QCA6174/hw3.0/board.bin"
	done
fi

if mount_part efs; then
	copy "$tmp/efs/FactoryApp/sensors/sns.reg" \
		"$DEST/qcom/sensors/sns.reg-${model:-samsung,gts3lwifi}"
fi

[ "$changed" = 1 ] || exit 0

for r in /sys/class/remoteproc/remoteproc*; do
	[ -e "$r/state" ] || continue
	case "$(readlink "$r/device/driver" 2>/dev/null)" in
	*/qcom-q6v5-mss) continue ;;
	esac
	if [ "$(cat "$r/state")" = offline ]; then
		echo start > "$r/state" || echo "gts3-firmware: could not start $(cat "$r/name")" >&2
	fi
done
