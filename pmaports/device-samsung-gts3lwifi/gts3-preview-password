#!/bin/sh
# Preview image: does "user" still have the password printed in the install
# guide? The image build records its hash; this compares it with /etc/shadow and
# leaves /run/gts3-default-password for gts3-first-login to find.
set -eu

FLAG=/run/gts3-default-password
HASH=/etc/gts3-preview/default-password-hash

rm -f "$FLAG"
[ -s "$HASH" ] || exit 0
if awk -F: -v h="$(cat "$HASH")" '$1 == "user" && $2 == h { f = 1 } END { exit !f }' /etc/shadow; then
	: > "$FLAG"
	chmod 644 "$FLAG"
fi
