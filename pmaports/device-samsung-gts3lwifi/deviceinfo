# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab S3 (SM-T820, SM-T825)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gts3lwifi"
deviceinfo_year="2017"
# Both models (apq8096-samsung-gts3lwifi, msm8996-samsung-gts3llte), appended;
# lk2nd picks the one whose qcom,msm-id and board-id match the tablet. One
# wildcard rather than two names: boot-deploy's boot.img step looks the
# value up as a single DTB and fails on a list
deviceinfo_dtb="qcom/*-samsung-gts3l*"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_screen_width="2048"
deviceinfo_screen_height="1536"

# Bootloader related
# Booted by lk2nd installed in the "boot" partition; the pmOS boot image is
# flashed through lk2nd's fastboot. Load addresses are the ones the stock
# Samsung boot.img (and the lk2nd image itself) are packed with.
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_kernel_cmdline="console=tty0 sysctl.kernel.firmware_config.ignore_sysfs_fallback=1"
deviceinfo_flash_offset_base="0x80000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02200000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x02000000"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_sparse="true"

# Samsung Electronics Co., Ltd
deviceinfo_usb_idVendor="0x04e8"
# Galaxy series USB tethering. Not the stock MTP ID (0x6860): with that,
# desktops take the USB network link for an MTP phone and fail to open it.
deviceinfo_usb_idProduct="0x6863"
