# Reference: <https://postmarketos.org/devicepkg>
maintainer="psigod <psigod@example.com>"
pkgname=device-samsung-gts3lwifi
pkgdesc="Samsung Galaxy Tab S3 (SM-T820, SM-T825)"
pkgver=1
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	$pkgname-gnss
	bluez-btmgmt
	iio-sensor-proxy
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	linux-postmarketos-qcom-msm8996
	mkbootimg
	postmarketos-base
	soc-qcom-msm8996
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-openrc $pkgname-waydroid:_waydroid $pkgname-gnss:_gnss"
source="
	deviceinfo
	modules-load.conf
	gts3-bdaddr
	gts3-bdaddr.initd
	gts3-firmware
	gts3-firmware.initd
	gts3-firmware.service
	gts3-bdaddr.service
	90-gts3-bdaddr.rules
	61-gts3-accel.rules
	61-gts3-keys.hwdb
	61-gts3-keys.rules
	gts3-kglobalshortcutsrc
	modules-initfs
	51-gts3lwifi-audio.conf
	ucm2-gts3lwifi.conf
	ucm2-gts3lwifi-HiFi.conf
	waydroid-firewall.nft
	gts3-waydroid-session
	waydroid-fullscreen.desktop
	gnss-share-qmi-loc.conf
	gts3-gnss-gnss-share.conf
	gts3-gnss-rmtfs.conf
	gts3-gnss-tqftpserv.conf
	90-gts3-gnss.rules
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Bluetooth address from the efs partition (see gts3-bdaddr)
	install -Dm755 "$srcdir"/gts3-bdaddr "$pkgdir"/usr/sbin/gts3-bdaddr
	install -Dm644 "$srcdir"/gts3-bdaddr.service \
		"$pkgdir"/usr/lib/systemd/system/gts3-bdaddr.service
	install -Dm644 "$srcdir"/90-gts3-bdaddr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-gts3-bdaddr.rules

	# Accelerometer orientation for auto-rotate (see the rule)
	install -Dm644 "$srcdir"/61-gts3-accel.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-gts3-accel.rules

	# Home opens the launcher, Recent shows the windows, the key lights time out.
	# KWin binds Present Windows to Launch (C), which no key produces, and the
	# file below only reaches users created after this is installed.
	install -Dm644 "$srcdir"/61-gts3-keys.hwdb \
		"$pkgdir"/usr/lib/udev/hwdb.d/61-gts3-keys.hwdb
	install -Dm644 "$srcdir"/61-gts3-keys.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-gts3-keys.rules
	install -Dm644 "$srcdir"/gts3-kglobalshortcutsrc \
		"$pkgdir"/etc/skel/.config/kglobalshortcutsrc

	# Samsung-signed firmware, Wi-Fi board data and the sensor registry
	# from the tablet's own partitions (see gts3-firmware)
	install -Dm755 "$srcdir"/gts3-firmware "$pkgdir"/usr/sbin/gts3-firmware
	install -Dm644 "$srcdir"/gts3-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/gts3-firmware.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../gts3-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/gts3-firmware.service

	# Audio: ALSA UCM profile and WirePlumber tuning (see docs/audio.md)
	install -Dm644 "$srcdir"/51-gts3lwifi-audio.conf \
		-t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d
	install -Dm644 "$srcdir"/ucm2-gts3lwifi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gts3lwifi/gts3lwifi.conf
	install -Dm644 "$srcdir"/ucm2-gts3lwifi-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gts3lwifi/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096
	ln -s ../../Samsung/gts3lwifi/gts3lwifi.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/Galaxy Tab S3.conf"
}

_waydroid() {
	pkgdesc="Waydroid (Android 13) on the Galaxy Tab S3: firewall rule and a full-screen Android session"
	depends="cage waydroid"
	install="$subpkgname.post-install"

	# pmOS drops input and forwarding on waydroid0 by default
	install -Dm644 "$srcdir"/waydroid-firewall.nft \
		"$subpkgdir"/etc/nftables.d/52_waydroid.nft
	# "Android (Waydroid)" on the login screen: Android full screen in cage
	install -Dm755 "$srcdir"/gts3-waydroid-session \
		"$subpkgdir"/usr/bin/gts3-waydroid-session
	install -Dm644 "$srcdir"/waydroid-fullscreen.desktop \
		"$subpkgdir"/usr/share/wayland-sessions/waydroid-fullscreen.desktop
}

_gnss() {
	pkgdesc="GNSS (GPS) on the Galaxy Tab S3 for geoclue: the modem DSP's services and gnss-share's qmi_loc driver"
	# gnss-share with the qmi_loc driver is pmaports/gnss-share
	depends="geoclue gnss-share>=99990.8.2 rmtfs tqftpserv"

	# Only with a device tree that enables the modem DSP (MSS): rmtfs
	# (boots the modem) once its remoteproc exists, tqftpserv before it,
	# gnss-share with the qmi_loc driver; see the drop-ins and docs/gnss.md
	install -Dm644 "$srcdir"/gts3-gnss-rmtfs.conf \
		"$subpkgdir"/usr/lib/systemd/system/rmtfs.service.d/gts3-gnss.conf
	install -Dm644 "$srcdir"/gts3-gnss-tqftpserv.conf \
		"$subpkgdir"/usr/lib/systemd/system/tqftpserv.service.d/gts3-gnss.conf
	install -Dm644 "$srcdir"/gts3-gnss-gnss-share.conf \
		"$subpkgdir"/usr/lib/systemd/system/gnss-share.service.d/gts3-gnss.conf
	install -Dm644 "$srcdir"/90-gts3-gnss.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-gts3-gnss.rules
	install -Dm644 "$srcdir"/gnss-share-qmi-loc.conf \
		"$subpkgdir"/etc/gnss-share-qmi-loc.conf
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../gnss-share.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/gnss-share.service
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	install -Dm755 "$srcdir"/gts3-bdaddr.initd "$subpkgdir"/etc/init.d/gts3-bdaddr
	install -Dm755 "$srcdir"/gts3-firmware.initd "$subpkgdir"/etc/init.d/gts3-firmware
}

