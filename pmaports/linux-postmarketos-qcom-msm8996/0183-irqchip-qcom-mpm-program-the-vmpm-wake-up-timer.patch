From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Mon, 9 Nov 2026 15:19:24 +0530
Subject: [PATCH] irqchip/qcom-mpm: Program the vMPM wake-up timer

The RPM wakes the AP from a power collapse it was told about either at
the time in the vMPM timer or on an enabled MPM pin, but the driver
never writes the timer, so the RPM gets whatever is there. On MSM8996 a
suspend with XO released never woke up.

Write the earliest next timer of the CPU domains below the MPM domain,
as their governor computed it, as an absolute physical arch counter
value, or all ones (no timer) during suspend-to-idle, where only
wake-up interrupts end the sleep. The downstream MPM driver does the
same (msm_mpm_enter_sleep()).

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/irqchip/irq-qcom-mpm.c | 42 ++++++++++++++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/drivers/irqchip/irq-qcom-mpm.c b/drivers/irqchip/irq-qcom-mpm.c
index 8c575d7ce8..04e6dff643 100644
--- a/drivers/irqchip/irq-qcom-mpm.c
+++ b/drivers/irqchip/irq-qcom-mpm.c
@@ -21,6 +21,9 @@
 #include <linux/slab.h>
 #include <linux/soc/qcom/irq.h>
 #include <linux/spinlock.h>
+#include <linux/suspend.h>
+
+#include <clocksource/arm_arch_timer.h>
 
 /*
  * This is the driver for Qualcomm MPM (MSM Power Manager) interrupt controller,
@@ -292,6 +295,43 @@ static irqreturn_t qcom_mpm_handler(int irq, void *dev_id)
 	return ret;
 }
 
+/*
+ * The RPM wakes the AP at the time in the vMPM timer (an absolute value of
+ * the physical arch counter) or on an enabled MPM pin. Without a time it
+ * may keep the AP asleep: write the earliest timer of the CPU domains below
+ * this one, as computed by their governor, or "no timer" (all ones) during
+ * suspend-to-idle, where only wake-up interrupts end the sleep, as the
+ * downstream MPM driver does.
+ */
+static void mpm_write_wakeup(struct qcom_mpm_priv *priv,
+			     struct generic_pm_domain *genpd)
+{
+	u64 wakeup = U64_MAX;
+	ktime_t next = KTIME_MAX;
+	struct gpd_link *link;
+
+	if (!idle_should_enter_s2idle()) {
+		list_for_each_entry(link, &genpd->parent_links, parent_node) {
+			struct generic_pm_domain *child = link->child;
+
+			if (child->gd && child->gd->next_hrtimer < next)
+				next = child->gd->next_hrtimer;
+		}
+	}
+
+	if (next != KTIME_MAX) {
+		s64 delta = ktime_to_ns(ktime_sub(next, ktime_get()));
+
+		wakeup = __arch_counter_get_cntpct();
+		if (delta > 0)
+			wakeup += mul_u64_u32_div(delta, arch_timer_get_rate(),
+						  NSEC_PER_SEC);
+	}
+
+	writel_relaxed(lower_32_bits(wakeup), priv->base);
+	writel_relaxed(upper_32_bits(wakeup), priv->base + 4);
+}
+
 static int mpm_pd_power_off(struct generic_pm_domain *genpd)
 {
 	struct qcom_mpm_priv *priv = container_of(genpd, struct qcom_mpm_priv,
@@ -301,6 +341,8 @@ static int mpm_pd_power_off(struct generic_pm_domain *genpd)
 	for (i = 0; i < priv->reg_stride; i++)
 		qcom_mpm_write(priv, MPM_REG_STATUS, i, 0);
 
+	mpm_write_wakeup(priv, genpd);
+
 	/* Notify RPM to write vMPM into HW */
 	ret = mbox_send_message(priv->mbox_chan, NULL);
 	if (ret < 0)
