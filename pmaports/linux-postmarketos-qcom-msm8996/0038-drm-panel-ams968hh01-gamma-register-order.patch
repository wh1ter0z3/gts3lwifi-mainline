From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jaydens-tasty-slop
 <325336397+jaydens-tasty-slop@users.noreply.github.com>
Date: Thu, 29 Oct 2026 07:09:50 -0600
Subject: [PATCH] drm/panel: samsung-ams968hh01: send the gamma table in
 register order

Once the init sequence reaches the DDI (msm.defer_hs_clk=1), the panel
gives no blue light at all and shows every level below about 190/255
as black.

Register 0x83 takes 11 bytes per channel, red then green then blue:
V11, V23, V35, V51, V87, V151, V203, V255 bits 7:0, V3, V255 bit 8 (as
0x80) and VT. The table sent so far is the vendor smart dimming
reference in the vendor's internal order (the V255 pairs first, then
one RGB triple per gray point). The vendor driver converts its tables
to register order in gamma_command_sorting_post() before sending them;
sent unconverted, blue gets no V255 bit 8 and red gets near-zero mid
points.

The vendor device tree table (samsung,gamma_tx_cmds_revA), so far
taken for an out-of-range placeholder, is the nominal table in register
order. Send it, and drop the gamma_ref parameter, which only chose
between the two tables. The table is kept in the panel context so that
the panel's own offsets can be added to it.

The layout comes from Samsung's GPL-2.0 kernel source for the SM-T820:
drivers/video/msm/mdss/samsung/ANA38401_AMS968HH01/
ss_dsi_smart_dimming_ANA38401_AMS968HH01.c (gamma_command_sorting_post())
and dsi_panel_ANA38401_AMS968HH01_qxga_octa_cmd.dtsi.

Tested on an SM-T820 with msm.defer_hs_clk=1, together with the rest of
this series: blue lights, and red, green, blue and grey ramps are
smooth.

Assisted-by: Claude:claude-opus-5-5
---
 .../gpu/drm/panel/panel-samsung-ams968hh01.c  | 55 ++++++++++---------
 1 file changed, 29 insertions(+), 26 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
index 73af6812e2..4fed8bd674 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
@@ -30,12 +30,15 @@
 #include <drm/drm_probe_helper.h>
 #include <video/mipi_display.h>
 
+#define AMS968HH01_GAMMA_LEN	33
+
 struct ams968hh01 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
 	struct regulator *vdd;
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *tcon_ready_gpio;
+	u8 gamma[1 + AMS968HH01_GAMMA_LEN];	/* register 0x83 and its table */
 };
 
 static inline struct ams968hh01 *to_ams968hh01(struct drm_panel *panel)
@@ -113,10 +116,6 @@ static const u8 ams968hh01_mdnie_bypass2[] = {
 	0x20, 0x00, 0x20, 0x00, 0x20, 0x00, 0xff,
 };
 
-static bool gamma_ref = true;
-module_param(gamma_ref, bool, 0444);
-MODULE_PARM_DESC(gamma_ref, "Use the vendor reference gamma table (default) instead of the DTS power-on placeholder");
-
 static void ams968hh01_mode_regs(struct mipi_dsi_multi_context *ctx);
 
 static bool init_in_enable;
@@ -276,8 +275,31 @@ static void ams968hh01_mode_regs(struct mipi_dsi_multi_context *ctx)
 	ams968hh01_reg_write(ctx, d2, sizeof(d2));		/* Anapass compression mode */
 }
 
+/*
+ * Brightness condition set (gamma), register 0x83. The DDI takes 11 bytes
+ * per channel, red then green then blue: V11, V23, V35, V51, V87, V151,
+ * V203, V255 bits 7:0, V3, V255 bit 8 (as 0x80) and VT. This is the
+ * vendor's nominal table (samsung,gamma_tx_cmds_revA). The vendor smart
+ * dimming code builds its tables in another order and converts them to
+ * this one before sending (gamma_command_sorting_post()).
+ */
+static const u8 ams968hh01_gamma_nominal[11] = {
+	0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00, 0x80, 0x80, 0x00,
+};
+
+static void ams968hh01_gamma_init(struct ams968hh01 *ctx)
+{
+	int i;
+
+	ctx->gamma[0] = 0x83;
+	for (i = 0; i < AMS968HH01_GAMMA_LEN; i++)
+		ctx->gamma[1 + i] = ams968hh01_gamma_nominal[i % 11];
+}
+
 static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 {
+	struct ams968hh01 *panel = mipi_dsi_get_drvdata(ctx->dsi);
+
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x34);
 	ams968hh01_reg(ctx, 0xb2, 0x64, 0x00);	/* check fail off */
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x75);
@@ -293,28 +315,8 @@ static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0xbc);
 	ams968hh01_reg(ctx, 0xb2, 0x04);		/* gamma offset index */
 
-	/*
-	 * Brightness condition set (gamma). Layout from the vendor smart
-	 * dimming code: V255 R/G/B as 9-bit big-endian pairs, then one byte
-	 * per channel for V203, V151, V87, V51, V35, V23, V11, V3 and VT.
-	 * The reference point of the vendor tables is 0x0100 / 0x80 / 0x00
-	 * (about 300 cd/m2); the vendor DTS power-on placeholder (0x80 in
-	 * the V255 high bytes, zeros scattered over the channels) is out of
-	 * range and is replaced by a computed table before anything is shown.
-	 */
-	if (gamma_ref)
-		ams968hh01_reg(ctx, 0x83,
-					     0x01, 0x00, 0x01, 0x00, 0x01, 0x00,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
-					     0x00, 0x00, 0x00);
-	else
-		ams968hh01_reg(ctx, 0x83,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00, 0x80, 0x80, 0x00,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00, 0x80, 0x80, 0x00,
-					     0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x00, 0x80, 0x80, 0x00);
+	/* brightness condition set (gamma) */
+	ams968hh01_reg_write(ctx, panel->gamma, sizeof(panel->gamma));
 
 	ams968hh01_reg(ctx, 0x90, 0x00, 0x00, 0x0e);	/* AID, 360 nit */
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x67);
@@ -510,6 +512,7 @@ static int ams968hh01_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]), "failed to register second DSI device\n");
 
 	mipi_dsi_set_drvdata(dsi, ctx);
+	ams968hh01_gamma_init(ctx);
 
 	ctx->panel.prepare_prev_first = true;
 	drm_panel_add(&ctx->panel);
