From: jaydens-tasty-slop
 <325336397+jaydens-tasty-slop@users.noreply.github.com>
Date: Thu, 29 Oct 2026 10:31:39 -0600
Subject: [PATCH] drm/panel: samsung-ams968hh01: add the high brightness mode

Above its 360 cd/m2 top step the panel has a high brightness mode (HBM)
with eight steps from 378 to 500 cd/m2, which the vendor driver uses in
its outdoor mode. Expose them as backlight levels 256 to 263; the
default level stays 255.

The 500 cd/m2 gamma table is stored in the panel (D4 from offset 0x5b,
33 bytes in register 0x83 order) and gets the same MTP offsets as the
360 cd/m2 one; the steps between lie on the straight line from the 360
cd/m2 table to it. In HBM, AID stays at the 360 cd/m2 value, the ELVSS
dim offset (B0 67) comes from a fixed table and the ELVSS register
B0 70 from the panel (D8 at 0x81); outside HBM that register goes back
to its normal value (D2 at 0x70). ACL is lighter in HBM: 8% from a 60%
average instead of 15% from 50%, so the brightness update now sends the
ACL settings of the level each time.

Values from Samsung's GPL-2.0 kernel source for the SM-T820:
samsung,hbm_candela_map_table, hbm_gamma_tx_cmds, hbm_etc_tx_cmds,
hbm_off_tx_cmds, hbm_rx_cmds, hbm2_rx_cmds and elvss_rx_cmds (revA) in
dsi_panel_ANA38401_AMS968HH01_qxga_octa_cmd.dtsi, mdss_hbm_etc() and
mdss_hbm_read() in ss_dsi_panel_ANA38401_AMS968HH01.c (ELVSS dim offset
at the vendor default of 20 C), hbm_interpolation_init() in
ss_dsi_smart_dimming_ANA38401_AMS968HH01.c.

With the D4, D8 and MTP bytes the stock kernel logs at boot, the eight
tables equal the ones the stock kernel prints in its aid_log.

Assisted-by: Claude:claude-opus-5-5
---
 .../gpu/drm/panel/panel-samsung-ams968hh01.c  | 234 +++++++++++++-----
 1 file changed, 170 insertions(+), 64 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
index 75ac95cb4d..89fec8c0e0 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
@@ -37,6 +37,8 @@
 #define AMS968HH01_NUM_STEPS	65
 #define AMS968HH01_MAX_LEVEL	255
 #define AMS968HH01_POINTS	9	/* gamma points V255 ... V3 */
+#define AMS968HH01_HBM_STEPS	8
+#define AMS968HH01_MAX_BRIGHTNESS	(AMS968HH01_MAX_LEVEL + AMS968HH01_HBM_STEPS)
 
 struct ams968hh01 {
 	struct drm_panel panel;
@@ -48,6 +50,12 @@ struct ams968hh01 {
 	bool mtp_valid;
 	/* register 0x83 and its table, per luminance step */
 	u8 gamma[AMS968HH01_NUM_STEPS][1 + AMS968HH01_GAMMA_LEN];
+	/* high brightness mode: read from the panel with the MTP */
+	bool hbm_valid;
+	bool hbm_on;		/* HBM ELVSS (B0 70) set since the last reset */
+	u8 elvss_normal;	/* B0 70 outside HBM */
+	u8 elvss_hbm;		/* B0 70 in HBM */
+	u8 hbm_gamma[AMS968HH01_HBM_STEPS][1 + AMS968HH01_GAMMA_LEN];
 };
 
 static inline struct ams968hh01 *to_ams968hh01(struct drm_panel *panel)
@@ -297,16 +305,15 @@ static const u8 ams968hh01_gamma_nominal[11] = {
 };
 
 /*
- * Brightness. As in the vendor driver, the 256 backlight levels map onto
- * 65 luminance steps from 2 to 360 cd/m2. Each level has its own AID
- * value (register 0x90, the emission duty cycle); each step has its own
- * ELVSS value and gamma table. A step's gamma table is cut for its base
- * luminance, and AID dims that to the step's luminance. The levels, AID
- * and ELVSS values are from the vendor device tree (samsung,
- * candela_map_table, aid_subdivision_tx_cmds and, as ACL is on,
- * smart_acl_elvss_tx_cmds, revA), the rest from the vendor smart dimming
- * code
- * (ss_dsi_smart_dimming_ANA38401_AMS968HH01.h and
+ * Brightness. As in the vendor driver, backlight levels 0 to 255 map onto
+ * 65 luminance steps from 2 to 360 cd/m2 (levels 256 to 263 are HBM, see
+ * below). Each level has its own AID value (register 0x90, the emission
+ * duty cycle); each step has its own ELVSS value and gamma table. A step's
+ * gamma table is cut for its base luminance, and AID dims that to the
+ * step's luminance. The levels, AID and ELVSS values are from the vendor
+ * device tree (samsung,candela_map_table, aid_subdivision_tx_cmds and, as
+ * ACL is on, smart_acl_elvss_tx_cmds, revA), the rest from the vendor
+ * smart dimming code (ss_dsi_smart_dimming_ANA38401_AMS968HH01.h and
  * ss_dsi_smart_dimming_common.c, Copyright (C) 2012 Samsung).
  */
 struct ams968hh01_step {
@@ -557,6 +564,26 @@ static const u8 ams968hh01_vt_coeff[16] = {
 };
 
 /* DDI reference voltages (vendor VREG0_REF_L and _H), in 2^-22 V */
+/*
+ * High brightness mode: backlight levels 256 to 263, eight steps from 378
+ * to 500 cd/m2 above the 360 cd/m2 of level 255. The vendor driver uses
+ * them for its outdoor mode. The 500 cd/m2 gamma table is in the panel
+ * (D4 from offset 0x5b, plus the MTP gamma offsets); the steps between are
+ * interpolated from the 360 cd/m2 table. AID stays at 360 cd/m2's, ELVSS
+ * comes from this table and the panel (D8 at 0x81), ACL is lighter (8%
+ * from a 60% average). Values from the vendor device tree
+ * (samsung,hbm_candela_map_table, hbm_etc_tx_cmds, hbm_off_tx_cmds,
+ * hbm_rx_cmds, hbm2_rx_cmds and elvss_rx_cmds, revA) and driver
+ * (mdss_hbm_etc() at the default 20 C, hbm_interpolation_init()).
+ */
+static const struct {
+	u16 cd;
+	u8 elvss;	/* ELVSS dim offset, B0 67 */
+} ams968hh01_hbm_steps[AMS968HH01_HBM_STEPS] = {
+	{ 378, 0x25 }, { 395, 0x23 }, { 413, 0x21 }, { 430, 0x1f },
+	{ 448, 0x1e }, { 465, 0x1c }, { 483, 0x1a }, { 500, 0x17 },
+};
+
 #define AMS968HH01_VREF_L	28521267	/* 6.8 V */
 #define AMS968HH01_VREF_H	6291456		/* 1.5 V */
 #define AMS968HH01_SHIFT	22
@@ -709,41 +736,102 @@ static void ams968hh01_gamma_tables(struct ams968hh01 *ctx, const u8 *mtp)
 }
 
 /*
- * The panel's own gamma offsets (MTP): 33 bytes in register 0x83 order,
- * read the vendor way (B0 <offset>, then a generic read of D8) from
- * offset 0x5a. The DDI only answers reads before the init sequence when
- * the link clock starts after the panel reset (MIPI_DSI_CLOCK_DEFERRED_HS);
- * without the offsets the tables stay those of a panel with zero offsets.
+ * The HBM tables: the 500 cd/m2 table is the panel's (with the MTP gamma
+ * offsets added, byte by byte), the others lie on the straight line from
+ * the 360 cd/m2 table to it, rounded towards that table. VT stays 0.
  */
-static int ams968hh01_read_mtp(struct ams968hh01 *ctx)
+static void ams968hh01_hbm_tables(struct ams968hh01 *ctx, const u8 *hbm, const u8 *mtp)
+{
+	const struct ams968hh01_step *top = &ams968hh01_steps[AMS968HH01_NUM_STEPS - 1];
+	const u8 *max = &ctx->gamma[AMS968HH01_NUM_STEPS - 1][1];
+	int cd_hbm = ams968hh01_hbm_steps[AMS968HH01_HBM_STEPS - 1].cd;
+	int h, k;
+
+	for (h = 0; h < AMS968HH01_HBM_STEPS; h++) {
+		s32 rate = ((ams968hh01_hbm_steps[h].cd - top->cd) << AMS968HH01_SHIFT) /
+			   (cd_hbm - top->cd);
+		u8 *reg = &ctx->hbm_gamma[h][1];
+
+		ctx->hbm_gamma[h][0] = 0x83;
+		for (k = 0; k < AMS968HH01_GAMMA_LEN; k++) {
+			int d = (u8)(hbm[k] + mtp[k]) - max[k];
+
+			reg[k] = max[k] + d * rate / (1 << AMS968HH01_SHIFT);
+		}
+		for (k = 10; k < AMS968HH01_GAMMA_LEN; k += 11)
+			reg[k] = 0;
+		dev_dbg(&ctx->dsi[0]->dev, "hbm %3u cd/m2: %*ph\n",
+			ams968hh01_hbm_steps[h].cd, AMS968HH01_GAMMA_LEN, reg);
+	}
+}
+
+/* Read DDI data the vendor way: B0 <offset>, then a generic read of <reg> */
+static int ams968hh01_read(struct ams968hh01 *ctx, u8 reg, u8 offset, u8 *buf, int len)
 {
 	struct mipi_dsi_device *dsi = ctx->dsi[0];
-	u8 mtp[AMS968HH01_GAMMA_LEN];
 	int i, n, ret;
 
-	ret = mipi_dsi_set_maximum_return_packet_size(dsi, 8);
-	if (ret < 0)
-		return ret;
-
-	for (i = 0; i < sizeof(mtp); i += n) {
-		u8 sel[] = { 0xb0, 0x5a + i };
+	for (i = 0; i < len; i += n) {
+		u8 sel[] = { 0xb0, offset + i };
 		u8 rd[2];
 
-		n = min_t(int, 8, sizeof(mtp) - i);
-		rd[0] = 0xd8;
+		n = min(8, len - i);
+		rd[0] = reg;
 		rd[1] = n;
 		ret = mipi_dsi_dcs_write_buffer(dsi, sel, sizeof(sel));
 		if (ret < 0)
 			return ret;
-		ret = mipi_dsi_generic_read(dsi, rd, sizeof(rd), mtp + i, n);
+		ret = mipi_dsi_generic_read(dsi, rd, sizeof(rd), buf + i, n);
 		if (ret != n)
 			return ret < 0 ? ret : -EIO;
 	}
 
+	return 0;
+}
+
+/*
+ * The panel's own gamma offsets (MTP): 33 bytes in register 0x83 order,
+ * from D8 at offset 0x5a. The DDI only answers reads before the init
+ * sequence when the link clock starts after the panel reset
+ * (MIPI_DSI_CLOCK_DEFERRED_HS); without the offsets the tables stay those
+ * of a panel with zero offsets. Then the HBM data: the 500 cd/m2 table
+ * (D4 from 0x5b) and the two values of ELVSS register 70 (D2 at 0x70
+ * outside HBM, D8 at 0x81 in HBM); without them the HBM levels act as
+ * level 255.
+ */
+static int ams968hh01_read_mtp(struct ams968hh01 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi[0];
+	u8 mtp[AMS968HH01_GAMMA_LEN], hbm[AMS968HH01_GAMMA_LEN];
+	int ret;
+
+	ret = mipi_dsi_set_maximum_return_packet_size(dsi, 8);
+	if (ret < 0)
+		return ret;
+
+	ret = ams968hh01_read(ctx, 0xd8, 0x5a, mtp, sizeof(mtp));
+	if (ret)
+		return ret;
+
 	ams968hh01_gamma_tables(ctx, mtp);
 	ctx->mtp_valid = true;
 	dev_info(&dsi->dev, "MTP %*ph\n", (int)sizeof(mtp), mtp);
 
+	ret = ams968hh01_read(ctx, 0xd4, 0x5b, hbm, sizeof(hbm));
+	if (!ret)
+		ret = ams968hh01_read(ctx, 0xd2, 0x70, &ctx->elvss_normal, 1);
+	if (!ret)
+		ret = ams968hh01_read(ctx, 0xd8, 0x81, &ctx->elvss_hbm, 1);
+	if (ret) {
+		dev_warn(&dsi->dev, "HBM data read failed (%d), no HBM\n", ret);
+		return 0;
+	}
+
+	ams968hh01_hbm_tables(ctx, hbm, mtp);
+	ctx->hbm_valid = true;
+	dev_info(&dsi->dev, "HBM %*ph, ELVSS %02x/%02x\n", (int)sizeof(hbm), hbm,
+		 ctx->elvss_normal, ctx->elvss_hbm);
+
 	return 0;
 }
 
@@ -781,11 +869,60 @@ static u8 ams968hh01_caps(unsigned int s)
 	return ams968hh01_steps[s].cd >= 41 ? 0x85 : 0x81;
 }
 
+/*
+ * Everything that depends on the backlight level, then the update key:
+ * gamma table, AID, ELVSS, ACL and CAPS.
+ *
+ * ELVSS. The vendor on-sequence writes 0x0f, but the brightness update
+ * the vendor sends after display-on replaces it with the step's value
+ * from its ELVSS table for ACL on (samsung,smart_acl_elvss_tx_cmds_revA).
+ *
+ * ACL (automatic current limiting): the DDI lowers the emission current
+ * when the average picture level is high, which caps the panel's total
+ * current. The vendor on-sequence turns it off, and the brightness update
+ * after display-on turns it on with these values
+ * (samsung,acl_on_tx_cmds_revA, with the vendor's default gradual_acl_val
+ * 0x12 at offset 0x36).
+ */
+static void ams968hh01_brightness(struct ams968hh01 *panel,
+				  struct mipi_dsi_multi_context *ctx,
+				  unsigned int level)
+{
+	unsigned int s;
+
+	if (level > AMS968HH01_MAX_LEVEL && panel->hbm_valid) {
+		unsigned int h = level - AMS968HH01_MAX_LEVEL - 1;
+
+		ams968hh01_reg_write(ctx, panel->hbm_gamma[h], sizeof(panel->hbm_gamma[h]));
+		ams968hh01_aid(ctx, AMS968HH01_MAX_LEVEL);
+		ams968hh01_param(ctx, 0x67, ams968hh01_hbm_steps[h].elvss);
+		ams968hh01_param(ctx, 0x70, panel->elvss_hbm);
+		ams968hh01_param(ctx, 0x4d, 0x05);	/* 32 frame avg */
+		ams968hh01_param(ctx, 0x49, 0x99);	/* start at 60% */
+		ams968hh01_param(ctx, 0x36, 0x11);	/* ACL on, 8% */
+		ams968hh01_param(ctx, 0x6d, 0x85);	/* CAPS */
+		panel->hbm_on = true;
+	} else {
+		level = min(level, AMS968HH01_MAX_LEVEL);
+		s = ams968hh01_step(level);
+		if (panel->hbm_on) {
+			ams968hh01_param(ctx, 0x70, panel->elvss_normal);
+			panel->hbm_on = false;
+		}
+		ams968hh01_reg_write(ctx, panel->gamma[s], sizeof(panel->gamma[s]));
+		ams968hh01_aid(ctx, level);
+		ams968hh01_param(ctx, 0x67, ams968hh01_steps[s].elvss);
+		ams968hh01_param(ctx, 0x4d, 0x05);	/* 32 frame avg */
+		ams968hh01_param(ctx, 0x49, 0x7f);	/* start at 50% */
+		ams968hh01_param(ctx, 0x36, 0x12);	/* ACL on, 15% */
+		ams968hh01_param(ctx, 0x6d, ams968hh01_caps(s));
+	}
+	ams968hh01_param(ctx, 0x35, 0x01);		/* gamma update key */
+}
+
 static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 {
 	struct ams968hh01 *panel = mipi_dsi_get_drvdata(ctx->dsi);
-	unsigned int level = panel->bl->props.brightness;
-	unsigned int s = ams968hh01_step(level);
 
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x34);
 	ams968hh01_reg(ctx, 0xb2, 0x64, 0x00);	/* check fail off */
@@ -802,30 +939,7 @@ static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0xbc);
 	ams968hh01_reg(ctx, 0xb2, 0x04);		/* gamma offset index */
 
-	/* brightness condition set (gamma) and AID of the current level */
-	ams968hh01_reg_write(ctx, panel->gamma[s], sizeof(panel->gamma[s]));
-	ams968hh01_aid(ctx, level);
-	/*
-	 * ELVSS. The vendor on-sequence writes 0x0f, but the brightness
-	 * update the vendor sends after display-on replaces it with the
-	 * step's value from its ELVSS table for ACL on
-	 * (samsung,smart_acl_elvss_tx_cmds_revA).
-	 */
-	ams968hh01_param(ctx, 0x67, ams968hh01_steps[s].elvss);
-	/*
-	 * ACL (automatic current limiting): the DDI lowers the emission
-	 * current when the average picture level is high, which caps the
-	 * panel's total current. The vendor on-sequence turns it off, and
-	 * the brightness update after display-on turns it on with these
-	 * values (samsung,acl_on_tx_cmds_revA, with the vendor's default
-	 * gradual_acl_val 0x12 at offset 0x36).
-	 */
-	ams968hh01_param(ctx, 0x4d, 0x05);		/* 32 frame avg */
-	ams968hh01_param(ctx, 0x49, 0x7f);		/* start at 50% */
-	ams968hh01_param(ctx, 0x36, 0x12);		/* ACL on, 15% */
-	ams968hh01_param(ctx, 0x6d, ams968hh01_caps(s));
-	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0x35);
-	ams968hh01_reg(ctx, 0xb2, 0x01);		/* gamma update key */
+	ams968hh01_brightness(panel, ctx, panel->bl->props.brightness);
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0xd0);
 	ams968hh01_reg(ctx, 0xb1, 0x1d);		/* UPLL_F = 35 */
 	mipi_dsi_msleep(ctx, 215);
@@ -837,6 +951,7 @@ static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 
 static void ams968hh01_power_off(struct ams968hh01 *ctx)
 {
+	ctx->hbm_on = false;
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	usleep_range(5000, 6000);
 	regulator_disable(ctx->vdd);
@@ -959,28 +1074,19 @@ static int ams968hh01_get_modes(struct drm_panel *panel,
 						   &ams968hh01_mode_slow : &ams968hh01_mode);
 }
 
-/*
- * The vendor brightness update, in HS mode on the first link: AID, ELVSS,
- * CAPS and gamma, then the update key. ACL keeps its init settings.
- */
+/* The vendor brightness update, in HS mode on the first link */
 static int ams968hh01_bl_update_status(struct backlight_device *bl)
 {
 	struct ams968hh01 *ctx = bl_get_data(bl);
 	struct mipi_dsi_device *dsi = ctx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
-	unsigned int level = bl->props.brightness;
-	unsigned int s = ams968hh01_step(level);
 
 	/* The panel is off, or not on yet: init sends the current level */
 	if (backlight_is_blank(bl))
 		return 0;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-	ams968hh01_aid(&dsi_ctx, level);
-	ams968hh01_param(&dsi_ctx, 0x67, ams968hh01_steps[s].elvss);
-	ams968hh01_param(&dsi_ctx, 0x6d, ams968hh01_caps(s));
-	ams968hh01_reg_write(&dsi_ctx, ctx->gamma[s], sizeof(ctx->gamma[s]));
-	ams968hh01_param(&dsi_ctx, 0x35, 0x01);		/* gamma update key */
+	ams968hh01_brightness(ctx, &dsi_ctx, bl->props.brightness);
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
 	return dsi_ctx.accum_err;
@@ -1008,7 +1114,7 @@ static int ams968hh01_probe(struct mipi_dsi_device *dsi)
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
 		.brightness = AMS968HH01_MAX_LEVEL,
-		.max_brightness = AMS968HH01_MAX_LEVEL,
+		.max_brightness = AMS968HH01_MAX_BRIGHTNESS,
 		.power = BACKLIGHT_POWER_OFF,
 	};
 	static const u8 no_mtp[AMS968HH01_GAMMA_LEN];
