diff --git a/drivers/iio/adc/stmpe-adc.c b/drivers/iio/adc/stmpe-adc.c
index 8e26c47edc..1f43c90927 100644
--- a/drivers/iio/adc/stmpe-adc.c
+++ b/drivers/iio/adc/stmpe-adc.c
@@ -176,6 +176,7 @@ static irqreturn_t stmpe_adc_isr(int irq, void *dev_id)
 {
 	struct stmpe_adc *info = (struct stmpe_adc *)dev_id;
 	__be16 data;
+	int ret;
 
 	if (info->channel <= STMPE_ADC_LAST_NR) {
 		int int_sta;
@@ -187,17 +188,20 @@ static irqreturn_t stmpe_adc_isr(int irq, void *dev_id)
 			return IRQ_NONE;
 
 		/* Read value */
-		stmpe_block_read(info->stmpe,
-			STMPE_REG_ADC_DATA_CH(info->channel), 2, (u8 *) &data);
+		ret = stmpe_block_read(info->stmpe,
+				       STMPE_REG_ADC_DATA_CH(info->channel), 2,
+				       (u8 *)&data);
 
 		stmpe_reg_write(info->stmpe, STMPE_REG_ADC_INT_STA, int_sta);
 	} else if (info->channel == STMPE_TEMP_CHANNEL) {
 		/* Read value */
-		stmpe_block_read(info->stmpe, STMPE_REG_TEMP_DATA, 2,
-				(u8 *) &data);
+		ret = stmpe_block_read(info->stmpe, STMPE_REG_TEMP_DATA, 2,
+				       (u8 *)&data);
 	} else {
 		return IRQ_NONE;
 	}
+	if (ret < 0)
+		return IRQ_NONE;
 
 	info->value = (u32) be16_to_cpu(data);
 	complete(&info->completion);
diff --git a/drivers/input/touchscreen/stmpe-ts.c b/drivers/input/touchscreen/stmpe-ts.c
index af0fb38bcf..55ce0a8562 100644
--- a/drivers/input/touchscreen/stmpe-ts.c
+++ b/drivers/input/touchscreen/stmpe-ts.c
@@ -129,6 +129,7 @@ static void stmpe_work(struct work_struct *work)
 static irqreturn_t stmpe_ts_handler(int irq, void *data)
 {
 	u8 data_set[4];
+	int ret;
 	int x, y, z;
 	struct stmpe_touch *ts = data;
 
@@ -147,7 +148,9 @@ static irqreturn_t stmpe_ts_handler(int irq, void *data)
 	stmpe_set_bits(ts->stmpe, STMPE_REG_TSC_CTRL,
 				STMPE_TSC_CTRL_TSC_EN, 0);
 
-	stmpe_block_read(ts->stmpe, STMPE_REG_TSC_DATA_XYZ, 4, data_set);
+	ret = stmpe_block_read(ts->stmpe, STMPE_REG_TSC_DATA_XYZ, 4, data_set);
+	if (ret < 0)
+		goto out_restore;
 
 	x = (data_set[0] << 4) | (data_set[1] >> 4);
 	y = ((data_set[1] & 0xf) << 8) | data_set[2];
@@ -158,6 +161,7 @@ static irqreturn_t stmpe_ts_handler(int irq, void *data)
 	input_report_key(ts->idev, BTN_TOUCH, 1);
 	input_sync(ts->idev);
 
+out_restore:
        /* flush the FIFO after we have read out our values. */
 	__stmpe_reset_fifo(ts->stmpe);
 
