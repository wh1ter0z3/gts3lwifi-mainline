diff --git a/drivers/mfd/stmpe-i2c.c b/drivers/mfd/stmpe-i2c.c
index 943fa363ef..c95295f44d 100644
--- a/drivers/mfd/stmpe-i2c.c
+++ b/drivers/mfd/stmpe-i2c.c
@@ -15,6 +15,7 @@
 #include <linux/module.h>
 #include <linux/types.h>
 #include <linux/of_device.h>
+#include "stmpe-i2c.h"
 #include "stmpe.h"
 
 static int i2c_reg_read(struct stmpe *stmpe, u8 reg)
@@ -34,8 +35,11 @@ static int i2c_reg_write(struct stmpe *stmpe, u8 reg, u8 val)
 static int i2c_block_read(struct stmpe *stmpe, u8 reg, u8 length, u8 *values)
 {
 	struct i2c_client *i2c = stmpe->client;
+	int ret;
 
-	return i2c_smbus_read_i2c_block_data(i2c, reg, length, values);
+	ret = i2c_smbus_read_i2c_block_data(i2c, reg, length, values);
+
+	return stmpe_i2c_block_read_status(ret, length);
 }
 
 static int i2c_block_write(struct stmpe *stmpe, u8 reg, u8 length,
diff --git a/drivers/mfd/stmpe-i2c.h b/drivers/mfd/stmpe-i2c.h
new file mode 100644
index 0000000000..0d6c42d293
--- /dev/null
+++ b/drivers/mfd/stmpe-i2c.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __STMPE_I2C_H
+#define __STMPE_I2C_H
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+static inline int stmpe_i2c_block_read_status(int ret, u8 length)
+{
+	if (ret < 0)
+		return ret;
+
+	return ret == length ? 0 : -EIO;
+}
+
+#endif
diff --git a/drivers/mfd/stmpe-test.c b/drivers/mfd/stmpe-test.c
new file mode 100644
index 0000000000..ab65ecc9e8
--- /dev/null
+++ b/drivers/mfd/stmpe-test.c
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/device.h>
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/mfd/stmpe.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+
+#include "stmpe-i2c.h"
+#include "stmpe.h"
+
+#define STMPE_TEST_READ_LENGTH	5
+
+struct stmpe_transport_test_context {
+	int transfer_result;
+	u8 fill;
+	unsigned int consumers;
+};
+
+static int stmpe_test_i2c_read(struct stmpe *stmpe, u8 reg, u8 length,
+			       u8 *values)
+{
+	struct stmpe_transport_test_context *ctx = stmpe->client;
+
+	(void)reg;
+	if (ctx->transfer_result == length)
+		memset(values, ctx->fill, length);
+
+	return stmpe_i2c_block_read_status(ctx->transfer_result, length);
+}
+
+static int stmpe_test_spi_read(struct stmpe *stmpe, u8 reg, u8 length,
+			       u8 *values)
+{
+	struct stmpe_transport_test_context *ctx = stmpe->client;
+
+	(void)reg;
+	memset(values, ctx->fill, length);
+
+	return 0;
+}
+
+static void stmpe_test_init(struct kunit *test, struct stmpe *stmpe,
+			    struct stmpe_client_info *ci,
+			    struct stmpe_transport_test_context *ctx,
+			    int (*read_block)(struct stmpe *, u8, u8, u8 *))
+{
+	stmpe->dev = kunit_device_register(test, "stmpe-transport-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, stmpe->dev);
+	mutex_init(&stmpe->lock);
+	stmpe->client = ctx;
+	stmpe->ci = ci;
+	ci->read_block = read_block;
+}
+
+static int stmpe_test_consume_block(struct stmpe *stmpe,
+				    struct stmpe_transport_test_context *ctx,
+				    u8 *values)
+{
+	int ret;
+
+	ret = stmpe_block_read(stmpe, 0, STMPE_TEST_READ_LENGTH, values);
+	if (!ret)
+		ctx->consumers++;
+
+	return ret;
+}
+
+static void stmpe_test_i2c_block_read_results(struct kunit *test)
+{
+	struct stmpe_transport_test_context ctx = {
+		.fill = 0x5a,
+	};
+	struct stmpe_client_info ci = {};
+	struct stmpe stmpe = {};
+	u8 values[STMPE_TEST_READ_LENGTH];
+	int ret;
+	int result;
+	int i;
+
+	stmpe_test_init(test, &stmpe, &ci, &ctx, stmpe_test_i2c_read);
+
+	for (result = 0; result < STMPE_TEST_READ_LENGTH; result++) {
+		memset(values, 0xa5, sizeof(values));
+		ctx.transfer_result = result;
+
+		ret = stmpe_test_consume_block(&stmpe, &ctx, values);
+		KUNIT_EXPECT_EQ(test, ret, -EIO);
+		for (i = 0; i < ARRAY_SIZE(values); i++)
+			KUNIT_EXPECT_EQ(test, values[i], (u8)0xa5);
+	}
+	KUNIT_EXPECT_EQ(test, ctx.consumers, 0U);
+
+	ctx.transfer_result = STMPE_TEST_READ_LENGTH;
+	KUNIT_EXPECT_EQ(test, stmpe_test_consume_block(&stmpe, &ctx, values), 0);
+	KUNIT_EXPECT_EQ(test, ctx.consumers, 1U);
+	for (i = 0; i < ARRAY_SIZE(values); i++)
+		KUNIT_EXPECT_EQ(test, values[i], ctx.fill);
+
+	memset(values, 0xa5, sizeof(values));
+	ctx.transfer_result = -EREMOTEIO;
+	KUNIT_EXPECT_EQ(test, stmpe_test_consume_block(&stmpe, &ctx, values),
+			-EREMOTEIO);
+	KUNIT_EXPECT_EQ(test, ctx.consumers, 1U);
+}
+
+static void stmpe_test_spi_zero_fills_block(struct kunit *test)
+{
+	struct stmpe_transport_test_context ctx = {
+		.fill = 0x3c,
+	};
+	struct stmpe_client_info ci = {};
+	struct stmpe stmpe = {};
+	u8 values[STMPE_TEST_READ_LENGTH] = {};
+	int i;
+
+	stmpe_test_init(test, &stmpe, &ci, &ctx, stmpe_test_spi_read);
+
+	KUNIT_EXPECT_EQ(test, stmpe_test_consume_block(&stmpe, &ctx, values), 0);
+	KUNIT_EXPECT_EQ(test, ctx.consumers, 1U);
+	for (i = 0; i < ARRAY_SIZE(values); i++)
+		KUNIT_EXPECT_EQ(test, values[i], ctx.fill);
+}
+
+static struct kunit_case stmpe_transport_test_cases[] = {
+	KUNIT_CASE(stmpe_test_i2c_block_read_results),
+	KUNIT_CASE(stmpe_test_spi_zero_fills_block),
+	{}
+};
+
+static struct kunit_suite stmpe_transport_test_suite = {
+	.name = "stmpe-transport",
+	.test_cases = stmpe_transport_test_cases,
+};
+
+kunit_test_suite(stmpe_transport_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests for STMPE transport contracts");
+MODULE_LICENSE("GPL");
diff --git a/drivers/mfd/stmpe.c b/drivers/mfd/stmpe.c
index 362471de3b..46cfabf74f 100644
--- a/drivers/mfd/stmpe.c
+++ b/drivers/mfd/stmpe.c
@@ -96,9 +96,10 @@ static int __stmpe_block_read(struct stmpe *stmpe, u8 reg, u8 length,
 	ret = stmpe->ci->read_block(stmpe, reg, length, values);
 	if (ret < 0)
 		dev_err(stmpe->dev, "failed to read regs %#x: %d\n", reg, ret);
+	else
+		stmpe_dump_bytes("stmpe rd: ", values, length);
 
 	dev_vdbg(stmpe->dev, "rd: reg %#x (%d) => ret %#x\n", reg, length, ret);
-	stmpe_dump_bytes("stmpe rd: ", values, length);
 
 	return ret;
 }
@@ -212,6 +213,8 @@ EXPORT_SYMBOL_GPL(stmpe_set_bits);
  * @reg:	First register
  * @length:	Number of registers
  * @values:	Buffer to write to
+ *
+ * Return: zero on success, a negative error code on failure
  */
 int stmpe_block_read(struct stmpe *stmpe, u8 reg, u8 length, u8 *values)
 {
