From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Tue, 22 Sep 2026 12:00:26 +0530
Subject: [PATCH] dt-bindings: display: panel: add Samsung AMS968HH01

The AMS968HH01 is the 2048x1536 AMOLED panel of the Samsung Galaxy Tab
S3, with an Anapass ANA38401 driver IC on two DSI links in command
mode. The panel node sits under the master DSI controller and has an
input port for each link.

[jaydens-tasty-slop: taken from the draft in psigod's research tree
 (kernel/Documentation/devicetree/bindings/display/panel/, commit
 6405fa5, with the rotation property from 1491be2); added the
 maintainers entry dtschema requires and an example]
Assisted-by: Claude:claude-opus-5-5
---
 .../display/panel/samsung,ams968hh01.yaml     | 99 +++++++++++++++++++
 1 file changed, 99 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/samsung,ams968hh01.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,ams968hh01.yaml b/Documentation/devicetree/bindings/display/panel/samsung,ams968hh01.yaml
new file mode 100644
index 0000000000..34874fa2e5
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,ams968hh01.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,ams968hh01.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung AMS968HH01 QXGA AMOLED panel (Anapass ANA38401 DDI)
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  2048x1536 AMOLED panel driven over two MIPI DSI links in command mode,
+  used in the Samsung Galaxy Tab S3. The panel node is a child of the
+  master DSI controller and has two input ports.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,ams968hh01
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: panel 3.3 V supply
+
+  reset-gpios: true
+
+  rotation: true
+
+  tcon-ready-gpios:
+    maxItems: 1
+    description: input raised by the DDI once it accepts commands
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: first (master) DSI link, carries commands and the left half
+      port@1:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: second DSI link, right half
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - reset-gpios
+  - tcon-ready-gpios
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,ams968hh01";
+            reg = <0>;
+
+            vdd-supply = <&vreg_lcd_vdd_3p3>;
+            reset-gpios = <&tlmm 143 GPIO_ACTIVE_LOW>;
+            tcon-ready-gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;
+            rotation = <270>;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+                    panel_in0: endpoint {
+                        remote-endpoint = <&dsi0_out>;
+                    };
+                };
+
+                port@1 {
+                    reg = <1>;
+                    panel_in1: endpoint {
+                        remote-endpoint = <&dsi1_out>;
+                    };
+                };
+            };
+        };
+    };
+
+...
