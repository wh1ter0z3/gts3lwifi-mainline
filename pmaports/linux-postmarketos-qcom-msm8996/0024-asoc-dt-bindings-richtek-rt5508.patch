From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 28 Oct 2026 19:19:55 +0530
Subject: [PATCH] ASoC: dt-bindings: add Richtek RT5508 speaker amplifier

The RT5508 is a mono Class-D smart amplifier with a boost converter and
speaker current/voltage sensing, controlled over I2C. It takes I2S or a
4-slot TDM frame and plays the left, right or averaged channel of a slot
pair.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/sound/richtek,rt5508.yaml        | 97 +++++++++++++++++++
 1 file changed, 97 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/richtek,rt5508.yaml

diff --git a/Documentation/devicetree/bindings/sound/richtek,rt5508.yaml b/Documentation/devicetree/bindings/sound/richtek,rt5508.yaml
new file mode 100644
index 0000000000..9da649cf82
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/richtek,rt5508.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/richtek,rt5508.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Richtek RT5508 Smart Speaker Amplifier
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  The RT5508 is a mono Class-D speaker amplifier with an integrated boost
+  converter, a DSP and speaker current/voltage sensing. It is controlled over
+  I2C and takes audio over an I2S-style interface, either as a stereo frame or
+  as a 4-slot TDM frame. In TDM mode it plays from one pair of slots (0/1 or
+  2/3), using the first slot, the second slot or their average.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: richtek,rt5508
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+  richtek,channel-select:
+    description: |
+      Channel to play from the stereo frame, or from the selected slot pair
+      in TDM mode.
+        0 - left (first slot of the pair)
+        1 - average of left and right
+        2 - right (second slot of the pair)
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1, 2]
+    default: 1
+
+  richtek,tdm-dac-slot:
+    description:
+      Slot pair played in TDM mode, 0 for slots 0/1, 1 for slots 2/3.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+    default: 0
+
+  richtek,tdm-adc-slot:
+    description:
+      Slot pair the amplifier transmits its sense data in when in TDM mode,
+      0 for slots 0/1, 1 for slots 2/3.
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+    default: 0
+
+  richtek,data-out-enable:
+    description:
+      The data output of this amplifier is wired to the host. Amplifiers
+      sharing one data line must not all drive it; set this on one of them.
+    type: boolean
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@34 {
+            compatible = "richtek,rt5508";
+            reg = <0x34>;
+            #sound-dai-cells = <0>;
+            sound-name-prefix = "Speaker UR";
+            richtek,channel-select = <2>;
+            richtek,tdm-dac-slot = <1>;
+            richtek,tdm-adc-slot = <1>;
+        };
+
+        amplifier@36 {
+            compatible = "richtek,rt5508";
+            reg = <0x36>;
+            #sound-dai-cells = <0>;
+            sound-name-prefix = "Speaker LR";
+            richtek,channel-select = <0>;
+            richtek,tdm-dac-slot = <1>;
+            richtek,tdm-adc-slot = <1>;
+            richtek,data-out-enable;
+        };
+    };
