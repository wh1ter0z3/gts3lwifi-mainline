From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nazim Aghabayov <nazim.aghabayov@buta-tech.com>
Date: Sun, 1 Nov 2026 16:30:00 +0100
Subject: [PATCH] input: stmpe-keypad: recover from an accessory power cycle

The STMPE1801 in Samsung's Book Cover Keyboard sits behind pogo pins:
every detach cuts its power, and a quick reattach can be debounced away
by the accessory detection (SM5705 MUIC), so the driver can find itself
bound to a chip that is gone or has silently lost all configuration
(observed on an SM-T825: endless "failed to read regs: -6", or a silent
keyboard while extcon still reports the dock attached).

Poll a canary register every two seconds: the low keypad column register
holds a known non-default value after init. A NAK means the keypad is
detached right now; the reset default means the chip power cycled, so
restore the chip-level interrupt setup (new stmpe_restore_irq_setup()
helper rewrites ICR, autosleep and the cached IER bits) and re-run the
keypad block init. Verified on an SM-T825 with kernel 6.19.5.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 drivers/input/keyboard/stmpe-keypad.c | 68 +++++++++++++++++++++++++++
 drivers/mfd/stmpe.c                   | 44 +++++++++++++++++
 include/linux/mfd/stmpe.h             |  2 +
 3 files changed, 114 insertions(+)

diff --git a/drivers/input/keyboard/stmpe-keypad.c b/drivers/input/keyboard/stmpe-keypad.c
index c6f54bf4e3..146481df8a 100644
--- a/drivers/input/keyboard/stmpe-keypad.c
+++ b/drivers/input/keyboard/stmpe-keypad.c
@@ -9,10 +9,12 @@
 #include <linux/slab.h>
 #include <linux/input.h>
 #include <linux/interrupt.h>
+#include <linux/jiffies.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/input/matrix_keypad.h>
 #include <linux/mfd/stmpe.h>
+#include <linux/workqueue.h>
 #include <kunit/visibility.h>
 
 #include "stmpe-keypad.h"
@@ -246,6 +248,8 @@ struct stmpe_keypad {
 	unsigned int row_shift;
 	int overflow_irq;
 	unsigned short *keymap;
+	struct delayed_work health_work;
+	bool present;
 };
 
 VISIBLE_IF_KUNIT
@@ -591,6 +595,62 @@ static int stmpe_keypad_chip_init(struct stmpe_keypad *keypad)
 	return ret;
 }
 
+#define STMPE_KEYPAD_HEALTH_INTERVAL	msecs_to_jiffies(2000)
+
+/*
+ * The keypad can sit in a detachable accessory (Samsung's Book Cover
+ * Keyboard, for example), where a detach cuts the STMPE's power and a
+ * quick reattach can be debounced away by the accessory detection. This
+ * driver is then bound to a chip that is either gone or has silently
+ * lost all its configuration. Poll a canary register that chip init set
+ * to a known non-default value: a read failure means the keypad is
+ * detached right now, the reset default means the chip power cycled and
+ * has to be set up from scratch.
+ */
+static void stmpe_keypad_health_work(struct work_struct *work)
+{
+	struct stmpe_keypad *keypad = container_of(to_delayed_work(work),
+						   struct stmpe_keypad,
+						   health_work);
+	struct device *dev = keypad->input->dev.parent;
+	int error;
+	int ret;
+
+	ret = stmpe_reg_read(keypad->stmpe, keypad->variant->col_lsb_reg);
+	if (ret < 0) {
+		if (keypad->present) {
+			keypad->present = false;
+			dev_info(dev, "keypad unreachable, assuming detached\n");
+		}
+		goto out;
+	}
+
+	if (ret == (keypad->cols & 0xff)) {
+		keypad->present = true;
+		goto out;
+	}
+
+	/* The chip answers but with the reset default: it power cycled. */
+	dev_info(dev, "keypad reset detected, reinitializing\n");
+
+	error = stmpe_restore_irq_setup(keypad->stmpe);
+	if (!error)
+		error = stmpe_keypad_chip_init(keypad);
+	if (!error)
+		error = stmpe_keypad_start(&stmpe_keypad_lifecycle_ops, keypad);
+	if (error) {
+		/* Leave present false; the next poll retries. */
+		keypad->present = false;
+		dev_warn(dev, "keypad reinit failed: %d\n", error);
+	} else {
+		keypad->present = true;
+	}
+
+out:
+	schedule_delayed_work(&keypad->health_work,
+			      STMPE_KEYPAD_HEALTH_INTERVAL);
+}
+
 static void stmpe_keypad_fill_used_pins(struct stmpe_keypad *keypad,
 					u32 used_rows, u32 used_cols)
 {
@@ -710,6 +770,13 @@ static int stmpe_keypad_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, keypad);
 
+	keypad->present = true;
+	INIT_DELAYED_WORK(&keypad->health_work, stmpe_keypad_health_work);
+	/* The canary needs a non-default value in the low column register. */
+	if (keypad->cols & 0xff)
+		schedule_delayed_work(&keypad->health_work,
+				      STMPE_KEYPAD_HEALTH_INTERVAL);
+
 	return 0;
 
 err_disable:
@@ -721,6 +788,7 @@ static void stmpe_keypad_remove(struct platform_device *pdev)
 {
 	struct stmpe_keypad *keypad = platform_get_drvdata(pdev);
 
+	cancel_delayed_work_sync(&keypad->health_work);
 	stmpe_keypad_stop(&stmpe_keypad_lifecycle_ops, keypad);
 }
 
diff --git a/drivers/mfd/stmpe.c b/drivers/mfd/stmpe.c
index 974108cf93..9a0630bf57 100644
--- a/drivers/mfd/stmpe.c
+++ b/drivers/mfd/stmpe.c
@@ -1310,9 +1310,53 @@ static int stmpe_chip_init(struct stmpe *stmpe)
 			return ret;
 	}
 
+	stmpe->icr = icr;
+
 	return stmpe_reg_write(stmpe, stmpe->regs[STMPE_IDX_ICR_LSB], icr);
 }
 
+/**
+ * stmpe_restore_irq_setup - rewrite the interrupt setup after a chip reset
+ * @stmpe: Device to restore
+ *
+ * A hotpluggable STMPE (such as one inside a detachable keyboard) loses
+ * its register state whenever it loses power. A subdriver that detects
+ * the reset calls this to restore the chip-level interrupt configuration
+ * (ICR, autosleep and the IER bits of the currently unmasked interrupts)
+ * before it reconfigures its own block.
+ */
+int stmpe_restore_irq_setup(struct stmpe *stmpe)
+{
+	struct stmpe_variant_info *variant = stmpe->variant;
+	int num = DIV_ROUND_UP(variant->num_irqs, 8);
+	int ret;
+	int i;
+
+	if (stmpe->pdata->autosleep) {
+		ret = stmpe_autosleep(stmpe, stmpe->pdata->autosleep_timeout);
+		if (ret)
+			return ret;
+	}
+
+	ret = stmpe_reg_write(stmpe, stmpe->regs[STMPE_IDX_ICR_LSB],
+			      stmpe->icr);
+	if (ret)
+		return ret;
+
+	mutex_lock(&stmpe->irq_lock);
+	for (i = 0; i < num; i++) {
+		stmpe->oldier[i] = stmpe->ier[i];
+		ret = stmpe_reg_write(stmpe, stmpe->regs[STMPE_IDX_IER_LSB + i],
+				      stmpe->ier[i]);
+		if (ret)
+			break;
+	}
+	mutex_unlock(&stmpe->irq_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(stmpe_restore_irq_setup);
+
 static int stmpe_add_device(struct stmpe *stmpe, const struct mfd_cell *cell)
 {
 	return mfd_add_devices(stmpe->dev, stmpe->pdata->id, cell, 1,
diff --git a/include/linux/mfd/stmpe.h b/include/linux/mfd/stmpe.h
index 87e29d561e..2211d345d9 100644
--- a/include/linux/mfd/stmpe.h
+++ b/include/linux/mfd/stmpe.h
@@ -136,6 +136,7 @@ struct stmpe {
 	int num_gpios;
 	u8 ier[2];
 	u8 oldier[2];
+	u8 icr;
 	struct stmpe_platform_data *pdata;
 
 	/* For devices that use an ADC */
@@ -152,6 +153,7 @@ extern int stmpe_block_read(struct stmpe *stmpe, u8 reg, u8 length,
 extern int stmpe_block_write(struct stmpe *stmpe, u8 reg, u8 length,
 			     const u8 *values);
 extern int stmpe_set_bits(struct stmpe *stmpe, u8 reg, u8 mask, u8 val);
+extern int stmpe_restore_irq_setup(struct stmpe *stmpe);
 extern int stmpe_set_altfunc(struct stmpe *stmpe, u32 pins,
 			     enum stmpe_block block);
 extern int stmpe_enable(struct stmpe *stmpe, unsigned int blocks);
