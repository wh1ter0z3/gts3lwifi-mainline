From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 28 Oct 2026 12:40:55 +0530
Subject: [PATCH] dt-bindings: power: supply: add Silicon Mitus SM5705 charger

The SM5705 charger answers on its own I2C address, separate from the
fuel gauge. The same device also controls the flash LED.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../supply/siliconmitus,sm5705-charger.yaml   | 59 +++++++++++++++++++
 1 file changed, 59 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-charger.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-charger.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-charger.yaml
new file mode 100644
index 0000000000..87b8e4d7b9
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-charger.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5705-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 charger
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  The charger part of the SM5705 charger and fuel gauge IC, a switch mode
+  charger for one Li-ion cell from USB or wireless input. The same I2C
+  device also controls the flash LED.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-charger
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  monitored-battery: true
+
+  extcon:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      The SM5705 MUIC, which reports the USB charger type. The input
+      current limit follows it.
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      charger@49 {
+        compatible = "siliconmitus,sm5705-charger";
+        reg = <0x49>;
+        interrupts-extended = <&tlmm 38 IRQ_TYPE_LEVEL_LOW>;
+        monitored-battery = <&battery>;
+        extcon = <&muic>;
+      };
+    };
