From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Sat, 21 Nov 2026 10:43:05 +0000
Subject: [PATCH 227/230] soc: qcom: ice: ICE v2.1 with the older TrustZone key
 call

MSM8996 has ICE v2.1 (v2.1.44 on an SM-T820), which the driver refused
(v3 and later only), and its TrustZone only has the older key call. Its
enable sequence is the v3 one, and three things differ:

- keys go through qcom_scm_ice_legacy_set_key(), the two halves of the
  AES-256-XTS key separately, with the same big endian words as the
  newer call (found by decrypting blocks ICE had written with fscrypt's
  software implementation: only that word order gives the plaintext);
- the engine starts in global bypass, where data passes unencrypted
  whatever a request asks for: clear ICE_RESET and the bypass bit of
  ICE_CONTROL, and check BYPASS_STATUS, as the downstream driver does;
- invalidating a key works with the usual call; if a TrustZone refuses
  it, the slot is overwritten with a random key instead.

Accept ICE 2.1 and later when the older call is there and the newer one
isn't. 2.0 needs another workaround and isn't covered.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soc/qcom/ice.c | 75 ++++++++++++++++++++++++++++++++++++++----
 1 file changed, 68 insertions(+), 7 deletions(-)

diff --git a/drivers/soc/qcom/ice.c b/drivers/soc/qcom/ice.c
index e256595b9..8a773e2f3 100644
--- a/drivers/soc/qcom/ice.c
+++ b/drivers/soc/qcom/ice.c
@@ -16,6 +16,7 @@
 #include <linux/of.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
+#include <linux/random.h>
 #include <linux/xarray.h>
 
 #include <linux/firmware/qcom/qcom_scm.h>
@@ -39,6 +40,7 @@
 /* QCOM ICE registers */
 
 #define QCOM_ICE_REG_CONTROL			0x0000
+#define QCOM_ICE_REG_RESET			0x0004	/* ICE v2 */
 #define QCOM_ICE_LEGACY_MODE_ENABLED		BIT(0)
 
 #define QCOM_ICE_REG_VERSION			0x0008
@@ -49,6 +51,7 @@
 #define QCOM_ICE_FORCE_HW_KEY1_SETTING_MASK	BIT(2)
 
 #define QCOM_ICE_REG_BIST_STATUS		0x0070
+#define QCOM_ICE_REG_BYPASS_STATUS		0x0074	/* ICE v2 */
 #define QCOM_ICE_BIST_STATUS_MASK		GENMASK(31, 28)
 
 #define QCOM_ICE_REG_ADVANCED_CONTROL		0x1000
@@ -113,6 +116,7 @@ struct qcom_ice {
 	bool use_hwkm;
 	bool hwkm_init_complete;
 	u8 hwkm_version;
+	bool legacy;	/* ICE v2: the older TrustZone key calls */
 };
 
 static DEFINE_XARRAY(ice_handles);
@@ -126,8 +130,11 @@ static bool qcom_ice_check_supported(struct qcom_ice *ice)
 	int minor = FIELD_GET(GENMASK(23, 16), regval);
 	int step = FIELD_GET(GENMASK(15, 0), regval);
 
-	/* Support ICE version 3 and above. */
-	if (major < 3) {
+	/*
+	 * Support ICE version 3 and above, and 2.1 and above with the older
+	 * TrustZone key calls (MSM8996). 2.0 needs more than this driver does.
+	 */
+	if (major < 3 && !(ice->legacy && major == 2 && minor >= 1)) {
 		dev_warn(dev, "Unsupported ICE version: v%d.%d.%d\n",
 			 major, minor, step);
 		return false;
@@ -301,12 +308,37 @@ static void qcom_ice_hwkm_init(struct qcom_ice *ice)
 	ice->hwkm_init_complete = true;
 }
 
+/*
+ * ICE v2 starts in global bypass: data passes through unencrypted whatever a
+ * request asks for. Follow the controller's resets, and leave the bypass.
+ */
+static int qcom_ice_v2_leave_bypass(struct qcom_ice *ice)
+{
+	u32 regval;
+
+	qcom_ice_writel(ice, 0, QCOM_ICE_REG_RESET);
+	regval = qcom_ice_readl(ice, QCOM_ICE_REG_CONTROL);
+	qcom_ice_writel(ice, regval & ~BIT(0), QCOM_ICE_REG_CONTROL);
+
+	if (qcom_ice_readl(ice, QCOM_ICE_REG_BYPASS_STATUS) & BIT(31)) {
+		dev_err(ice->dev, "ICE stays in bypass\n");
+		return -EIO;
+	}
+	return 0;
+}
+
 int qcom_ice_enable(struct qcom_ice *ice)
 {
+	int err;
+
 	qcom_ice_low_power_mode_enable(ice);
 	qcom_ice_optimization_enable(ice);
 	qcom_ice_hwkm_init(ice);
-	return qcom_ice_wait_bist_status(ice);
+	err = qcom_ice_wait_bist_status(ice);
+	if (err || !ice->legacy)
+		return err;
+
+	return qcom_ice_v2_leave_bypass(ice);
 }
 EXPORT_SYMBOL_GPL(qcom_ice_enable);
 
@@ -422,9 +454,16 @@ int qcom_ice_program_key(struct qcom_ice *ice, unsigned int slot,
 	for (i = 0; i < ARRAY_SIZE(key.words); i++)
 		__cpu_to_be32s(&key.words[i]);
 
-	err = qcom_scm_ice_set_key(slot, key.bytes, AES_256_XTS_KEY_SIZE,
-				   QCOM_SCM_ICE_CIPHER_AES_256_XTS,
-				   blk_key->crypto_cfg.data_unit_size / 512);
+	/* The older call takes the two halves separately, words the same way */
+	if (ice->legacy)
+		err = qcom_scm_ice_legacy_set_key(slot, key.bytes,
+						  key.bytes + AES_256_XTS_KEY_SIZE / 2,
+						  AES_256_XTS_KEY_SIZE / 2,
+						  QCOM_SCM_ICE_STORAGE_SDCC);
+	else
+		err = qcom_scm_ice_set_key(slot, key.bytes, AES_256_XTS_KEY_SIZE,
+					   QCOM_SCM_ICE_CIPHER_AES_256_XTS,
+					   blk_key->crypto_cfg.data_unit_size / 512);
 
 	memzero_explicit(&key, sizeof(key));
 
@@ -434,6 +473,26 @@ EXPORT_SYMBOL_GPL(qcom_ice_program_key);
 
 int qcom_ice_evict_key(struct qcom_ice *ice, int slot)
 {
+	if (ice->legacy) {
+		u8 junk[AES_256_XTS_KEY_SIZE];
+		int err = qcom_scm_ice_invalidate_key(slot);
+
+		if (!err)
+			return 0;
+		/*
+		 * The TrustZone of ICE v2 may refuse to invalidate a key slot:
+		 * overwrite it with a random key, so the old one is gone too.
+		 */
+		dev_info_once(ice->dev, "invalidating a key: %d, overwriting it instead\n",
+			      err);
+		get_random_bytes(junk, sizeof(junk));
+		err = qcom_scm_ice_legacy_set_key(slot, junk,
+						  junk + AES_256_XTS_KEY_SIZE / 2,
+						  AES_256_XTS_KEY_SIZE / 2,
+						  QCOM_SCM_ICE_STORAGE_SDCC);
+		memzero_explicit(junk, sizeof(junk));
+		return err;
+	}
 	if (ice->hwkm_init_complete)
 		slot = translate_hwkm_slot(ice, slot);
 	return qcom_scm_ice_invalidate_key(slot);
@@ -568,7 +627,7 @@ static struct qcom_ice *qcom_ice_create(struct device *dev,
 	if (!qcom_scm_is_available())
 		return ERR_PTR(-EPROBE_DEFER);
 
-	if (!qcom_scm_ice_available()) {
+	if (!qcom_scm_ice_available() && !qcom_scm_ice_legacy_available()) {
 		dev_warn(dev, "ICE SCM interface not found\n");
 		return ERR_PTR(-EOPNOTSUPP);
 	}
@@ -577,6 +636,8 @@ static struct qcom_ice *qcom_ice_create(struct device *dev,
 	if (!engine)
 		return ERR_PTR(-ENOMEM);
 
+	engine->legacy = !qcom_scm_ice_available();
+
 	engine->dev = dev;
 	engine->base = base;
 
