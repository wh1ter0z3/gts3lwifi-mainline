From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Mon, 7 Nov 2022 19:40:15 +0300
Subject: [PATCH] arm64: dts: qcom: msm8996-xiaomi-common: Add VBUS power
 supply to DWC3

Add charger OTG regulator as VBUS supply for DWC3.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
index 6fa7a16790..ca43e1b955 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
@@ -410,6 +410,8 @@ &usb3_dwc3 {
 	phys = <&hsusb_phy1>;
 	phy-names = "usb2-phy";
 
+	vbus-supply = <&chg_otg>;
+
 	usb-psy-name = "qcom-smbchg-usb";
 
 	maximum-speed = "high-speed";
