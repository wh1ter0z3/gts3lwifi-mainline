From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Sat, 21 Nov 2026 10:43:05 +0000
Subject: [PATCH 228/230] mmc: sdhci-msm: Inline encryption with ICE v2
 (MSM8996)

The MSM8996 SDCC has neither CQE crypto capability registers nor the
non-CQE crypto registers of newer controllers: with ICE v2, the key
index, data unit size and DUN of a request go into vendor registers of
the host controller (CORE_VENDOR_SPEC_ICE_CTRL_INFO_1..3 at 0x304, one
set per slot, slot 0 without CQE), and requests without a crypto
context set the bypass bit there. The TrustZone keeps key indexes 0 and
1 (full disk encryption) for itself.

Register a blk-crypto profile for "qcom,msm8996-sdhci" with a "qcom,ice"
engine: AES-256-XTS, data units of 512 bytes to 4 KiB, a 64-bit DUN and
30 keyslots (key indexes 2 to 31). As in the downstream driver, the
engine is reset together with the controller (CORE_VENDOR_SPEC_ICE_CTRL);
after a reset it is set up again and gets its keys back before the next
request.

Tested on an SM-T820 with fscrypt on ext4 (inlinecrypt), with the
default and the IV_INO_LBLK_64 policies: "AES-256-XTS using blk-crypto
(native)", no plaintext of the files left on the eMMC, files written
through ICE read correctly with fscrypt's software implementation and
the other way round, keys still good after suspend and resume, and data
without encryption (the bypass) byte for byte the same as before.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mmc/host/sdhci-msm.c | 147 +++++++++++++++++++++++++++++++++--
 1 file changed, 141 insertions(+), 6 deletions(-)

diff --git a/drivers/mmc/host/sdhci-msm.c b/drivers/mmc/host/sdhci-msm.c
index 4aff965f0..bca24f309 100644
--- a/drivers/mmc/host/sdhci-msm.c
+++ b/drivers/mmc/host/sdhci-msm.c
@@ -165,6 +165,21 @@
 #define CRYPTO_GENERAL_ENABLE		BIT(1)
 #define HC_VENDOR_SPECIFIC_FUNC4	0x260
 
+/*
+ * ICE v2 (MSM8996): the settings of each request go into vendor registers of
+ * the host controller, one set per slot (slot 0 without CQE).
+ */
+#define CORE_VENDOR_SPEC_ICE_CTRL		0x300
+#define CORE_VENDOR_SPEC_ICE_CTRL_INFO_1_n	0x304	/* DUN, low word */
+#define CORE_VENDOR_SPEC_ICE_CTRL_INFO_2_n	0x308	/* DUN, high word */
+#define CORE_VENDOR_SPEC_ICE_CTRL_INFO_3_n	0x30c
+#define ICE_CTRL_INFO_BYPASS			BIT(0)
+#define ICE_CTRL_INFO_KEY_INDEX			GENMASK(5, 1)
+#define ICE_CTRL_INFO_CDU			GENMASK(8, 6)	/* log2(DUS) - 9 */
+/* TrustZone keeps key indexes 0 and 1 (full disk encryption) for itself */
+#define ICE_V2_FIRST_KEY_INDEX			2
+#define ICE_V2_NUM_KEYSLOTS			30
+
 #define ICE_HCI_PARAM_CCI	GENMASK(7, 0)
 #define ICE_HCI_PARAM_CE	GENMASK(8, 8)
 
@@ -312,6 +327,8 @@ struct sdhci_msm_host {
 	u32 ddr_config;
 	bool vqmmc_enabled;
 	bool non_cqe_ice_init_done;
+	bool ice_v2;		/* MSM8996: ICE v2, its vendor registers */
+	bool ice_v2_enabled;	/* ICE set up since the last reset */
 };
 
 static const struct sdhci_msm_offset *sdhci_priv_msm_offset(struct sdhci_host *host)
@@ -2006,6 +2023,9 @@ static int sdhci_msm_ice_keyslot_program(struct blk_crypto_profile *profile,
 	struct sdhci_msm_host *msm_host =
 		sdhci_msm_host_from_crypto_profile(profile);
 
+	if (msm_host->ice_v2)
+		slot += ICE_V2_FIRST_KEY_INDEX;
+
 	return qcom_ice_program_key(msm_host->ice, slot, key);
 }
 
@@ -2016,6 +2036,9 @@ static int sdhci_msm_ice_keyslot_evict(struct blk_crypto_profile *profile,
 	struct sdhci_msm_host *msm_host =
 		sdhci_msm_host_from_crypto_profile(profile);
 
+	if (msm_host->ice_v2)
+		slot += ICE_V2_FIRST_KEY_INDEX;
+
 	return qcom_ice_evict_key(msm_host->ice, slot);
 }
 
@@ -2106,17 +2129,107 @@ static void sdhci_msm_ice_cfg(struct sdhci_host *host, struct mmc_request *mrq)
  * Configures ICE registers before passing the request to
  * the standard SDHCI handler.
  */
+/*
+ * ICE v2: a request's key index, data unit size and DUN go into the vendor
+ * registers of slot 0; without a crypto context the engine is bypassed. A
+ * reset of the host controller resets the engine too (sdhci_msm_reset()):
+ * it is set up again and gets its keys back before the next request.
+ */
+static void sdhci_msm_ice_v2_cfg(struct sdhci_host *host,
+				 struct mmc_request *mrq)
+{
+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+	struct sdhci_msm_host *msm_host = sdhci_pltfm_priv(pltfm_host);
+	const struct bio_crypt_ctx *bc = mrq->crypto_ctx;
+	u32 info = ICE_CTRL_INFO_BYPASS;
+	u64 dun = 0;
+
+	if (!msm_host->ice_v2_enabled) {
+		if (qcom_ice_enable(msm_host->ice))
+			dev_err_ratelimited(mmc_dev(host->mmc),
+					    "ICE didn't start after a reset\n");
+		else
+			blk_crypto_reprogram_all_keys(&host->mmc->crypto_profile);
+		msm_host->ice_v2_enabled = true;
+	}
+
+	if (bc) {
+		info = FIELD_PREP(ICE_CTRL_INFO_KEY_INDEX,
+				  mrq->crypto_key_slot + ICE_V2_FIRST_KEY_INDEX) |
+		       FIELD_PREP(ICE_CTRL_INFO_CDU,
+				  ilog2(bc->bc_key->crypto_cfg.data_unit_size) - 9);
+		dun = bc->bc_dun[0];
+	}
+
+	sdhci_writel(host, lower_32_bits(dun), CORE_VENDOR_SPEC_ICE_CTRL_INFO_1_n);
+	sdhci_writel(host, upper_32_bits(dun), CORE_VENDOR_SPEC_ICE_CTRL_INFO_2_n);
+	sdhci_writel(host, info, CORE_VENDOR_SPEC_ICE_CTRL_INFO_3_n);
+
+	/* Ensure crypto configuration is written before proceeding */
+	wmb();
+}
+
 static void sdhci_msm_request(struct mmc_host *mmc, struct mmc_request *mrq)
 {
 	struct sdhci_host *host = mmc_priv(mmc);
+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+	struct sdhci_msm_host *msm_host = sdhci_pltfm_priv(pltfm_host);
 
 	/* Only need to handle non-CQE crypto requests in this path */
-	if (mmc->caps2 & MMC_CAP2_CRYPTO)
-		sdhci_msm_ice_cfg(host, mrq);
+	if (mmc->caps2 & MMC_CAP2_CRYPTO) {
+		if (msm_host->ice_v2)
+			sdhci_msm_ice_v2_cfg(host, mrq);
+		else
+			sdhci_msm_ice_cfg(host, mrq);
+	}
 
 	sdhci_request(mmc, mrq);
 }
 
+/*
+ * ICE v2 (MSM8996): no CQE crypto capability registers to read. The engine
+ * takes AES-256-XTS with data units of 512 bytes to 64 KiB (up to the page
+ * size here) and a 64-bit DUN, in key indexes 2 to 31.
+ */
+static int sdhci_msm_ice_v2_init(struct sdhci_msm_host *msm_host)
+{
+	struct mmc_host *mmc = msm_host->mmc;
+	struct blk_crypto_profile *profile = &mmc->crypto_profile;
+	struct device *dev = mmc_dev(mmc);
+	struct qcom_ice *ice;
+	int err;
+
+	if (!of_device_is_compatible(dev->of_node, "qcom,msm8996-sdhci") ||
+	    !of_property_present(dev->of_node, "qcom,ice"))
+		return 0;
+
+	ice = devm_of_qcom_ice_get(dev);
+	if (IS_ERR(ice)) {
+		if (ice != ERR_PTR(-EOPNOTSUPP))
+			return PTR_ERR(ice);
+
+		dev_warn(dev, "Disabling inline encryption support\n");
+		return 0;
+	}
+
+	err = devm_blk_crypto_profile_init(dev, profile, ICE_V2_NUM_KEYSLOTS);
+	if (err)
+		return err;
+
+	msm_host->ice = ice;
+	msm_host->ice_v2 = true;
+
+	profile->ll_ops = sdhci_msm_crypto_ops;
+	profile->max_dun_bytes_supported = 8;
+	profile->key_types_supported = qcom_ice_get_supported_key_type(ice);
+	profile->dev = dev;
+	profile->modes_supported[BLK_ENCRYPTION_MODE_AES_256_XTS] =
+		512 | 1024 | 2048 | 4096 | (PAGE_SIZE <= SZ_64K ? PAGE_SIZE : 0);
+
+	mmc->caps2 |= MMC_CAP2_CRYPTO;
+	return 0;
+}
+
 static const struct blk_crypto_ll_ops sdhci_msm_crypto_ops = {
 	.keyslot_program	= sdhci_msm_ice_keyslot_program,
 	.keyslot_evict		= sdhci_msm_ice_keyslot_evict,
@@ -2138,6 +2251,11 @@ static inline void sdhci_msm_ice_enable(struct sdhci_msm_host *msm_host)
 {
 }
 
+static inline int sdhci_msm_ice_v2_init(struct sdhci_msm_host *msm_host)
+{
+	return 0;
+}
+
 static inline int
 sdhci_msm_ice_resume(struct sdhci_msm_host *msm_host)
 {
@@ -2561,8 +2679,22 @@ static const struct of_device_id sdhci_msm_dt_match[] = {
 
 MODULE_DEVICE_TABLE(of, sdhci_msm_dt_match);
 
+/* ICE v2: the engine is reset together with the host controller */
+static void sdhci_msm_reset(struct sdhci_host *host, u8 mask)
+{
+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+	struct sdhci_msm_host *msm_host = sdhci_pltfm_priv(pltfm_host);
+
+	if (msm_host->ice_v2) {
+		sdhci_writel(host, 1, CORE_VENDOR_SPEC_ICE_CTRL);
+		msm_host->ice_v2_enabled = false;
+	}
+
+	sdhci_and_cqhci_reset(host, mask);
+}
+
 static const struct sdhci_ops sdhci_msm_ops = {
-	.reset = sdhci_and_cqhci_reset,
+	.reset = sdhci_msm_reset,
 	.set_clock = sdhci_msm_set_clock,
 	.get_min_clock = sdhci_msm_get_min_clock,
 	.get_max_clock = sdhci_msm_get_max_clock,
@@ -2885,10 +3017,13 @@ static int sdhci_msm_probe(struct platform_device *pdev)
 	host->mmc_host_ops.start_signal_voltage_switch =
 		sdhci_msm_start_signal_voltage_switch;
 	host->mmc_host_ops.execute_tuning = sdhci_msm_execute_tuning;
-	if (of_property_read_bool(node, "supports-cqe"))
+	if (of_property_read_bool(node, "supports-cqe")) {
 		ret = sdhci_msm_cqe_add_host(host, pdev);
-	else
-		ret = sdhci_add_host(host);
+	} else {
+		ret = sdhci_msm_ice_v2_init(msm_host);
+		if (!ret)
+			ret = sdhci_add_host(host);
+	}
 	if (ret)
 		goto pm_runtime_disable;
 
