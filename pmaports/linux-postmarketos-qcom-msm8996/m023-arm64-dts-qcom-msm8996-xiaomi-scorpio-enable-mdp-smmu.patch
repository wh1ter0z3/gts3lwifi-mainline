From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Fri, 3 Sep 2021 17:06:06 +0400
Subject: [PATCH] arm64: dts: qcom: msm8996-xiaomi-scorpio: Enable MDP SMMU

qcom,no-smr-check and qcom,skip-init prevent crashing. Add them
and enable mdp_smmu.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 .../boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts  | 16 +++++++---------
 1 file changed, 7 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
index 154c7e269b..44407e6bcf 100644
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
@@ -32,7 +32,7 @@ framebuffer0: framebuffer@83401000 {
 			stride = <(1080 * 3)>;
 			format = "r8g8b8";
 
-			/* DSI0 and MDP SMMU clocks */
+			/* DSI0 clocks */
 			clocks = <&mmcc MDSS_MDP_CLK>,
 				 <&mmcc MMSS_MMAGIC_AHB_CLK>,
 				 <&mmcc MDSS_AHB_CLK>,
@@ -40,9 +40,7 @@ framebuffer0: framebuffer@83401000 {
 				 <&mmcc MMSS_MISC_AHB_CLK>,
 				 <&mmcc MDSS_BYTE0_CLK>,
 				 <&mmcc MDSS_PCLK0_CLK>,
-				 <&mmcc MDSS_ESC0_CLK>,
-				 <&mmcc SMMU_MDP_AHB_CLK>,
-				 <&mmcc SMMU_MDP_AXI_CLK>;
+				 <&mmcc MDSS_ESC0_CLK>;
 
 			/* MDSS power domain */
 			power-domains = <&mmcc MDSS_GDSC>;
@@ -97,16 +95,16 @@ &gpu_zap_shader {
 
 &mdp_smmu {
 	/*
-	 * Probing this SMMU causes a crash due to writing to some secure
-	 * registers. Disable it for now.
+	 * These are required to avoid crashing
 	 */
-	status = "disabled";
+	qcom,no-smr-check;
+	qcom,skip-init;
 };
 
 &mdss {
 	/*
-	 * MDSS depends on the MDP SMMU, and probing it alters the bootloader
-	 * configured framebuffer used by simplefb. Disable it for now.
+	 * Probing MDSS alters the bootloader configured framebuffer used by
+	 * simplefb. Disable it for now.
 	 */
 	status = "disabled";
 };
