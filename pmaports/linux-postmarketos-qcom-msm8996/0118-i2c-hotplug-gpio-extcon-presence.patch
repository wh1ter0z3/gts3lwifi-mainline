From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Sun, 1 Nov 2026 00:05:41 -0600
Subject: [PATCH] i2c: muxes: i2c-hotplug-gpio: Support presence reported by
 extcon

The Book Cover Keyboard of the Samsung Galaxy Tab S3 sits on the pogo
pins with no presence GPIO; the SM5705 MUIC recognises it by the 49.9
kOhm on the ID pin, and its extcon driver reports it as a dock. Add the
"i2c-hotplug-extcon" compatible: the bus is there while the extcon
device reports EXTCON_DOCK.

The extcon notifier runs in the extcon driver's detection path, and
adding the adapter probes the accessory's devices, which can wait for a
supply to ramp up (100 ms for this keyboard), so a work item adds or
removes the adapter after reading the current state. The work is
queued once at probe for an accessory that is attached already. On
removal the notifier goes first, then the work, then the adapter.

The GPIO and interrupt are now only looked up for "i2c-hotplug-gpio".

Signed-off-by: Jayden Milne <linux@jayd.ml>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/i2c/muxes/Kconfig            |  6 +-
 drivers/i2c/muxes/i2c-hotplug-gpio.c | 90 +++++++++++++++++++++++++---
 2 files changed, 87 insertions(+), 9 deletions(-)

diff --git a/drivers/i2c/muxes/Kconfig b/drivers/i2c/muxes/Kconfig
index 0e410be5ce55..e15713a4cc5c 100644
--- a/drivers/i2c/muxes/Kconfig
+++ b/drivers/i2c/muxes/Kconfig
@@ -20,12 +20,14 @@ config I2C_ARB_GPIO_CHALLENGE
 	  will be called i2c-arb-gpio-challenge.
 
 config I2C_HOTPLUG_GPIO
-	tristate "Hot-plugged I2C bus detected by GPIO"
+	tristate "Hot-plugged I2C bus detected by GPIO or extcon"
 	depends on GPIOLIB
 	depends on OF
+	depends on EXTCON || !EXTCON
 	help
 	  Say Y here if you want support for hot-plugging I2C devices
-	  with presence detected by GPIO pin value.
+	  with presence detected by GPIO pin value, or reported as a dock
+	  by an extcon device.
 
 	  This driver can also be built as a module. If so, the module
 	  will be called i2c-hotplug-gpio.
diff --git a/drivers/i2c/muxes/i2c-hotplug-gpio.c b/drivers/i2c/muxes/i2c-hotplug-gpio.c
index 9688d1be9242..ae6f0de7e888 100644
--- a/drivers/i2c/muxes/i2c-hotplug-gpio.c
+++ b/drivers/i2c/muxes/i2c-hotplug-gpio.c
@@ -1,12 +1,20 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include <linux/delay.h>
+#include <linux/extcon.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/interrupt.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/slab.h>
+#include <linux/workqueue.h>
+
+enum i2c_hotplug_detect {
+	I2C_HOTPLUG_DETECT_GPIO,
+	I2C_HOTPLUG_DETECT_EXTCON,
+};
 
 struct i2c_hotplug_priv {
 	struct i2c_adapter adap;
@@ -14,6 +22,9 @@ struct i2c_hotplug_priv {
 	struct device *dev;
 	struct gpio_desc *gpio;
 	int irq;
+	struct extcon_dev *edev;
+	struct notifier_block nb;
+	struct work_struct work;
 };
 
 static inline struct i2c_adapter *i2c_hotplug_parent(struct i2c_adapter *adap)
@@ -163,6 +174,64 @@ static void wrap_i2c_hotplug_deactivate(void *priv)
 	i2c_hotplug_deactivate(priv);
 }
 
+static void i2c_hotplug_extcon_work(struct work_struct *work)
+{
+	struct i2c_hotplug_priv *priv = container_of(work, struct i2c_hotplug_priv, work);
+
+	if (extcon_get_state(priv->edev, EXTCON_DOCK) > 0)
+		i2c_hotplug_activate(priv);
+	else
+		i2c_hotplug_deactivate(priv);
+}
+
+static int i2c_hotplug_extcon_notify(struct notifier_block *nb,
+				     unsigned long state, void *data)
+{
+	struct i2c_hotplug_priv *priv = container_of(nb, struct i2c_hotplug_priv, nb);
+
+	/*
+	 * This runs in the extcon driver's detection path. Adding the
+	 * adapter probes the accessory's devices, which can wait for their
+	 * supplies to ramp up, so do it from a work item.
+	 */
+	schedule_work(&priv->work);
+
+	return NOTIFY_OK;
+}
+
+static void wrap_cancel_work(void *work)
+{
+	cancel_work_sync(work);
+}
+
+static int i2c_hotplug_extcon_init(struct i2c_hotplug_priv *priv)
+{
+	struct device *dev = priv->dev;
+	int err;
+
+	priv->edev = extcon_get_edev_by_phandle(dev, 0);
+	if (IS_ERR(priv->edev))
+		return dev_err_probe(dev, PTR_ERR(priv->edev),
+				     "failed to get extcon device\n");
+
+	INIT_WORK(&priv->work, i2c_hotplug_extcon_work);
+	err = devm_add_action_or_reset(dev, wrap_cancel_work, &priv->work);
+	if (err)
+		return err;
+
+	priv->nb.notifier_call = i2c_hotplug_extcon_notify;
+	err = devm_extcon_register_notifier(dev, priv->edev, EXTCON_DOCK,
+					    &priv->nb);
+	if (err)
+		return dev_err_probe(dev, err,
+				     "failed to register extcon notifier\n");
+
+	/* the accessory may be attached already */
+	schedule_work(&priv->work);
+
+	return 0;
+}
+
 static int i2c_hotplug_gpio_probe(struct platform_device *pdev)
 {
 	struct device_node *parent_np;
@@ -195,11 +264,6 @@ static int i2c_hotplug_gpio_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
-	priv->gpio = devm_gpiod_get(&pdev->dev, "detect", GPIOD_IN);
-	if (IS_ERR(priv->gpio))
-		return dev_err_probe(&pdev->dev, PTR_ERR(priv->gpio),
-				     "failed to get detect GPIO\n");
-
 	is_i2c = parent->algo->master_xfer;
 	is_smbus = parent->algo->smbus_xfer;
 
@@ -224,6 +288,15 @@ static int i2c_hotplug_gpio_probe(struct platform_device *pdev)
 	if (err)
 		return err;
 
+	if ((uintptr_t)device_get_match_data(&pdev->dev) ==
+	    I2C_HOTPLUG_DETECT_EXTCON)
+		return i2c_hotplug_extcon_init(priv);
+
+	priv->gpio = devm_gpiod_get(&pdev->dev, "detect", GPIOD_IN);
+	if (IS_ERR(priv->gpio))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->gpio),
+				     "failed to get detect GPIO\n");
+
 	priv->irq = platform_get_irq(pdev, 0);
 	if (priv->irq < 0)
 		return dev_err_probe(&pdev->dev, priv->irq,
@@ -243,7 +316,10 @@ static int i2c_hotplug_gpio_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id i2c_hotplug_gpio_of_match[] = {
-	{ .compatible = "i2c-hotplug-gpio" },
+	{ .compatible = "i2c-hotplug-gpio",
+	  .data = (void *)I2C_HOTPLUG_DETECT_GPIO },
+	{ .compatible = "i2c-hotplug-extcon",
+	  .data = (void *)I2C_HOTPLUG_DETECT_EXTCON },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, i2c_hotplug_gpio_of_match);
@@ -258,6 +334,6 @@ static struct platform_driver i2c_hotplug_gpio_driver = {
 
 module_platform_driver(i2c_hotplug_gpio_driver);
 
-MODULE_DESCRIPTION("Hot-plugged I2C bus detected by GPIO");
+MODULE_DESCRIPTION("Hot-plugged I2C bus detected by GPIO or extcon");
 MODULE_AUTHOR("Michał Mirosław <mirq-linux@rere.qmqm.pl>");
 MODULE_LICENSE("GPL");
-- 
2.56.0

