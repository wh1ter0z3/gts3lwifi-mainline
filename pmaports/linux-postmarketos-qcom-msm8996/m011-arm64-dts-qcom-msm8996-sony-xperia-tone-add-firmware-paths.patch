From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Wed, 4 Aug 2021 20:25:13 +0400
Subject: [PATCH] arm64: dts: qcom: msm8996-sony-xperia-tone: Add firmware
 paths

Add firmware-name properties to GPU and Venus to allow for loading
firmware from device-specific paths.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 .../boot/dts/qcom/msm8996-sony-xperia-tone-dora.dts    | 10 ++++++++++
 .../boot/dts/qcom/msm8996-sony-xperia-tone-kagura.dts  | 10 ++++++++++
 .../boot/dts/qcom/msm8996-sony-xperia-tone-keyaki.dts  | 10 ++++++++++
 3 files changed, 30 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-dora.dts b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-dora.dts
index 6374c5f53d..a2eb4af191 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-dora.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-dora.dts
@@ -26,3 +26,13 @@ &usb_detect {
 &usb3_id {
 	id-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
 };
+
+&gpu {
+	zap-shader {
+		firmware-name = "qcom/msm8996/dora/a530_zap.mbn";
+	};
+};
+
+&venus {
+	firmware-name = "qcom/msm8996/dora/venus.mbn";
+};
diff --git a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-kagura.dts b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-kagura.dts
index d3100ddf92..64c58d4560 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-kagura.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-kagura.dts
@@ -14,3 +14,13 @@ / {
 	compatible = "sony,kagura-row", "qcom,msm8996";
 	chassis-type = "handset";
 };
+
+&gpu {
+	zap-shader {
+		firmware-name = "qcom/msm8996/kagura/a530_zap.mbn";
+	};
+};
+
+&venus {
+	firmware-name = "qcom/msm8996/kagura/venus.mbn";
+};
diff --git a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-keyaki.dts b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-keyaki.dts
index 3e5bdaba83..b4ebeea4e2 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-keyaki.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone-keyaki.dts
@@ -25,3 +25,13 @@ &pm8994_l30 {
 	regulator-max-microvolt = <2800000>;
 	regulator-pull-down;
 };
+
+&gpu {
+	zap-shader {
+		firmware-name = "qcom/msm8996/keyaki/a530_zap.mbn";
+	};
+};
+
+&venus {
+	firmware-name = "qcom/msm8996/keyaki/venus.mbn";
+};
