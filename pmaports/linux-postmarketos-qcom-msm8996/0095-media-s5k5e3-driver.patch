+}
+
+static u32 s5k5e3_mbus_code(struct s5k5e3 *s5k5e3)
+{
+	unsigned int index = 0;
+
+	if (s5k5e3->hflip && s5k5e3->hflip->val)
+		index |= S5K5E3_ORIENTATION_HFLIP;
+	if (s5k5e3->vflip && s5k5e3->vflip->val)
+		index |= S5K5E3_ORIENTATION_VFLIP;
+
+	return s5k5e3_mbus_codes[index];
+}
+
+static const struct s5k5e3_mode *
+s5k5e3_find_mode(const struct v4l2_mbus_framefmt *fmt)
+{
+	return v4l2_find_nearest_size(s5k5e3_modes, ARRAY_SIZE(s5k5e3_modes),
+				      width, height, fmt->width, fmt->height);
+}
+
+static int s5k5e3_write_dgain(struct s5k5e3 *s5k5e3, u32 val)
+{
+	int ret = 0;
+
+	cci_write(s5k5e3->regmap, S5K5E3_REG_DGAIN_GR, val, &ret);
+	cci_write(s5k5e3->regmap, S5K5E3_REG_DGAIN_R, val, &ret);
+	cci_write(s5k5e3->regmap, S5K5E3_REG_DGAIN_B, val, &ret);
+	cci_write(s5k5e3->regmap, S5K5E3_REG_DGAIN_GB, val, &ret);
+
+	return ret;
+}
+
+static int s5k5e3_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k5e3 *s5k5e3 = container_of(ctrl->handler, struct s5k5e3,
+					     ctrl_handler);
+	struct v4l2_subdev_state *state;
+	const struct v4l2_mbus_framefmt *fmt;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&s5k5e3->sd);
+	fmt = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Keep the exposure within the new frame length */
+		s64 exposure_max = fmt->height + ctrl->val -
+				   S5K5E3_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(s5k5e3->exposure,
+					       s5k5e3->exposure->minimum,
+					       exposure_max,
+					       s5k5e3->exposure->step,
+					       min(s5k5e3->exposure->default_value,
+						   exposure_max));
+		if (ret)
+			return ret;
+	}
+
+	/* The controls are applied when streaming starts */
+	if (!pm_runtime_get_if_in_use(s5k5e3->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = s5k5e3_write_dgain(s5k5e3, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_FRAME_LENGTH,
+			  fmt->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_ORIENTATION,
+			  (s5k5e3->hflip->val ? S5K5E3_ORIENTATION_HFLIP : 0) |
+			  (s5k5e3->vflip->val ? S5K5E3_ORIENTATION_VFLIP : 0),
+			  &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_TEST_PATTERN, ctrl->val,
+			  &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k5e3->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k5e3_ctrl_ops = {
+	.s_ctrl = s5k5e3_set_ctrl,
+};
+
+static int s5k5e3_init_controls(struct s5k5e3 *s5k5e3)
+{
+	const struct s5k5e3_mode *mode = &s5k5e3_modes[0];
+	struct v4l2_ctrl_handler *hdl = &s5k5e3->ctrl_handler;
+	const struct v4l2_ctrl_ops *ops = &s5k5e3_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank, exposure_max;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(s5k5e3->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(s5k5e3_link_freq_menu) - 1, 0,
+				      s5k5e3_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, S5K5E3_PIXEL_RATE,
+			  S5K5E3_PIXEL_RATE, 1, S5K5E3_PIXEL_RATE);
+
+	hblank = S5K5E3_LINE_LENGTH - mode->width;
+	s5k5e3->hblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5k5e3->hblank)
+		s5k5e3->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k5e3->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK,
+					   mode->vts_min - mode->height,
+					   S5K5E3_VTS_MAX - mode->height, 1,
+					   mode->vts_def - mode->height);
+
+	exposure_max = mode->vts_def - S5K5E3_EXPOSURE_MARGIN;
+	s5k5e3->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					     S5K5E3_EXPOSURE_MIN, exposure_max,
+					     S5K5E3_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K5E3_ANA_GAIN_MIN, S5K5E3_ANA_GAIN_MAX,
+			  S5K5E3_ANA_GAIN_STEP, S5K5E3_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_DIGITAL_GAIN,
+			  S5K5E3_DGTL_GAIN_MIN, S5K5E3_DGTL_GAIN_MAX,
+			  S5K5E3_DGTL_GAIN_STEP, S5K5E3_DGTL_GAIN_DEFAULT);
+
+	s5k5e3->hflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k5e3->hflip)
+		s5k5e3->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k5e3->vflip = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k5e3->vflip)
+		s5k5e3->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k5e3_test_pattern_menu) - 1,
+				     0, 0, s5k5e3_test_pattern_menu);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	s5k5e3->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static void s5k5e3_update_pad_format(struct s5k5e3 *s5k5e3,
+				     const struct s5k5e3_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = s5k5e3_mbus_code(s5k5e3);
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k5e3_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	const struct s5k5e3_mode *mode;
+	int ret;
+
+	mode = s5k5e3_find_mode(v4l2_subdev_state_get_format(state, 0));
+
+	ret = pm_runtime_resume_and_get(s5k5e3->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(s5k5e3->regmap, S5K5E3_REG_PAGE, S5K5E3_PAGE_SFR,
+			NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, s5k5e3_init_regs,
+				  ARRAY_SIZE(s5k5e3_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	/* Let the analog setup settle, as Samsung's camera stack does */
+	fsleep(3000);
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, s5k5e3_common_regs,
+				  ARRAY_SIZE(s5k5e3_common_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, mode->regs, mode->num_regs,
+				  NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(s5k5e3->sd.ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+			S5K5E3_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	/* The flips change the Bayer order */
+	__v4l2_ctrl_grab(s5k5e3->hflip, true);
+	__v4l2_ctrl_grab(s5k5e3->vflip, true);
+
+	return 0;
+
+err_rpm_put:
+	dev_err(s5k5e3->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k5e3->dev);
+	return ret;
+}
+
+static int s5k5e3_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	int ret;
+
+	ret = cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+			S5K5E3_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5k5e3->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(s5k5e3->hflip, false);
+	__v4l2_ctrl_grab(s5k5e3->vflip, false);
+
+	pm_runtime_put_autosuspend(s5k5e3->dev);
+
+	return ret;
+}
+
+static int s5k5e3_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k5e3_mbus_code(to_s5k5e3(sd));
+
+	return 0;
+}
+
+static int s5k5e3_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(s5k5e3_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k5e3_mbus_code(to_s5k5e3(sd)))
+		return -EINVAL;
+
+	fse->min_width = s5k5e3_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k5e3_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k5e3_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	const struct s5k5e3_mode *mode;
+	u32 hblank;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE &&
+	    v4l2_subdev_is_streaming(sd))
+		return -EBUSY;
+
+	mode = s5k5e3_find_mode(&fmt->format);
+	s5k5e3_update_pad_format(s5k5e3, mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	/* Update the blanking limits and go back to the default frame rate */
+	ret = __v4l2_ctrl_modify_range(s5k5e3->vblank,
+				       mode->vts_min - mode->height,
+				       S5K5E3_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_s_ctrl(s5k5e3->vblank, mode->vts_def - mode->height);
+	if (ret)
+		return ret;
+
+	hblank = S5K5E3_LINE_LENGTH - mode->width;
+
+	return __v4l2_ctrl_modify_range(s5k5e3->hblank, hblank, hblank, 1,
+					hblank);
+}
+
+static int s5k5e3_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K5E3_NATIVE_WIDTH;
+		sel->r.height = S5K5E3_NATIVE_HEIGHT;
+		return 0;
+
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = S5K5E3_PIXEL_ARRAY_LEFT;
+		sel->r.top = S5K5E3_PIXEL_ARRAY_TOP;
+		sel->r.width = S5K5E3_PIXEL_ARRAY_WIDTH;
+		sel->r.height = S5K5E3_PIXEL_ARRAY_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k5e3_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5k5e3_modes[0].width,
+			.height = s5k5e3_modes[0].height,
+		},
+	};
+
+	return s5k5e3_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k5e3_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k5e3_pad_ops = {
+	.enum_mbus_code = s5k5e3_enum_mbus_code,
+	.enum_frame_size = s5k5e3_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k5e3_set_pad_format,
+	.get_selection = s5k5e3_get_selection,
+	.enable_streams = s5k5e3_enable_streams,
+	.disable_streams = s5k5e3_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k5e3_subdev_ops = {
+	.video = &s5k5e3_video_ops,
+	.pad = &s5k5e3_pad_ops,
+};
+
+static const struct media_entity_operations s5k5e3_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static const struct v4l2_subdev_internal_ops s5k5e3_internal_ops = {
+	.init_state = s5k5e3_init_state,
+};
+
+static int s5k5e3_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	unsigned int i;
+	int ret;
+
+	/* The supplies come up one at a time, in s5k5e3_supply_names order */
+	for (i = 0; i < ARRAY_SIZE(s5k5e3->supplies); i++) {
+		ret = regulator_enable(s5k5e3->supplies[i].consumer);
+		if (ret) {
+			dev_err(dev, "failed to enable %s: %d\n",
+				s5k5e3->supplies[i].supply, ret);
+			goto err_disable_supplies;
+		}
+		fsleep(1000);
+	}
+
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 0);
+	fsleep(2000);
+
+	ret = clk_prepare_enable(s5k5e3->mclk);
+	if (ret) {
+		dev_err(dev, "failed to enable the clock: %d\n", ret);
+		goto err_reset;
+	}
+	fsleep(5000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+err_disable_supplies:
+	while (i--)
+		regulator_disable(s5k5e3->supplies[i].consumer);
+
+	return ret;
+}
+
+static int s5k5e3_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s5k5e3->mclk);
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+
+	for (i = ARRAY_SIZE(s5k5e3->supplies); i-- > 0;)
+		regulator_disable(s5k5e3->supplies[i].consumer);
+
+	return 0;
+}
+
+static int s5k5e3_identify(struct s5k5e3 *s5k5e3)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(s5k5e3->regmap, S5K5E3_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to read the chip id\n");
+
+	if (id != S5K5E3_CHIP_ID)
+		return dev_err_probe(s5k5e3->dev, -ENODEV,
+				     "unexpected chip id %#06llx\n", id);
+
+	return 0;
+}
+
+static int s5k5e3_check_hwcfg(struct s5k5e3 *s5k5e3)
+{
+	struct v4l2_fwnode_endpoint ep = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(s5k5e3->dev),
+						   0, 0, 0);
+	if (!endpoint)
+		return dev_err_probe(s5k5e3->dev, -EINVAL,
+				     "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to parse the endpoint\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != S5K5E3_DATA_LANES) {
+		ret = dev_err_probe(s5k5e3->dev, -EINVAL,
+				    "%u data lanes are not supported\n",
+				    ep.bus.mipi_csi2.num_data_lanes);
+		goto out_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k5e3->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       s5k5e3_link_freq_menu,
+				       ARRAY_SIZE(s5k5e3_link_freq_menu),
+				       &link_freq_bitmap);
+
+out_free:
+	v4l2_fwnode_endpoint_free(&ep);
+	return ret;
+}
+
+static int s5k5e3_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k5e3 *s5k5e3;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k5e3 = devm_kzalloc(dev, sizeof(*s5k5e3), GFP_KERNEL);
+	if (!s5k5e3)
+		return -ENOMEM;
+
+	s5k5e3->dev = dev;
+	v4l2_i2c_subdev_init(&s5k5e3->sd, client, &s5k5e3_subdev_ops);
+
+	ret = s5k5e3_check_hwcfg(s5k5e3);
+	if (ret)
+		return ret;
+
+	s5k5e3->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k5e3->regmap))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->regmap),
+				     "failed to init CCI\n");
+
+	s5k5e3->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(s5k5e3->mclk))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->mclk),
+				     "failed to get the clock\n");
+
+	freq = clk_get_rate(s5k5e3->mclk);
+	if (freq != S5K5E3_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "clock frequency %lu Hz is not supported\n",
+				     freq);
+
+	s5k5e3->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k5e3->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k5e3->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k5e3->supplies); i++)
+		s5k5e3->supplies[i].supply = s5k5e3_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s5k5e3->supplies),
+				      s5k5e3->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	ret = s5k5e3_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = s5k5e3_identify(s5k5e3);
+	if (ret)
+		goto err_power_off;
+
+	ret = s5k5e3_init_controls(s5k5e3);
+	if (ret)
+		goto err_power_off;
+
+	s5k5e3->sd.internal_ops = &s5k5e3_internal_ops;
+	s5k5e3->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k5e3->sd.entity.ops = &s5k5e3_entity_ops;
+	s5k5e3->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k5e3->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k5e3->sd.entity, 1, &s5k5e3->pad);
+	if (ret)
+		goto err_free_ctrls;
+
+	s5k5e3->sd.state_lock = s5k5e3->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&s5k5e3->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k5e3->sd);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register the subdev\n");
+		goto err_rpm_disable;
+	}
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_rpm_disable:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&s5k5e3->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&s5k5e3->sd.entity);
+err_free_ctrls:
+	v4l2_ctrl_handler_free(&s5k5e3->ctrl_handler);
+err_power_off:
+	s5k5e3_power_off(dev);
+
+	return ret;
+}
+
+static void s5k5e3_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s5k5e3->ctrl_handler);
+
+	pm_runtime_disable(s5k5e3->dev);
+	if (!pm_runtime_status_suspended(s5k5e3->dev)) {
+		s5k5e3_power_off(s5k5e3->dev);
+		pm_runtime_set_suspended(s5k5e3->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(s5k5e3_pm_ops, s5k5e3_power_off,
+				 s5k5e3_power_on, NULL);
+
+static const struct of_device_id s5k5e3_of_match[] = {
+	{ .compatible = "samsung,s5k5e3" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k5e3_of_match);
+
+static struct i2c_driver s5k5e3_driver = {
+	.driver = {
+		.name = "s5k5e3",
+		.of_match_table = s5k5e3_of_match,
+		.pm = pm_ptr(&s5k5e3_pm_ops),
+	},
+	.probe = s5k5e3_probe,
+	.remove = s5k5e3_remove,
+};
+module_i2c_driver(s5k5e3_driver);
+
+MODULE_AUTHOR("Jayden Milne <linux@jayd.ml>");
+MODULE_DESCRIPTION("Samsung S5K5E3 image sensor driver");
+MODULE_LICENSE("GPL");
