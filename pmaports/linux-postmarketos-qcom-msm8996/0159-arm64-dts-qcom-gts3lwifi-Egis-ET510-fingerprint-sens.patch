From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Thu, 5 Nov 2026 21:32:10 +0530
Subject: [PATCH] arm64: dts: qcom: gts3lwifi: Egis ET510 fingerprint sensor
 control

The Home key's Egis ET510 sensor sits on BLSP1 QUP6 (TLMM 25-28), which
TrustZone owns and drives through its dualfp app. Describe the part
Linux handles, for the egistec,et5xx-ctrl driver: the sensor's reset
(BTP_RST_N, PM8994 MPP 2) and LDO enable (BTP_LDO_EN, MPP 8) as 1.8 V
outputs, the data-ready interrupt (TLMM 131, pull-up), and the QUP's SPI
and AHB clocks, which the driver runs for the secure world. Wiring from
Samsung's msm8996-sec-gts3llte_fingerprint-sensor_00.dtsi, shared by
both models; the LTE DTS includes this one.

On an SM-T820 the driver binds from this node, /dev/esfp0 and
/sys/class/fingerprint/fingerprint appear, and the power, clock and
reset sequence runs.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../dts/qcom/apq8096-samsung-gts3lwifi.dts    | 40 +++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/apq8096-samsung-gts3lwifi.dts b/arch/arm64/boot/dts/qcom/apq8096-samsung-gts3lwifi.dts
index 6d2e14d79..28311de62 100644
--- a/arch/arm64/boot/dts/qcom/apq8096-samsung-gts3lwifi.dts
+++ b/arch/arm64/boot/dts/qcom/apq8096-samsung-gts3lwifi.dts
@@ -45,6 +45,7 @@
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/pinctrl/qcom,pmic-mpp.h>
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
 #include <dt-bindings/sound/qcom,wcd9335.h>
@@ -266,6 +267,26 @@ system_ret: system-ret {
 		};
 	};
 
+	/*
+	 * Egis ET510 fingerprint sensor (Home key). Its SPI bus, BLSP1 QUP6
+	 * on TLMM 25-28, belongs to TrustZone, which drives the sensor from
+	 * the dualfp app; Linux switches the sensor's LDO (BTP_LDO_EN) and
+	 * reset (BTP_RST_N), runs the QUP's clocks for the secure world and
+	 * delivers the data-ready interrupt.
+	 */
+	fingerprint {
+		compatible = "egistec,et5xx-ctrl";
+		egistec,chipid = "ET510";
+		reset-gpios = <&pm8994_mpps 2 GPIO_ACTIVE_HIGH>;
+		ldo-enable-gpios = <&pm8994_mpps 8 GPIO_ACTIVE_HIGH>;
+		drdy-gpios = <&tlmm 131 GPIO_ACTIVE_HIGH>;
+		clocks = <&gcc GCC_BLSP1_QUP6_SPI_APPS_CLK>,
+			 <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		pinctrl-0 = <&fp_drdy_default>, <&fp_ctrl_default>;
+		pinctrl-names = "default";
+	};
+
 	/*
 	 * SM5705 charger and MUIC. Downstream bit-bangs this bus on TLMM 33
 	 * (SDA) / 32 (SCL), which are HDMI DDC pins, not a BLSP pair. The
@@ -1887,6 +1908,16 @@ bt_en_default: bt-en-state {
 	};
 };
 
+&pm8994_mpps {
+	/* Fingerprint BTP_RST_N (MPP 2) and BTP_LDO_EN (MPP 8): 1.8 V outputs, off */
+	fp_ctrl_default: fp-ctrl-default-state {
+		pins = "mpp2", "mpp8";
+		function = "digital";
+		output-low;
+		power-source = <PM8994_MPP_S4>;
+	};
+};
+
 &tlmm {
 	/*
 	 * Pins owned by Samsung's TrustZone. If Linux reads them, the firmware
@@ -2115,6 +2146,15 @@ pogo_kbd_int_default: pogo-kbd-int-default-state {
 		drive-strength = <8>;
 		bias-pull-up;
 	};
+
+	/* Fingerprint data-ready, TLMM 131: input, pull-up */
+	fp_drdy_default: fp-drdy-default-state {
+		pins = "gpio131";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
 };
 
 &{/firmware/scm} {
