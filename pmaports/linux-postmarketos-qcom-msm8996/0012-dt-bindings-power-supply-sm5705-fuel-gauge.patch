From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 28 Oct 2026 12:26:43 +0530
Subject: [PATCH] dt-bindings: power: supply: add Silicon Mitus SM5705 fuel
 gauge

The SM5705 is a charger and fuel gauge IC used in Samsung devices such as
the Galaxy Tab S3. The fuel gauge answers on its own I2C address.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../siliconmitus,sm5705-fuel-gauge.yaml       | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-fuel-gauge.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-fuel-gauge.yaml b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-fuel-gauge.yaml
new file mode 100644
index 0000000000..9b6464e056
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/siliconmitus,sm5705-fuel-gauge.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/siliconmitus,sm5705-fuel-gauge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 fuel gauge
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  The fuel gauge part of the SM5705 charger and fuel gauge IC. It sits on
+  its own I2C address and measures the battery voltage, current and
+  temperature and computes the state of charge.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-fuel-gauge
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: Low state of charge alert
+
+  monitored-battery: true
+
+  power-supplies: true
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      fuel-gauge@71 {
+        compatible = "siliconmitus,sm5705-fuel-gauge";
+        reg = <0x71>;
+        monitored-battery = <&battery>;
+      };
+    };
