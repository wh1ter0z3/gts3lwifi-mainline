From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Mon, 2 Nov 2026 15:13:53 -0700
Subject: [PATCH] ASoC: codecs: wcd-mbhc-v2: Add plug type detection without an
 ADC

wcd-mbhc-v2 tells a headset from headphones by measuring the mic line
with the MBHC ADC. WCD9335 has no such ADC: it has the mechanical
switch, the button FSM and their comparators. WCD_DETECTION_LEGACY
exists but nothing implements it.

With micbias on, the FSM raises a button press when the mic line sits
below the highest button threshold, and HS_COMP_RESULT is set when the
line is above HS_VREF:

  press, no comp:	mic ring tied to ground, headphones
  no press, no comp:	a microphone loads the line, headset
  no press, comp:	nothing loads the line, line out or extension cable

Take a first reading 500 ms after turning on the FSM, then restart the
FSM every 200 ms for three seconds. A restart gives a new press for as
long as the line stays low, which separates headphones from a headset
that was still being pushed in when the first reading was taken. A press
that lasts until the end is a slowly inserted headphone.

The first reading waits that long because the press can be late: 150 to
470 ms after the switch with plain headphones on a Galaxy Tab S3. With
50 ms, 4 of 7 plugs reported a headset for three seconds.

Only a headset has anything left for the FSM to sense, so turn the FSM
off for the rest. Removal comes from the mechanical switch, as with an
ADC.

A codec gets this path by leaving out WCD_MBHC_ADC_EN from its field
table. All current users have it, so nothing changes for them.

The logic follows the path taken without CONFIG_SND_SOC_WCD_MBHC_ADC in
Qualcomm's downstream wcd-mbhc-v2.c. Cross connection and special
headset detection are left out: an OMTP headset reads as headphones and
a headset that needs more than the default micbias reads as line out.
Neither takes away the audio.

Signed-off-by: Jayden Milne <linux@jayd.ml>
Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/codecs/wcd-mbhc-v2.c | 174 +++++++++++++++++++++++++++++++--
 1 file changed, 168 insertions(+), 6 deletions(-)

diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
index bb0c8478a8..bb9ac45a9a 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.c
+++ b/sound/soc/codecs/wcd-mbhc-v2.c
@@ -9,6 +9,7 @@
 #include <linux/printk.h>
 #include <linux/delay.h>
 #include <linux/kernel.h>
+#include <linux/completion.h>
 #include <sound/soc.h>
 #include <sound/jack.h>
 #include "wcd-mbhc-v2.h"
@@ -25,6 +26,8 @@
 #define WCD_MBHC_ADC_HPH_THRESHOLD_MV	75
 #define WCD_MBHC_ADC_MICBIAS_MV		1800
 #define WCD_MBHC_FAKE_INS_RETRY		4
+#define WCD_MBHC_BTN_PRESS_COMPL_MS	500
+#define WCD_MBHC_LEGACY_POLL_MS		200
 
 #define WCD_MBHC_JACK_MASK (SND_JACK_HEADSET | SND_JACK_LINEOUT | \
 			   SND_JACK_MECHANICAL)
@@ -57,12 +60,15 @@ struct wcd_mbhc {
 	struct work_struct mbhc_plug_detect_work;
 	/* Work to correct accessory type */
 	struct work_struct correct_plug_swch;
+	/* Legacy detection: the FSM saw a button press since it was armed */
+	struct completion btn_press_compl;
 	struct mutex lock;
 	int buttons_pressed;
 	u32 hph_status; /* track headhpone status */
 	u8 current_plug;
 	unsigned int swap_thr;
 	bool is_btn_press;
+	bool btn_press_intr;
 	bool in_swch_irq_handler;
 	bool hs_detect_work_stop;
 	bool is_hs_recording;
@@ -510,6 +516,25 @@ static void wcd_mbhc_adc_detect_plug_type(struct wcd_mbhc *mbhc)
 	}
 }
 
+static void wcd_mbhc_legacy_detect_plug_type(struct wcd_mbhc *mbhc)
+{
+	struct snd_soc_component *component = mbhc->component;
+
+	WARN_ON(!mutex_is_locked(&mbhc->lock));
+
+	if (mbhc->mbhc_cb->hph_pull_down_ctrl)
+		mbhc->mbhc_cb->hph_pull_down_ctrl(component, false);
+
+	mbhc->btn_press_intr = false;
+	reinit_completion(&mbhc->btn_press_compl);
+
+	if (mbhc->mbhc_cb->mbhc_micbias_control) {
+		mbhc->mbhc_cb->mbhc_micbias_control(component, MIC_BIAS_2,
+						    MICB_ENABLE);
+		wcd_schedule_hs_detect_plug(mbhc, &mbhc->correct_plug_swch);
+	}
+}
+
 static void mbhc_plug_detect_fn(struct work_struct *work)
 {
 	struct wcd_mbhc *mbhc = container_of(work, struct wcd_mbhc, mbhc_plug_detect_work);
@@ -538,13 +563,26 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 		/* Make sure MASTER_BIAS_CTL is enabled */
 		mbhc->mbhc_cb->mbhc_bias(component, true);
 		mbhc->is_btn_press = false;
-		wcd_mbhc_adc_detect_plug_type(mbhc);
+		if (mbhc->mbhc_detection_logic == WCD_DETECTION_ADC)
+			wcd_mbhc_adc_detect_plug_type(mbhc);
+		else
+			wcd_mbhc_legacy_detect_plug_type(mbhc);
 	} else {
 		/* Disable HW FSM */
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 0);
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_BTN_ISRC_CTL, 0);
 		mbhc->extn_cable_hph_rem = false;
 
+		/*
+		 * The plug may have left before the detection work got to run,
+		 * which leaves its micbias request and pull-down state behind.
+		 */
+		if (mbhc->mbhc_detection_logic == WCD_DETECTION_LEGACY) {
+			wcd_micbias_disable(mbhc);
+			if (mbhc->mbhc_cb->hph_pull_down_ctrl)
+				mbhc->mbhc_cb->hph_pull_down_ctrl(component, true);
+		}
+
 		if (mbhc->current_plug == MBHC_PLUG_TYPE_NONE)
 			goto exit;
 
@@ -569,8 +607,10 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 				mbhc->current_plug);
 			goto exit;
 		}
-		disable_irq_nosync(mbhc->intr_ids->mbhc_hs_rem_intr);
-		disable_irq_nosync(mbhc->intr_ids->mbhc_hs_ins_intr);
+		if (mbhc->mbhc_detection_logic == WCD_DETECTION_ADC) {
+			disable_irq_nosync(mbhc->intr_ids->mbhc_hs_rem_intr);
+			disable_irq_nosync(mbhc->intr_ids->mbhc_hs_ins_intr);
+		}
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_ELECT_DETECTION_TYPE, 1);
 		wcd_mbhc_write_field(mbhc, WCD_MBHC_ELECT_SCHMT_ISRC, 0);
 		wcd_mbhc_report_plug(mbhc, 0, jack_type);
@@ -673,6 +713,8 @@ static irqreturn_t wcd_mbhc_btn_press_handler(int irq, void *data)
 	int mask;
 	unsigned long msec_val;
 
+	complete(&mbhc->btn_press_compl);
+
 	mutex_lock(&mbhc->lock);
 	wcd_cancel_btn_work(mbhc);
 	mbhc->is_btn_press = true;
@@ -686,11 +728,15 @@ static irqreturn_t wcd_mbhc_btn_press_handler(int irq, void *data)
 	if (mbhc->in_swch_irq_handler)
 		goto done;
 
+	mask = wcd_mbhc_get_button_mask(mbhc);
+	/* A mic ring tied to ground reads as the lowest button */
+	if (mask == SND_JACK_BTN_0)
+		mbhc->btn_press_intr = true;
+
 	/* Plug isn't headset, ignore button press */
 	if (mbhc->current_plug != MBHC_PLUG_TYPE_HEADSET)
 		goto done;
 
-	mask = wcd_mbhc_get_button_mask(mbhc);
 	mbhc->buttons_pressed |= mask;
 	if (schedule_delayed_work(&mbhc->mbhc_btn_dwork, msecs_to_jiffies(400)) == 0)
 		WARN(1, "Button pressed twice without release event\n");
@@ -1321,6 +1367,117 @@ static void wcd_correct_swch_plug(struct work_struct *work)
 	pm_runtime_put_autosuspend(component->dev);
 }
 
+static bool wcd_mbhc_legacy_stop(struct wcd_mbhc *mbhc)
+{
+	if (mbhc->hs_detect_work_stop)
+		wcd_micbias_disable(mbhc);
+
+	return mbhc->hs_detect_work_stop;
+}
+
+/*
+ * Plug type detection for codecs without an MBHC ADC. With micbias on, the HW
+ * FSM raises a button press if the mic line is below the highest button
+ * threshold, and HS_COMP_RESULT is set if it is above HS_VREF:
+ *
+ *   press, no comp:		mic ring tied to ground, headphones
+ *   no press, no comp:		a microphone loads the line, headset
+ *   no press, comp:		nothing loads the line, line out or extension
+ *
+ * Restarting the FSM gives a new press as long as the line stays low, which
+ * tells a headphone from a headset that was still being pushed in when the
+ * first reading was taken.
+ */
+static void wcd_correct_swch_plug_legacy(struct work_struct *work)
+{
+	struct wcd_mbhc *mbhc = container_of(work, struct wcd_mbhc, correct_plug_swch);
+	struct snd_soc_component *component = mbhc->component;
+	enum wcd_mbhc_plug_type plug_type = MBHC_PLUG_TYPE_INVALID;
+	unsigned long timeout;
+	bool line_out = false;
+	bool pressed, hs_comp;
+	int ret;
+
+	ret = pm_runtime_get_sync(component->dev);
+	if (ret < 0 && ret != -EACCES) {
+		dev_err_ratelimited(component->dev,
+				    "pm_runtime_get_sync failed in %s, ret %d\n",
+				    __func__, ret);
+		pm_runtime_put_noidle(component->dev);
+		return;
+	}
+
+	wcd_mbhc_write_field(mbhc, WCD_MBHC_BTN_ISRC_CTL, 0);
+	wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 1);
+
+	pressed = wait_for_completion_timeout(&mbhc->btn_press_compl,
+					      msecs_to_jiffies(WCD_MBHC_BTN_PRESS_COMPL_MS));
+	hs_comp = wcd_mbhc_read_field(mbhc, WCD_MBHC_HS_COMP_RESULT);
+
+	if (!hs_comp && !wcd_mbhc_read_field(mbhc, WCD_MBHC_BTN_RESULT))
+		plug_type = pressed ? MBHC_PLUG_TYPE_HEADPHONE : MBHC_PLUG_TYPE_HEADSET;
+
+	if (plug_type != MBHC_PLUG_TYPE_INVALID)
+		wcd_mbhc_find_plug_and_report(mbhc, plug_type);
+
+	timeout = jiffies + msecs_to_jiffies(HS_DETECT_PLUG_TIME_MS);
+	do {
+		if (wcd_mbhc_legacy_stop(mbhc))
+			goto exit;
+
+		if (mbhc->btn_press_intr) {
+			wcd_cancel_btn_work(mbhc);
+			mbhc->btn_press_intr = false;
+		}
+
+		wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 0);
+		wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 1);
+
+		msleep(WCD_MBHC_LEGACY_POLL_MS);
+
+		if (wcd_mbhc_legacy_stop(mbhc))
+			goto exit;
+
+		hs_comp = wcd_mbhc_read_field(mbhc, WCD_MBHC_HS_COMP_RESULT);
+		line_out = hs_comp &&
+			   !wcd_mbhc_read_field(mbhc, WCD_MBHC_HPHL_SCHMT_RESULT) &&
+			   !wcd_mbhc_read_field(mbhc, WCD_MBHC_MIC_SCHMT_RESULT);
+		if (line_out) {
+			plug_type = MBHC_PLUG_TYPE_HIGH_HPH;
+			continue;
+		}
+
+		plug_type = MBHC_PLUG_TYPE_HEADSET;
+		/* A press without a release is not a headset yet */
+		if (mbhc->current_plug != MBHC_PLUG_TYPE_HEADSET && !mbhc->btn_press_intr)
+			wcd_mbhc_find_plug_and_report(mbhc, plug_type);
+	} while (!time_after(jiffies, timeout));
+
+	/* The line stayed low until the end: slow insertion of a headphone */
+	if (!line_out && mbhc->btn_press_intr) {
+		wcd_cancel_btn_work(mbhc);
+		plug_type = MBHC_PLUG_TYPE_HEADPHONE;
+	}
+
+	wcd_mbhc_find_plug_and_report(mbhc, plug_type);
+
+	/*
+	 * Only a headset has anything for the FSM to sense. It runs on the
+	 * current source once micbias goes away, see WCD_EVENT_PRE_MICBIAS_2_OFF.
+	 */
+	if (plug_type != MBHC_PLUG_TYPE_HEADSET) {
+		wcd_mbhc_write_field(mbhc, WCD_MBHC_FSM_EN, 0);
+		wcd_mbhc_write_field(mbhc, WCD_MBHC_BTN_ISRC_CTL, 0);
+	}
+
+	wcd_micbias_disable(mbhc);
+exit:
+	if (mbhc->mbhc_cb->hph_pull_down_ctrl)
+		mbhc->mbhc_cb->hph_pull_down_ctrl(component, true);
+
+	pm_runtime_put_autosuspend(component->dev);
+}
+
 static irqreturn_t wcd_mbhc_adc_hs_rem_irq(int irq, void *data)
 {
 	struct wcd_mbhc *mbhc = data;
@@ -1524,7 +1681,8 @@ struct wcd_mbhc *wcd_mbhc_init(struct snd_soc_component *component,
 	mbhc->intr_ids = intr_ids;
 	mbhc->mbhc_cb = mbhc_cb;
 	mbhc->fields = fields;
-	mbhc->mbhc_detection_logic = WCD_DETECTION_ADC;
+	mbhc->mbhc_detection_logic = fields[WCD_MBHC_ADC_EN].reg ?
+				     WCD_DETECTION_ADC : WCD_DETECTION_LEGACY;
 
 	if (mbhc_cb->compute_impedance)
 		mbhc->impedance_detect = impedance_det_en;
@@ -1532,8 +1690,12 @@ struct wcd_mbhc *wcd_mbhc_init(struct snd_soc_component *component,
 	INIT_DELAYED_WORK(&mbhc->mbhc_btn_dwork, wcd_btn_long_press_fn);
 
 	mutex_init(&mbhc->lock);
+	init_completion(&mbhc->btn_press_compl);
 
-	INIT_WORK(&mbhc->correct_plug_swch, wcd_correct_swch_plug);
+	if (mbhc->mbhc_detection_logic == WCD_DETECTION_ADC)
+		INIT_WORK(&mbhc->correct_plug_swch, wcd_correct_swch_plug);
+	else
+		INIT_WORK(&mbhc->correct_plug_swch, wcd_correct_swch_plug_legacy);
 	INIT_WORK(&mbhc->mbhc_plug_detect_work, mbhc_plug_detect_fn);
 
 	ret = request_threaded_irq(mbhc->intr_ids->mbhc_sw_intr, NULL,
