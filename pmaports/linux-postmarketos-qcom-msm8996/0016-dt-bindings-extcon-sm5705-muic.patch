From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 28 Oct 2026 12:41:12 +0530
Subject: [PATCH] dt-bindings: extcon: add Silicon Mitus SM5705 MUIC

The MUIC of the SM5705 charger and fuel gauge IC answers on its own I2C
address. Its register layout differs from the SM5502 family, so it gets
its own binding.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../extcon/siliconmitus,sm5705-muic.yaml      | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/extcon/siliconmitus,sm5705-muic.yaml

diff --git a/Documentation/devicetree/bindings/extcon/siliconmitus,sm5705-muic.yaml b/Documentation/devicetree/bindings/extcon/siliconmitus,sm5705-muic.yaml
new file mode 100644
index 0000000000..41b23f9cac
--- /dev/null
+++ b/Documentation/devicetree/bindings/extcon/siliconmitus,sm5705-muic.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/extcon/siliconmitus,sm5705-muic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Silicon Mitus SM5705 MUIC
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  The MUIC (micro USB interface controller) of the SM5705 charger and fuel
+  gauge IC. It answers on its own I2C address, detects the USB charger
+  type (BC1.2) and switches the USB data lines. Its registers differ from
+  the SM5502 family.
+
+properties:
+  compatible:
+    const: siliconmitus,sm5705-muic
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      extcon@25 {
+        compatible = "siliconmitus,sm5705-muic";
+        reg = <0x25>;
+        interrupts-extended = <&pm8994_gpios 4 IRQ_TYPE_LEVEL_LOW>;
+      };
+    };
