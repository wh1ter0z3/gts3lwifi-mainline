From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Fri, 16 Oct 2026 11:00:45 +0530
Subject: [PATCH] drm/msm/dsi: bring-up aids: rgb_swap and defer_hs_clk
 parameters

msm.rgb_swap=0..5 chooses the colour component order on the link, to
find the order a panel expects without rebuilding. Default stays RGB.

msm.defer_hs_clk=1 keeps the clock lane in LP-11 after host power-on and
forces it to continuous HS only right before the first command, i.e.
after the panel driver has released the panel reset. That is the order
the vendor driver uses (lanes LP-11 through reset, then clock HS, then
the init commands). Default keeps forcing HS at power-on.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/dsi/dsi.h         |  1 +
 drivers/gpu/drm/msm/dsi/dsi_host.c    | 51 +++++++++++++++++++++++----
 drivers/gpu/drm/msm/dsi/dsi_manager.c | 12 +++++++
 3 files changed, 57 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 2283a460b3..d3c15e5f39 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -63,6 +63,7 @@ void dsi_mgr_power_off(struct msm_dsi *msm_dsi);
 
 /* dsi host */
 struct msm_dsi_host;
+void msm_dsi_host_start_deferred_hs_clk(struct mipi_dsi_host *host);
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 					const struct mipi_dsi_msg *msg);
 void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 5e76c6b2fe..d8abe17ab3 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/module.h>
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
@@ -187,6 +188,7 @@ struct msm_dsi_host {
 	bool registered;
 	bool power_on;
 	bool enabled;
+	bool hs_clk_pending;	/* defer_hs_clk: clock lane not forced to HS yet */
 	int irq;
 };
 
@@ -815,6 +817,21 @@ bool msm_dsi_host_is_wide_bus_enabled(struct mipi_dsi_host *host)
 					MSM_DSI_6G_VER_MINOR_V2_5_0);
 }
 
+/* Bring-up aid: colour component order on the link (0 RGB, 1 RBG, 2 BGR, 3 BRG, 4 GRB, 5 GBR) */
+/*
+ * Bring-up aid: start the continuous HS clock only right before the first
+ * command after power-on, i.e. after the panel driver has released its
+ * reset, like the vendor driver (all lanes LP-11 through the panel reset,
+ * then force the clock lane to HS). Default: force HS at power-on.
+ */
+static bool defer_hs_clk;
+module_param(defer_hs_clk, bool, 0444);
+MODULE_PARM_DESC(defer_hs_clk, "Keep the clock lane in LP-11 until the first command (vendor order)");
+
+static unsigned int rgb_swap = SWAP_RGB;
+module_param(rgb_swap, uint, 0444);
+MODULE_PARM_DESC(rgb_swap, "DSI RGB component order: 0 RGB (default), 1 RBG, 2 BGR, 3 BRG, 4 GRB, 5 GBR");
+
 static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 			struct msm_dsi_phy_shared_timings *phy_shared_timings, struct msm_dsi_phy *phy)
 {
@@ -844,12 +861,10 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 			data |= DSI_VID_CFG0_DATABUS_WIDEN;
 		dsi_write(msm_host, REG_DSI_VID_CFG0, data);
 
-		/* Do not swap RGB colors */
-		data = DSI_VID_CFG1_RGB_SWAP(SWAP_RGB);
-		dsi_write(msm_host, REG_DSI_VID_CFG1, 0);
+		data = DSI_VID_CFG1_RGB_SWAP(rgb_swap);
+		dsi_write(msm_host, REG_DSI_VID_CFG1, data);
 	} else {
-		/* Do not swap RGB colors */
-		data = DSI_CMD_CFG0_RGB_SWAP(SWAP_RGB);
+		data = DSI_CMD_CFG0_RGB_SWAP(rgb_swap);
 		data |= DSI_CMD_CFG0_DST_FORMAT(dsi_get_cmd_fmt(mipi_fmt));
 		dsi_write(msm_host, REG_DSI_CMD_CFG0, data);
 
@@ -924,8 +939,13 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 		if (msm_dsi_phy_set_continuous_clock(phy, true))
 			lane_ctrl &= ~DSI_LANE_CTRL_HS_REQ_SEL_PHY;
 
-		dsi_write(msm_host, REG_DSI_LANE_CTRL,
-			lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+		if (defer_hs_clk) {
+			dsi_write(msm_host, REG_DSI_LANE_CTRL, lane_ctrl);
+			msm_host->hs_clk_pending = true;
+		} else {
+			dsi_write(msm_host, REG_DSI_LANE_CTRL,
+				lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+		}
 	}
 
 	data |= DSI_CTRL_ENABLE;
@@ -2165,6 +2185,22 @@ void msm_dsi_host_unregister(struct mipi_dsi_host *host)
 	}
 }
 
+void msm_dsi_host_start_deferred_hs_clk(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 lane_ctrl;
+
+	if (!msm_host->hs_clk_pending || !msm_host->power_on)
+		return;
+
+	lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
+	dsi_write(msm_host, REG_DSI_LANE_CTRL,
+		  lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+	msm_host->hs_clk_pending = false;
+	pr_info("msm_dsi: DSI%d clock lane forced to HS (deferred start)\n",
+		msm_host->id);
+}
+
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 				const struct mipi_dsi_msg *msg)
 {
@@ -2581,6 +2617,7 @@ int msm_dsi_host_power_off(struct mipi_dsi_host *host)
 	DBG("-");
 
 	msm_host->power_on = false;
+	msm_host->hs_clk_pending = false;
 
 unlock_ret:
 	mutex_unlock(&msm_host->dev_mutex);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 1a37edff07..c1d28ff78d 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -527,6 +527,18 @@ int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 		goto restore_host0;
 	}
 
+	/* msm.defer_hs_clk: start the clock lane HS now, on both links */
+	if (IS_BONDED_DSI()) {
+		struct msm_dsi *d0 = dsi_mgr_get_dsi(DSI_0), *d1 = dsi_mgr_get_dsi(DSI_1);
+
+		if (d0)
+			msm_dsi_host_start_deferred_hs_clk(d0->host);
+		if (d1)
+			msm_dsi_host_start_deferred_hs_clk(d1->host);
+	} else {
+		msm_dsi_host_start_deferred_hs_clk(host);
+	}
+
 	ret = is_read ? msm_dsi_host_cmd_rx(host, msg) :
 			msm_dsi_host_cmd_tx(host, msg);
 
