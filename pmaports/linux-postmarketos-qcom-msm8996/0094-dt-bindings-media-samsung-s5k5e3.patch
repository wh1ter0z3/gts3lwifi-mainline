From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Fri, 30 Oct 2026 13:43:13 -0600
Subject: [PATCH] dt-bindings: media: i2c: Add Samsung S5K5E3 image sensor

Samsung S5K5E3 is a 5 megapixel raw image sensor with a 2-lane MIPI
CSI-2 D-PHY output, used as the front camera of the Samsung Galaxy Tab
S3 among others.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Jayden Milne <linux@jayd.ml>
---
 .../bindings/media/i2c/samsung,s5k5e3.yaml    | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5k5e3.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5k5e3.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5k5e3.yaml
new file mode 100644
index 0000000000..6302ef948a
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5k5e3.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5k5e3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5K5E3 Image Sensor
+
+description:
+  Samsung S5K5E3 is a 5 megapixel image sensor, controlled over a serial
+  camera control bus. The widest output frame size is 2576x1932 at 30
+  frames per second, the data format is RAW10, transferred over a 2-lane
+  MIPI D-PHY interface.
+
+maintainers:
+  - Jayden Milne <linux@jayd.ml>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5k5e3
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to RESET pad of the sensor.
+    maxItems: 1
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+
+        required:
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+      #include <dt-bindings/gpio/gpio.h>
+
+      i2c {
+          #address-cells = <1>;
+          #size-cells = <0>;
+
+          camera@10 {
+              compatible = "samsung,s5k5e3";
+              reg = <0x10>;
+              clocks = <&camera_mclk 2>;
+              assigned-clocks = <&camera_mclk 2>;
+              assigned-clock-rates = <24000000>;
+              reset-gpios = <&gpio1 40 GPIO_ACTIVE_LOW>;
+              vdda-supply = <&vreg_2p8>;
+              vddd-supply = <&vreg_1p2>;
+              vddio-supply = <&vreg_1p8>;
+              orientation = <0>;
+              rotation = <270>;
+
+              port {
+                  endpoint {
+                      data-lanes = <1 2>;
+                      link-frequencies = /bits/ 64 <448000000>;
+                      remote-endpoint = <&mipi_csi2_ep>;
+                  };
+              };
+          };
+      };
+...
