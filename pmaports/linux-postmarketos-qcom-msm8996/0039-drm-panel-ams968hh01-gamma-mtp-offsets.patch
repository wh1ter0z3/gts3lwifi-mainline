From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jaydens-tasty-slop
 <325336397+jaydens-tasty-slop@users.noreply.github.com>
Date: Thu, 29 Oct 2026 07:10:07 -0600
Subject: [PATCH] drm/panel: samsung-ams968hh01: apply the panel's MTP gamma
 offsets

Each panel stores its own gamma offsets (MTP), 33 bytes in register
0x83 order. The vendor driver reads them at the first panel-on through
register D8 from offset 0x5a, and its 360 cd/m2 table is the nominal
table plus these offsets, with any sum above 0xff sent as 0x80. Without
them the mid-tones come out darker than on the stock kernel.

Read the offsets in prepare, before the init sequence, and add them to
the nominal table the same way. The DDI only answers reads at that point
when the DSI clock lane starts after the panel reset (msm.defer_hs_clk=1
on this tree); if the read fails, the nominal table is sent as before
and the read is tried again at the next prepare.

The read command and the way the offsets are applied come from Samsung's
GPL-2.0 kernel source for the SM-T820:
drivers/video/msm/mdss/samsung/ANA38401_AMS968HH01/:
dsi_panel_ANA38401_AMS968HH01_qxga_octa_cmd.dtsi
(samsung,smart_dimming_mtp_rx_cmds_revA),
ss_dsi_panel_ANA38401_AMS968HH01.c and
ss_dsi_smart_dimming_ANA38401_AMS968HH01.c (gamma_command_sorting_post()).

Tested on an SM-T820 with msm.defer_hs_clk=1. The offsets read are

  41 56 5c 49 3f 56 5d 25 02 00 00 4c 58 5d 49 40 56 5d 29 0d 00 00
  46 58 5a 4c 42 56 5e 53 25 00 00

and the table sent matches, byte for byte, the 360 cd/m2 table that the
stock Samsung kernel computes for the same panel (as printed by its
/sys/devices/virtual/lcd/panel/aid_log):

  c1 d6 dc c9 bf d6 dd 25 82 80 00 cc d8 dd c9 c0 d6 dd 29 8d 80 00
  c6 d8 da cc c2 d6 de 53 a5 80 00

Assisted-by: Claude:claude-opus-5-5
---
 .../gpu/drm/panel/panel-samsung-ams968hh01.c  | 55 ++++++++++++++++++-
 1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
index 4fed8bd674..f4fbafa655 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams968hh01.c
@@ -38,6 +38,7 @@ struct ams968hh01 {
 	struct regulator *vdd;
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *tcon_ready_gpio;
+	bool mtp_valid;
 	u8 gamma[1 + AMS968HH01_GAMMA_LEN];	/* register 0x83 and its table */
 };
 
@@ -296,6 +297,52 @@ static void ams968hh01_gamma_init(struct ams968hh01 *ctx)
 		ctx->gamma[1 + i] = ams968hh01_gamma_nominal[i % 11];
 }
 
+/*
+ * The panel's own gamma offsets (MTP): 33 bytes in register 0x83 order,
+ * read the vendor way (B0 <offset>, then a generic read of D8) from
+ * offset 0x5a. The vendor's 360 cd/m2 table is the nominal table plus
+ * these offsets, with any sum above 0xff sent as 0x80
+ * (gamma_command_sorting_post()). The DDI only answers reads before
+ * the init sequence when the link clock starts after the panel reset
+ * (msm.defer_hs_clk=1); without the offsets the nominal table is sent.
+ */
+static int ams968hh01_read_mtp(struct ams968hh01 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi[0];
+	u8 mtp[AMS968HH01_GAMMA_LEN];
+	int i, n, ret;
+
+	ret = mipi_dsi_set_maximum_return_packet_size(dsi, 8);
+	if (ret < 0)
+		return ret;
+
+	for (i = 0; i < sizeof(mtp); i += n) {
+		u8 sel[] = { 0xb0, 0x5a + i };
+		u8 rd[2];
+
+		n = min_t(int, 8, sizeof(mtp) - i);
+		rd[0] = 0xd8;
+		rd[1] = n;
+		ret = mipi_dsi_dcs_write_buffer(dsi, sel, sizeof(sel));
+		if (ret < 0)
+			return ret;
+		ret = mipi_dsi_generic_read(dsi, rd, sizeof(rd), mtp + i, n);
+		if (ret != n)
+			return ret < 0 ? ret : -EIO;
+	}
+
+	for (i = 0; i < sizeof(mtp); i++) {
+		unsigned int v = ams968hh01_gamma_nominal[i % 11] + mtp[i];
+
+		ctx->gamma[1 + i] = v > 0xff ? 0x80 : v;
+	}
+	ctx->mtp_valid = true;
+	dev_info(&dsi->dev, "MTP %*ph\n", (int)sizeof(mtp), mtp);
+	dev_dbg(&dsi->dev, "gamma %*ph\n", AMS968HH01_GAMMA_LEN, ctx->gamma + 1);
+
+	return 0;
+}
+
 static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 {
 	struct ams968hh01 *panel = mipi_dsi_get_drvdata(ctx->dsi);
@@ -315,7 +362,7 @@ static void ams968hh01_init(struct mipi_dsi_multi_context *ctx)
 	mipi_dsi_dcs_write_seq_multi(ctx, 0xb0, 0xbc);
 	ams968hh01_reg(ctx, 0xb2, 0x04);		/* gamma offset index */
 
-	/* brightness condition set (gamma) */
+	/* brightness condition set (gamma), 360 cd/m2 */
 	ams968hh01_reg_write(ctx, panel->gamma, sizeof(panel->gamma));
 
 	ams968hh01_reg(ctx, 0x90, 0x00, 0x00, 0x0e);	/* AID, 360 nit */
@@ -379,6 +426,12 @@ static int ams968hh01_prepare(struct drm_panel *panel)
 	}
 
 	ams968hh01_readback(ctx, "prepare, before init");
+	if (!ctx->mtp_valid) {
+		ret = ams968hh01_read_mtp(ctx);
+		if (ret)
+			dev_warn(panel->dev, "MTP read failed (%d), using the nominal gamma table\n",
+				 ret);
+	}
 	if (init_in_enable)
 		return 0;
 
