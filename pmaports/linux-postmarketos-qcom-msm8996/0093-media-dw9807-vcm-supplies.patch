From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Fri, 30 Oct 2026 13:30:52 -0600
Subject: [PATCH] media: i2c: dw9807-vcm: power the device from its supplies

Get the vdd and vio supplies and switch them with runtime PM, as the
ak7375 driver does: resume enables them, waits for the device to come up
and only then leaves the power-down state; suspend parks the lens,
enters power-down and then disables them.

The driver marks the device active at probe without having powered it.
Track whether the supplies are on, so that the first runtime suspend
and a system suspend of an already suspended device do not disable
supplies that were never enabled.

Boards without the supplies in their firmware get dummy regulators and
behave as before.

Signed-off-by: Jayden Milne <linux@jayd.ml>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/i2c/dw9807-vcm.c | 45 ++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/drivers/media/i2c/dw9807-vcm.c b/drivers/media/i2c/dw9807-vcm.c
index 4148009e0e..ff0d829095 100644
--- a/drivers/media/i2c/dw9807-vcm.c
+++ b/drivers/media/i2c/dw9807-vcm.c
@@ -7,6 +7,7 @@
 #include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 
@@ -24,6 +25,8 @@
  */
 #define DW9807_CTRL_STEPS	16
 #define DW9807_CTRL_DELAY_US	1000
+/* Time to wait after the supplies are switched on */
+#define DW9807_POWER_DELAY_US	2000
 
 #define DW9807_CTL_ADDR		0x02
 /*
@@ -38,10 +41,17 @@
 
 #define MAX_RETRY		10
 
+static const char * const dw9807_supply_names[] = {
+	"vdd",
+	"vio",
+};
+
 struct dw9807_device {
 	struct v4l2_ctrl_handler ctrls_vcm;
 	struct v4l2_subdev sd;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(dw9807_supply_names)];
 	u16 current_val;
+	bool active;
 };
 
 static inline struct dw9807_device *sd_to_dw9807_vcm(
@@ -178,6 +188,7 @@ static int dw9807_init_controls(struct dw9807_device *dev_vcm)
 static int dw9807_probe(struct i2c_client *client)
 {
 	struct dw9807_device *dw9807_dev;
+	unsigned int i;
 	int rval;
 
 	dw9807_dev = devm_kzalloc(&client->dev, sizeof(*dw9807_dev),
@@ -185,6 +196,16 @@ static int dw9807_probe(struct i2c_client *client)
 	if (dw9807_dev == NULL)
 		return -ENOMEM;
 
+	for (i = 0; i < ARRAY_SIZE(dw9807_supply_names); i++)
+		dw9807_dev->supplies[i].supply = dw9807_supply_names[i];
+
+	rval = devm_regulator_bulk_get(&client->dev,
+				       ARRAY_SIZE(dw9807_supply_names),
+				       dw9807_dev->supplies);
+	if (rval)
+		return dev_err_probe(&client->dev, rval,
+				     "failed to get regulators\n");
+
 	v4l2_i2c_subdev_init(&dw9807_dev->sd, client, &dw9807_ops);
 	dw9807_dev->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	dw9807_dev->sd.internal_ops = &dw9807_int_ops;
@@ -239,6 +260,9 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 	const char tx_data[2] = { DW9807_CTL_ADDR, 0x01 };
 	int ret, val;
 
+	if (!dw9807_dev->active)
+		return 0;
+
 	for (val = dw9807_dev->current_val & ~(DW9807_CTRL_STEPS - 1);
 	     val >= 0; val -= DW9807_CTRL_STEPS) {
 		ret = dw9807_set_dac(client, val);
@@ -254,6 +278,13 @@ static int __maybe_unused dw9807_vcm_suspend(struct device *dev)
 		return ret;
 	}
 
+	ret = regulator_bulk_disable(ARRAY_SIZE(dw9807_supply_names),
+				     dw9807_dev->supplies);
+	if (ret)
+		return ret;
+
+	dw9807_dev->active = false;
+
 	return 0;
 }
 
@@ -271,10 +302,22 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 	const char tx_data[2] = { DW9807_CTL_ADDR, 0x00 };
 	int ret, val;
 
+	if (dw9807_dev->active)
+		return 0;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(dw9807_supply_names),
+				    dw9807_dev->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(DW9807_POWER_DELAY_US, DW9807_POWER_DELAY_US + 500);
+
 	/* Power on */
 	ret = i2c_master_send(client, tx_data, sizeof(tx_data));
 	if (ret < 0) {
 		dev_err(&client->dev, "I2C write CTL fail ret = %d\n", ret);
+		regulator_bulk_disable(ARRAY_SIZE(dw9807_supply_names),
+				       dw9807_dev->supplies);
 		return ret;
 	}
 
@@ -288,6 +331,8 @@ static int  __maybe_unused dw9807_vcm_resume(struct device *dev)
 		usleep_range(DW9807_CTRL_DELAY_US, DW9807_CTRL_DELAY_US + 10);
 	}
 
+	dw9807_dev->active = true;
+
 	return 0;
 }
 
