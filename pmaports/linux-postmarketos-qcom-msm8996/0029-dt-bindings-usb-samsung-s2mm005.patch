From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 28 Oct 2026 20:58:12 +0530
Subject: [PATCH] dt-bindings: usb: add Samsung S2MM005 Type-C and PD
 controller

The S2MM005 is a USB Type-C port controller with a USB Power Delivery
policy engine in its own firmware, used in Samsung's 2017 phones and
tablets. The host reads the attach state and the negotiated contract over
I2C; an open-drain line signals pending events.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/usb/samsung,s2mm005.yaml         | 61 +++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/samsung,s2mm005.yaml

diff --git a/Documentation/devicetree/bindings/usb/samsung,s2mm005.yaml b/Documentation/devicetree/bindings/usb/samsung,s2mm005.yaml
new file mode 100644
index 0000000000..16e446fbd9
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/samsung,s2mm005.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/samsung,s2mm005.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MM005 USB Type-C and Power Delivery controller
+
+maintainers:
+  - psigod <psigod@example.com>
+
+description:
+  The S2MM005 is a USB Type-C port controller with a USB Power Delivery
+  policy engine running in its own firmware, controlled over I2C. As a sink
+  it negotiates a power contract with the source by itself; the host reads
+  the attach state and the contract. It raises its open-drain interrupt line
+  while an event is pending.
+
+properties:
+  compatible:
+    const: samsung,s2mm005
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        typec@33 {
+            compatible = "samsung,s2mm005";
+            reg = <0x33>;
+            interrupts-extended = <&tlmm 73 IRQ_TYPE_LEVEL_LOW>;
+
+            connector {
+                compatible = "usb-c-connector";
+                label = "USB-C";
+                power-role = "sink";
+                data-role = "device";
+            };
+        };
+    };
