 static const struct wacom_w9000_variant w9007a_v1 = {
 	.cmd_query_num	= 9,
 	.msg_coord_num	= 12,
+	.has_distance	= true,
 	.name = "Wacom W9007A V1 Digitizer",
 };
 
+static const struct wacom_w9000_variant w9019 = {
+	.cmd_query_num	= 15,
+	.msg_coord_num	= 14,
+	.special_packet_byte = 12,
+	.query_delay_ms = 100,
+	.power_off_delay_us = 10000,
