From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Mon, 19 Oct 2026 11:10:51 +0530
Subject: [PATCH] drm/msm: add a debugfs trigger for the DSI test pattern
 generator

msm_dsi_manager_tpg_enable() exists but nothing calls it. Expose it as
/sys/kernel/debug/dri/N/dsi_tpg (write-only): the DSI hosts then stream
their built-in test pattern, bypassing the display engine, which tells a
DSI/panel problem apart from an MDP one during bring-up.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/msm_debugfs.c | 24 ++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_drv.h     |  4 ++++
 2 files changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/msm/msm_debugfs.c b/drivers/gpu/drm/msm/msm_debugfs.c
index f12701e286..72fee71c0f 100644
--- a/drivers/gpu/drm/msm/msm_debugfs.c
+++ b/drivers/gpu/drm/msm/msm_debugfs.c
@@ -210,6 +210,28 @@ static const struct file_operations msm_kms_fops = {
 	.release = msm_kms_release,
 };
 
+/*
+ * Bring-up aid: writing anything to "dsi_tpg" switches the DSI hosts to
+ * their built-in test pattern generator, which bypasses the display
+ * engine. Tells a DSI/panel problem apart from an MDP one.
+ */
+static ssize_t msm_dsi_tpg_write(struct file *file, const char __user *buf,
+				 size_t len, loff_t *ppos)
+{
+	struct drm_device *dev = file_inode(file)->i_private;
+
+	DRM_DEV_INFO(dev->dev, "enabling DSI test pattern generator\n");
+	msm_dsi_manager_tpg_enable();
+	return len;
+}
+
+static const struct file_operations msm_dsi_tpg_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = msm_dsi_tpg_write,
+	.llseek = default_llseek,
+};
+
 static void msm_debugfs_kms_init(struct drm_minor *minor)
 {
 	struct drm_device *dev = minor->dev;
@@ -220,6 +242,8 @@ static void msm_debugfs_kms_init(struct drm_minor *minor)
 				 minor->debugfs_root, minor);
 	debugfs_create_file("kms", 0400, minor->debugfs_root,
 			    dev, &msm_kms_fops);
+	debugfs_create_file("dsi_tpg", 0200, minor->debugfs_root,
+			    dev, &msm_dsi_tpg_fops);
 
 	if (priv->kms->funcs->debugfs_init)
 		priv->kms->funcs->debugfs_init(priv->kms, minor);
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index eb4bbae855..dc131ea3ca 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -299,6 +299,7 @@ int msm_dsi_modeset_init(struct msm_dsi *msm_dsi, struct drm_device *dev,
 void msm_dsi_snapshot(struct msm_disp_state *disp_state, struct msm_dsi *msm_dsi);
 bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi);
 bool msm_dsi_is_bonded_dsi(struct msm_dsi *msm_dsi);
+void msm_dsi_manager_tpg_enable(void);
 bool msm_dsi_is_master_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_wide_bus_enabled(struct msm_dsi *msm_dsi);
 struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_dsi);
@@ -323,6 +324,9 @@ static inline bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi)
 {
 	return false;
 }
+static inline void msm_dsi_manager_tpg_enable(void)
+{
+}
 static inline bool msm_dsi_is_bonded_dsi(struct msm_dsi *msm_dsi)
 {
 	return false;
