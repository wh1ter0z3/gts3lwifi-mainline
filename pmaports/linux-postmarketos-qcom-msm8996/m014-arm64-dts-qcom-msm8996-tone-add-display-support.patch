From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@somainline.org>
Date: Thu, 27 May 2021 18:46:23 +0200
Subject: [PATCH] arm64: dts: qcom: msm8996-tone: Add display support

Add and configure required bits to enable display support
on SoMC Tone.

Signed-off-by: Konrad Dybcio <konrad.dybcio@somainline.org>
---
 .../dts/qcom/msm8996-sony-xperia-tone.dtsi    | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone.dtsi b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone.dtsi
index 3064a3e716..ac8b8fa0f5 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-sony-xperia-tone.dtsi
@@ -175,6 +175,10 @@ &camera2_rst {
 	output-low;
 };
 
+&gpu {
+	status = "okay";
+};
+
 &hsusb_phy1 {
 	vdd-supply = <&pm8994_l28>;
 	vdda-pll-supply = <&pm8994_l12>;
@@ -182,6 +186,54 @@ &hsusb_phy1 {
 	status = "okay";
 };
 
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	status = "okay";
+	vdda-supply = <&pm8994_l2>;
+	vcca-supply = <&pm8994_l22>;
+
+	panel: panel@0 {
+		reg = <0>;
+
+		disp-te-gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+
+		/* In-cell panels tend to come with a bunch of GPIOs. */
+		pvddio-gpio = <&tlmm 51 GPIO_ACTIVE_HIGH>;
+		preset-gpio = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+		treset-gpio = <&tlmm 89 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&pm8994_s4>;
+		avdd-supply = <&pm8994_l2>;
+		tvdd-supply = <&panel_tvdd>;
+
+		backlight = <&pmi8994_wled>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&disp_reset_n_gpio &ts_reset_n &lcd_vddio_en &mdp_vsync_p_gpio>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+
+	vdda-supply = <&pm8994_l2>;
+	vcca-supply = <&pm8994_l28>;
+};
+
 &mmcc {
 	vdd-gfx-supply = <&vdd_gfx>;
 };
