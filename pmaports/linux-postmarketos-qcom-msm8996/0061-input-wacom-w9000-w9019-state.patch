+static void wacom_w9000_close_disable_failure_test(struct kunit *test)
+{
+	const struct wacom_w9000_power_ops *ops = &wacom_w9000_test_power_ops;
+	struct wacom_w9000_power_state state = {
+		.supply_enabled = true,
+		.irq_enabled = true,
+	};
+	struct wacom_w9000_power_fake fake = {
+		.disable_error = -EIO,
+	};
+	int error;
+
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, false);
+	KUNIT_EXPECT_EQ(test, error, -EIO);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_FALSE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 0U);
+	KUNIT_ASSERT_EQ(test, fake.count, 4U);
+	KUNIT_EXPECT_EQ(test, fake.actions[0], POWER_IRQ_DISABLE);
+	KUNIT_EXPECT_EQ(test, fake.actions[1], POWER_RELEASE_INPUT);
+	KUNIT_EXPECT_EQ(test, fake.actions[2], POWER_RESET_ASSERT);
+	KUNIT_EXPECT_EQ(test, fake.actions[3], POWER_SUPPLY_DISABLE);
+
+	/* Reopen repairs only the IRQ/reset side; it cannot stack a vote. */
+	error = wacom_w9000_power_on_transition(&state, ops, &fake);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_TRUE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_enables, 0U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 1U);
+
+	fake.disable_error = 0;
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, false);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_FALSE(test, state.supply_enabled);
+	KUNIT_EXPECT_FALSE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 2U);
+}
+
+static void wacom_w9000_cleanup_retry_delay_test(struct kunit *test)
+{
+	const struct wacom_w9000_power_ops *ops = &wacom_w9000_test_power_ops;
+	struct wacom_w9000_power_state state = {
+		.supply_enabled = true,
+	};
+	struct wacom_w9000_power_fake fake = {
+		.shutdown_delay_us = 10000,
+		.disable_error = -EIO,
+	};
+	struct wacom_w9000_power_state old_state = {
+		.supply_enabled = true,
+	};
+	struct wacom_w9000_power_fake old_fake = {};
+	int error;
+
+	/* A failed managed-cleanup attempt retains the vote without a delay. */
+	error = wacom_w9000_supply_off(&state, ops, &fake);
+	KUNIT_EXPECT_EQ(test, error, -EIO);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 1U);
+	KUNIT_ASSERT_EQ(test, fake.count, 1U);
+	KUNIT_EXPECT_EQ(test, fake.actions[0], POWER_SUPPLY_DISABLE);
+
+	/* A later successful cleanup observes the W9019 shutdown delay. */
+	fake.disable_error = 0;
+	error = wacom_w9000_supply_off(&state, ops, &fake);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_FALSE(test, state.supply_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 2U);
+	KUNIT_ASSERT_EQ(test, fake.count, 3U);
+	KUNIT_EXPECT_EQ(test, fake.actions[1], POWER_SUPPLY_DISABLE);
+	KUNIT_EXPECT_EQ(test, fake.actions[2], POWER_SHUTDOWN_DELAY);
+
+	/* Already-off cleanup is idempotent. */
+	error = wacom_w9000_supply_off(&state, ops, &fake);
+	KUNIT_EXPECT_EQ(test, error, 0);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.count, 3U);
+
+	/* Existing variants have no configured shutdown delay. */
+	error = wacom_w9000_supply_off(&old_state, ops, &old_fake);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_FALSE(test, old_state.supply_enabled);
+	KUNIT_EXPECT_EQ(test, old_fake.supply_disables, 1U);
+	KUNIT_ASSERT_EQ(test, old_fake.count, 1U);
+	KUNIT_EXPECT_EQ(test, old_fake.actions[0], POWER_SUPPLY_DISABLE);
+}
