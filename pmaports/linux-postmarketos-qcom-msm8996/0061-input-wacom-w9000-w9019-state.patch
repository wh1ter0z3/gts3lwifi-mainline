+static void wacom_w9000_existing_input_event_test(struct kunit *test)
+{
+	struct wacom_w9000_input_state state = {};
+	struct wacom_w9000_input_fake fake = {};
+	struct wacom_w9000_report report = {
+		.x = 101,
+		.y = 202,
+		.pressure = 303,
+		.distance = 44,
+		.proximity = true,
+		.touch = true,
+		.side_button = true,
+	};
+
+	/* W9002 preserves the seven-byte, no-distance event sequence. */
+	wacom_w9000_report_input(&state, &report, false,
+				 &wacom_w9000_test_input_ops, &fake);
+	KUNIT_ASSERT_EQ(test, fake.count, 8U);
+	wacom_w9000_expect_event(test, &fake, 0, EV_ABS, ABS_X, 101);
+	wacom_w9000_expect_event(test, &fake, 1, EV_ABS, ABS_Y, 202);
+	wacom_w9000_expect_event(test, &fake, 2, EV_ABS, ABS_PRESSURE, 303);
+	wacom_w9000_expect_event(test, &fake, 3, EV_KEY, BTN_STYLUS, 1);
+	wacom_w9000_expect_event(test, &fake, 4, EV_KEY, BTN_TOUCH, 1);
+	wacom_w9000_expect_event(test, &fake, 5, EV_KEY, BTN_TOOL_PEN, 1);
+	wacom_w9000_expect_event(test, &fake, 6, EV_KEY, BTN_TOOL_RUBBER, 0);
+	wacom_w9000_expect_event(test, &fake, 7, EV_SYN, SYN_REPORT, 0);
+
+	/* A direct tool switch remains one frame for existing variants. */
+	report.rubber = true;
+	wacom_w9000_report_input(&state, &report, false,
+				 &wacom_w9000_test_input_ops, &fake);
+	KUNIT_ASSERT_EQ(test, fake.count, 16U);
+	wacom_w9000_expect_event(test, &fake, 13, EV_KEY, BTN_TOOL_PEN, 0);
+	wacom_w9000_expect_event(test, &fake, 14, EV_KEY, BTN_TOOL_RUBBER, 1);
+	wacom_w9000_expect_event(test, &fake, 15, EV_SYN, SYN_REPORT, 0);
+
+	report.proximity = false;
+	wacom_w9000_report_input(&state, &report, false,
+				 &wacom_w9000_test_input_ops, &fake);
+	KUNIT_ASSERT_EQ(test, fake.count, 22U);
+	wacom_w9000_expect_event(test, &fake, 16, EV_ABS, ABS_PRESSURE, 0);
+	wacom_w9000_expect_event(test, &fake, 21, EV_SYN, SYN_REPORT, 0);
+	wacom_w9000_release_input(&state, false,
+				  &wacom_w9000_test_input_ops, &fake);
+	KUNIT_EXPECT_EQ(test, fake.count, 22U);
+}
