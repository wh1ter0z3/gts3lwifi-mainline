+static void wacom_w9000_pm_enable_failure_test(struct kunit *test)
+{
+	const struct wacom_w9000_power_ops *ops = &wacom_w9000_test_power_ops;
+	struct wacom_w9000_power_state state = {};
+	struct wacom_w9000_power_fake fake = {
+		.enable_error = -EIO,
+	};
+	int error;
+
+	error = wacom_w9000_power_on_transition(&state, ops, &fake);
+	KUNIT_EXPECT_EQ(test, error, -EIO);
+	KUNIT_EXPECT_FALSE(test, state.supply_enabled);
+	KUNIT_EXPECT_FALSE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_enables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 0U);
+
+	/* A later off path cannot nest the already-disabled IRQ. */
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, false);
+	KUNIT_EXPECT_EQ(test, error, 0);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 0U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 0U);
+
+	fake.enable_error = 0;
+	error = wacom_w9000_power_on_transition(&state, ops, &fake);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_TRUE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_enables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 1U);
+
+	/* Repeated resume/open cannot add regulator votes or IRQ enable depth. */
+	error = wacom_w9000_power_on_transition(&state, ops, &fake);
+	KUNIT_EXPECT_EQ(test, error, 0);
+	KUNIT_EXPECT_EQ(test, fake.supply_enables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 1U);
+}
+
+static void wacom_w9000_pm_disable_rollback_test(struct kunit *test)
+{
+	const struct wacom_w9000_power_ops *ops = &wacom_w9000_test_power_ops;
+	struct wacom_w9000_power_state state = {
+		.supply_enabled = true,
+		.irq_enabled = true,
+	};
+	struct wacom_w9000_power_fake fake = {
+		.disable_error = -EIO,
+	};
+	int error;
+
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, true);
+	KUNIT_EXPECT_EQ(test, error, -EIO);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_TRUE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 1U);
+	KUNIT_ASSERT_GE(test, fake.count, 6U);
+	KUNIT_EXPECT_EQ(test, fake.actions[0], POWER_IRQ_DISABLE);
+	KUNIT_EXPECT_EQ(test, fake.actions[1], POWER_RELEASE_INPUT);
+	KUNIT_EXPECT_EQ(test, fake.actions[2], POWER_RESET_ASSERT);
+	KUNIT_EXPECT_EQ(test, fake.actions[3], POWER_SUPPLY_DISABLE);
+	KUNIT_EXPECT_EQ(test, fake.actions[4], POWER_RESET_DEASSERT);
+	KUNIT_EXPECT_EQ(test, fake.actions[5], POWER_IRQ_ENABLE);
+
+	fake.disable_error = 0;
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, true);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_FALSE(test, state.supply_enabled);
+	KUNIT_EXPECT_FALSE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 1U);
+
+	/* Repeated close/suspend leaves both nesting counts unchanged. */
+	error = wacom_w9000_power_off_transition(&state, ops, &fake, true);
+	KUNIT_EXPECT_EQ(test, error, 0);
+	KUNIT_EXPECT_EQ(test, fake.supply_disables, 2U);
+	KUNIT_EXPECT_EQ(test, fake.irq_disables, 2U);
+
+	error = wacom_w9000_power_on_transition(&state, ops, &fake);
+	KUNIT_ASSERT_EQ(test, error, 0);
+	KUNIT_EXPECT_TRUE(test, state.supply_enabled);
+	KUNIT_EXPECT_TRUE(test, state.irq_enabled);
+	KUNIT_EXPECT_EQ(test, fake.supply_enables, 1U);
+	KUNIT_EXPECT_EQ(test, fake.irq_enables, 2U);
+}
