+enum wacom_w9000_power_action {
+	POWER_SUPPLY_ENABLE,
+	POWER_SUPPLY_DISABLE,
+	POWER_RESET_ASSERT,
+	POWER_RESET_DEASSERT,
+	POWER_IRQ_ENABLE,
+	POWER_IRQ_DISABLE,
+	POWER_RELEASE_INPUT,
+	POWER_STARTUP_DELAY,
+	POWER_SHUTDOWN_DELAY,
+};
+
+struct wacom_w9000_power_fake {
+	enum wacom_w9000_power_action actions[32];
+	unsigned int count;
+	unsigned int supply_enables;
+	unsigned int supply_disables;
+	unsigned int irq_enables;
+	unsigned int irq_disables;
+	unsigned int shutdown_delay_us;
+	int enable_error;
+	int disable_error;
+};
+
+static void wacom_w9000_record_power(struct wacom_w9000_power_fake *fake,
+				     enum wacom_w9000_power_action action)
+{
+	if (fake->count < ARRAY_SIZE(fake->actions))
+		fake->actions[fake->count] = action;
+	fake->count++;
+}
+
+static int wacom_w9000_test_supply_enable(void *context)
+{
+	struct wacom_w9000_power_fake *fake = context;
+
+	wacom_w9000_record_power(fake, POWER_SUPPLY_ENABLE);
+	fake->supply_enables++;
+	return fake->enable_error;
+}
+
+static int wacom_w9000_test_supply_disable(void *context)
+{
+	struct wacom_w9000_power_fake *fake = context;
+
+	wacom_w9000_record_power(fake, POWER_SUPPLY_DISABLE);
+	fake->supply_disables++;
+	return fake->disable_error;
+}
+
+static void wacom_w9000_test_reset(void *context, bool asserted)
+{
+	wacom_w9000_record_power(context, asserted ? POWER_RESET_ASSERT :
+							 POWER_RESET_DEASSERT);
+}
+
+static void wacom_w9000_test_irq_enable(void *context)
+{
+	struct wacom_w9000_power_fake *fake = context;
+
+	wacom_w9000_record_power(fake, POWER_IRQ_ENABLE);
+	fake->irq_enables++;
+}
+
+static void wacom_w9000_test_irq_disable(void *context)
+{
+	struct wacom_w9000_power_fake *fake = context;
+
+	wacom_w9000_record_power(fake, POWER_IRQ_DISABLE);
+	fake->irq_disables++;
+}
+
+static void wacom_w9000_test_release_input(void *context)
+{
+	wacom_w9000_record_power(context, POWER_RELEASE_INPUT);
+}
+
+static void wacom_w9000_test_startup_delay(void *context)
+{
+	wacom_w9000_record_power(context, POWER_STARTUP_DELAY);
+}
+
+static void wacom_w9000_test_shutdown_delay(void *context)
+{
+	struct wacom_w9000_power_fake *fake = context;
+
+	if (fake->shutdown_delay_us)
+		wacom_w9000_record_power(fake, POWER_SHUTDOWN_DELAY);
+}
+
+static const struct wacom_w9000_power_ops wacom_w9000_test_power_ops = {
+	.supply_enable = wacom_w9000_test_supply_enable,
+	.supply_disable = wacom_w9000_test_supply_disable,
+	.reset = wacom_w9000_test_reset,
+	.irq_enable = wacom_w9000_test_irq_enable,
+	.irq_disable = wacom_w9000_test_irq_disable,
+	.release_input = wacom_w9000_test_release_input,
+	.startup_delay = wacom_w9000_test_startup_delay,
+	.shutdown_delay = wacom_w9000_test_shutdown_delay,
+};
