From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Fri, 26 Feb 2021 11:37:53 +0400
Subject: [PATCH] arm64: dts: qcom: pmi8994: Add haptics

Add a node for SPMI haptics.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 arch/arm64/boot/dts/qcom/pmi8994.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pmi8994.dtsi b/arch/arm64/boot/dts/qcom/pmi8994.dtsi
index 9725402321..1e8fcfa2d5 100644
--- a/arch/arm64/boot/dts/qcom/pmi8994.dtsi
+++ b/arch/arm64/boot/dts/qcom/pmi8994.dtsi
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/spmi/spmi.h>
+#include <dt-bindings/input/qcom,spmi-haptics.h>
 
 &spmi_bus {
 
@@ -136,6 +137,19 @@ pmi8994_spmi_regulators: regulators {
 			compatible = "qcom,pmi8994-regulators";
 		};
 
+		pmi8994_haptics: qcom,haptics@c000 {
+			compatible = "qcom,pmi8994-haptics", "qcom,spmi-haptics";
+			reg = <0xc000 0x100>;
+
+			interrupts = <0x3 0xc0 0x0 IRQ_TYPE_EDGE_BOTH>,
+				     <0x3 0xc0 0x1 IRQ_TYPE_EDGE_BOTH>;
+			interrupt-names = "short", "play";
+
+			qcom,play-mode = <HAP_PLAY_BUFFER>;
+
+			status = "disabled";
+		};
+
 		pmi8994_wled: wled@d800 {
 			compatible = "qcom,pmi8994-wled";
 			reg = <0xd800>, <0xd900>;
