From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Thu, 10 Jul 2025 09:25:45 +0100
Subject: [PATCH] net: qrtr: Turn QRTR into a bus

Implement a QRTR bus to allow for creating drivers for individual QRTR
services. With this in place, devices are dynamically registered for QRTR
services as they become available, and drivers for these devices are
matched using service and instance IDs.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 include/linux/device-id/qrtr.h    |  23 ++++
 include/linux/mod_devicetable.h   |   1 +
 include/linux/soc/qcom/qrtr.h     |  36 +++++
 net/qrtr/af_qrtr.c                |  23 +++-
 net/qrtr/qrtr.h                   |   3 +
 net/qrtr/smd.c                    | 218 +++++++++++++++++++++++++++++-
 scripts/mod/devicetable-offsets.c |   4 +
 scripts/mod/file2alias.c          |  10 ++
 8 files changed, 312 insertions(+), 6 deletions(-)
 create mode 100644 include/linux/device-id/qrtr.h
 create mode 100644 include/linux/soc/qcom/qrtr.h

diff --git a/include/linux/device-id/qrtr.h b/include/linux/device-id/qrtr.h
new file mode 100644
index 0000000000..2a0fa2808e
--- /dev/null
+++ b/include/linux/device-id/qrtr.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef LINUX_DEVICE_ID_QRTR_H
+#define LINUX_DEVICE_ID_QRTR_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+typedef unsigned long kernel_ulong_t;
+#endif
+
+/* QRTR */
+
+#define QRTR_NAME_SIZE		32
+#define QRTR_MODULE_PREFIX	"qrtr:"
+
+struct qrtr_device_id {
+	__u16 service;
+	__u16 instance;
+
+	/* Data private to the driver */
+	kernel_ulong_t driver_data;
+};
+
+#endif /* ifndef LINUX_DEVICE_ID_QRTR_H */
diff --git a/include/linux/mod_devicetable.h b/include/linux/mod_devicetable.h
index a397213bed..cb137f3ad5 100644
--- a/include/linux/mod_devicetable.h
+++ b/include/linux/mod_devicetable.h
@@ -47,6 +47,7 @@
 #include "device-id/pcmcia.h"
 #include "device-id/platform.h"
 #include "device-id/pnp.h"
