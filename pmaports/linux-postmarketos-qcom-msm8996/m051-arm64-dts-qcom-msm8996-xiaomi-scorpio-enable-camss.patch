From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yassine Oudjana <y.oudjana@protonmail.com>
Date: Mon, 13 Dec 2021 12:09:25 +0400
Subject: [PATCH] arm64: dts: qcom: msm8996-xiaomi-scorpio: Enable CAMSS

Enable the camera subsystem and add a node for the rear
Sony IMX318 sensor.

Signed-off-by: Yassine Oudjana <y.oudjana@protonmail.com>
---
 .../boot/dts/qcom/msm8996-xiaomi-common.dtsi  | 51 ++++++++++++++++
 .../dts/qcom/msm8996pro-xiaomi-scorpio.dts    | 61 +++++++++++++++++++
 2 files changed, 112 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
index bb7d6a14be..db5f97518a 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-common.dtsi
@@ -141,6 +141,20 @@ vph_pwr: vph-pwr-regulator {
 		regulator-boot-on;
 	};
 
+	vdd_cam_1p1: vdd-cam-1p1 {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_cam_1p1";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		vin-supply = <&vreg_s3a_1p3>;
+		regulator-allow-set-load;
+
+		gpio = <&tlmm 86 0>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vdd_cam_1p1_default>;
+	};
+
 	vdd_3v2_tp: vdd-3v2-tp {
 		compatible = "regulator-fixed";
 		regulator-name = "vdd_3v2_tp";
@@ -635,10 +649,12 @@ vreg_l32a_1p8: l32 {
 			regulator-max-microvolt = <1800000>;
 		};
 		vreg_lvs1a_1p8: lvs1 {
+			regulator-name = "vreg_lvs1a_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
 		};
 		vreg_lvs2a_1p8: lvs2 {
+			regulator-name = "vreg_lvs2a_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
 		};
@@ -740,6 +756,34 @@ divclk4_pin_a: divclk4-state {
 };
 
 &tlmm {
+	cam_sensor_rear_default: cam-sensor-rear-default-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_sensor_rear_sleep: cam-sensor-rear-sleep-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	mclk0_default: mclk0-default-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	mclk0_sleep: mclk0-sleep-state {
+		pins = "gpio13";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	mdss_dsi_default: mdss-dsi-default-state {
 		pins = "gpio8";
 		function = "gpio";
@@ -767,4 +811,11 @@ nfc_default: nfc-default-state {
 		drive-strength = <16>;
 		bias-pull-up;
 	};
+
+	vdd_cam_1p1_default: vdd-cam-1p1-default-state {
+		pins = "gpio86";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
 };
diff --git a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
index 5ed2c87de4..1c9edc7f49 100644
--- a/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996pro-xiaomi-scorpio.dts
@@ -126,6 +126,65 @@ touchscreen: atmel-mxt-ts@4a {
 	};
 };
 
+&camss {
+	status = "okay";
+
+	vdda-supply = <&vreg_l2a_1p25>;
+
+	ports {
+		port@0 {
+			reg = <0>;
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx318_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	clock-frequency = <1000000>;
+
+	/* Rear camera */
+	camera-sensor@1a {
+		compatible = "sony,imx318";
+		reg = <0x1a>;
+
+		vana-supply = <&vreg_l17a_2p8>;
+		vio-supply = <&vreg_lvs1a_1p8>;
+		vmipi-supply = <&vreg_l11a_1p1>;
+		vdig-supply = <&vdd_cam_1p1>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		clock-frequency = <24000000>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cam_sensor_rear_default>, <&mclk0_default>;
+		pinctrl-1 = <&cam_sensor_rear_sleep>, <&mclk0_sleep>;
+
+		port {
+			imx318_ep: endpoint {
+				data-lanes = <0 1 2 3>;
+				link-frequencies = /bits/ 64 <211562400 693600000 846249600>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c1 {
+	clock-frequency = <1000000>;
+
+	/* Front camera - Sony IMX268 */
+};
+
 &gpu_zap_shader {
 	firmware-name = "qcom/msm8996/scorpio/a530_zap.mbn";
 };
@@ -293,11 +352,13 @@ vreg_l11a_1p1: l11 {
 			regulator-name = "vreg_l11a_1p1";
 			regulator-min-microvolt = <1100000>;
 			regulator-max-microvolt = <1100000>;
+			regulator-allow-set-load;
 		};
 		vreg_l17a_2p8: l17 {
 			regulator-name = "vreg_l17a_2p8";
 			regulator-min-microvolt = <2800000>;
 			regulator-max-microvolt = <2800000>;
+			regulator-allow-set-load;
 		};
 		vreg_l18a_2p8: l18 {
 			regulator-name = "vreg_l18a_2p8";
