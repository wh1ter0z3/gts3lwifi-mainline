# Forked from Alpine for temporary downstream patches
# gts3: Alpine's iio-sensor-proxy 3.9-r2 plus two fixes for upstream (not
# merged yet): a Claim() during probing starts the sensor, so restarting the
# daemon under KWin keeps auto-rotate, 0001; a pending Claim() returns when
# the last client releases, 0002. pkgrel 101 outranks Alpine's.
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=101
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-2.0-or-later"
depends="dbus"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	meson
	polkit-dev
	libssc-dev
	"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	iio-sensor-proxy.initd
	0001-main-Start-sensors-that-were-claimed-while-being-pro.patch
	0002-main-Return-pending-Claim-calls-when-the-last-client.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

