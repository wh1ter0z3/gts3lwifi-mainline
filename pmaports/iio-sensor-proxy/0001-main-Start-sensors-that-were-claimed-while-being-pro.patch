From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <iio-sensor-proxy@jayd.ml>
Date: Sun, 1 Nov 2026 16:52:17 -0700
Subject: [PATCH] main: Start sensors that were claimed while being probed

Clients can call Claim*() as soon as the D-Bus name is owned, but the
sensors are only found and opened in name_acquired_handler(), and
probing can run the main loop: the SSC drivers' discover() uses libssc's
_sync() calls, which iterate the default main context while they wait.
A Claim() handled in that window found the driver (driver_type_exists())
but not the device, and its invocation array was not allocated yet:

  g_ptr_array_add: assertion 'rarray' failed
  driver_set_polling: assertion 'sensor_device' failed

The client was counted, so later Claim() calls from other clients did
not start the sensor either, and the orientation stayed "undefined"
until every client released it. This happens when iio-sensor-proxy is
restarted while a compositor that watches the name (KWin) is running.

Allocate the delayed invocation arrays with the client tables, before
the name is requested. Treat a sensor that was found but is not open
yet like one that is starting up: queue the invocation. Once
name_acquired_handler() has opened a sensor that still has clients,
start polling it; the queued Claim() calls return with the first
reading, as for a sensor that is hotplugged while claimed. If the
sensor fails to open, or its clients went away while it was probed,
return them right away. A Release() in that window has no device to
stop, so check for the device rather than the driver there.
---
 src/iio-sensor-proxy.c | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/src/iio-sensor-proxy.c b/src/iio-sensor-proxy.c
index 9c7e8cd..bfc7ae8 100644
--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -114,6 +114,8 @@ static void sensor_changes (GUdevClient *client,
 			    gchar       *action,
 			    GUdevDevice *device,
 			    SensorData  *data);
+static void maybe_notify_sensor_startup_finished (SensorData *data,
+						  DriverType  type);
 
 static gboolean
 driver_type_exists (SensorData *data,
@@ -423,7 +425,7 @@ client_release (SensorData            *data,
 
 	g_hash_table_remove (ht, sender);
 
-	if (driver_type_exists (data, driver_type) &&
+	if (DEVICE_FOR_TYPE(driver_type) != NULL &&
 	    g_hash_table_size (ht) == 0) {
 		SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 		driver_set_polling (sensor_device, FALSE);
@@ -522,7 +524,7 @@ handle_generic_method_call (SensorData            *data,
 							   NULL);
 		g_hash_table_insert (ht, g_strdup (sender), GUINT_TO_POINTER (watch_id));
 
-		if (driver_type_exists (data, driver_type)) {
+		if (DEVICE_FOR_TYPE(driver_type) != NULL) {
 			SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 
 			/* No other clients for this sensor? Start it */
@@ -545,6 +547,11 @@ handle_generic_method_call (SensorData            *data,
 				 * invocation immediately. */
 				g_dbus_method_invocation_return_value (invocation, NULL);
 			}
+		} else if (driver_type_exists (data, driver_type)) {
+			/* Found but not open yet: name_acquired_handler() is still
+			 * probing. It starts the sensor for its clients once open. */
+			g_ptr_array_add (data->sensor_startup_dbus_invocations_delayed[driver_type],
+					 invocation);
 		} else {
 			g_dbus_method_invocation_return_value (invocation, NULL);
 		}
@@ -742,8 +749,10 @@ bus_acquired_handler (GDBusConnection *connection,
 	/* Initialize DBus clients hash table before DBus is fully exposed */
 	data->client = g_udev_client_new (subsystems);
 
-	for (guint i = 0; i < NUM_SENSOR_TYPES; i++)
+	for (guint i = 0; i < NUM_SENSOR_TYPES; i++) {
 		data->clients[i] = create_clients_hash_table ();
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+	}
 
 	data->connection = g_object_ref (connection);
 }
@@ -765,8 +774,6 @@ name_acquired_handler (GDBusConnection *connection,
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		SensorDevice *sensor_device;
 
-		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
-
 		if (!driver_type_exists (data, i))
 			continue;
 
@@ -775,10 +782,21 @@ name_acquired_handler (GDBusConnection *connection,
 		if (!sensor_device) {
 			DRIVER_FOR_TYPE(i) = NULL;
 			g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
+			/* Answer the clients that claimed it while it was probed */
+			maybe_notify_sensor_startup_finished (data, i);
 			continue;
 		}
 
 		DEVICE_FOR_TYPE(i) = sensor_device;
+
+		/* Clients can claim a sensor before it is open, as probing can
+		 * run the main loop (libssc's _sync() calls iterate it). Start
+		 * it for them now; their Claim() returns with the first
+		 * reading. */
+		if (g_hash_table_size (data->clients[i]) > 0)
+			driver_set_polling (sensor_device, TRUE);
+		else
+			maybe_notify_sensor_startup_finished (data, i);
 	}
 
 	if (!any_sensors_left (data))
