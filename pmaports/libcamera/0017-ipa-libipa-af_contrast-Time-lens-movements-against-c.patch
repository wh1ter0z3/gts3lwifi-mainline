 	bool combineStats(std::span<const RegionStats> stats,
@@ -138,6 +139,7 @@ private:
 	double position_ = 0.0;
 	bool lensChanged_ = false;
 	std::optional<uint32_t> lastFrame_;
+	std::optional<uint32_t> lastCapturedFrame_;
 	std::optional<uint32_t> lastMoveFrame_;
 	uint32_t skipCount_ = 0;
 
diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
index 59956ee0..9487c2cc 100644
--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -40,9 +40,10 @@ static constexpr double kContrastScale = 1e6;
  * Without a focus lens, it only reports the FocusFoM metadata.
  *
  * The software ISP computes statistics every SwStatsCpu::kStatPerNumFrames
- * frames. The step_frames tuning parameter, which counts frames, should be at
- * least that value so that the statistics used after a lens movement are
- * measured on a frame captured with the lens in its new position.
+ * frames, and can process a frame several frames after its capture when
+ * debayering takes most of the frame time. Lens movements are timed against
+ * the frames captured: prepare() runs when a captured frame is queued to the
+ * software ISP.
  */
 
 /**
@@ -84,12 +85,11 @@ void Af::queueRequest([[maybe_unused]] IPAContext &context,
 /**
  * \copydoc libcamera::ipa::Algorithm::prepare
  */
-void Af::prepare([[maybe_unused]] IPAContext &context,
-		 [[maybe_unused]] const uint32_t frame,
+void Af::prepare([[maybe_unused]] IPAContext &context, const uint32_t frame,
 		 IPAFrameContext &frameContext,
 		 [[maybe_unused]] DebayerParams *params)
 {
-	af_.prepare(frameContext.af);
+	af_.prepare(frame, frameContext.af);
 }
 
 bool Af::computeRegions(const IPAContext &context, const SwIspStats *stats)
diff --git a/src/ipa/simple/data/imx258.yaml b/src/ipa/simple/data/imx258.yaml
