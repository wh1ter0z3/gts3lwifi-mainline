# Forked from Alpine for temporary downstream patches
# gts3: postmarketOS temp/libcamera 99990.7.2-r4 plus the gts3 series
# (S5K5E3, lens control, contrast AF, IMX258/S5K5E3 tuning), 0007-0014,
# output buffers padded to 32-line groups (Venus dma-buf import), 0015,
# IMX258 lens settle wait covering the soft ISP's buffer lag, 0016
# AfContrast counts the settle wait from the captured frame, which
# undoes 0016's longer wait, 0017; Raspberry Pi licence kept, 0018
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.7.2
pkgver=9999$_pkgver
pkgrel=107
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	qcam
	$pkgname-gstreamer
	$pkgname-v4l2
	$pkgname-tools
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	"
_tuning_files="
	hi846.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx800.yaml
	imx858.yaml
	s5k3l6xx.yaml
	s5kjn1.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-software_isp-debayer_egl-Re-add-log-for-failing-DMAB.patch
	0002-libcamera-camera_sensor-Add-Sony-IMX355-sensor-prope.patch
	0003-libcamera-software_isp-debayer_egl-Use-untransposed-.patch
	0004-debayer-Further-demote-Unsupported-input-format-log.patch
	0005-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch
	0006-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0007-ipa-libipa-camera_sensor_helper-Add-S5K5E3.patch
	0008-libcamera-sensor-Add-S5K5E3-sensor-properties.patch
	0009-libcamera-software_isp-Gather-focus-statistics.patch
	0010-libcamera-software_isp-Pass-focus-lens-controls-to-a.patch
	0011-ipa-libipa-Add-contrast-detection-autofocus-algorith.patch
	0012-test-ipa-libipa-Add-AfContrast-test.patch
	0013-ipa-simple-Add-autofocus-algorithm.patch
	0014-ipa-simple-Add-IMX258-and-S5K5E3-tuning-files.patch
	0015-libcamera-software_isp-Pad-the-output-frame-size-to-.patch
	0016-ipa-simple-imx258-Wait-longer-for-the-focus-lens-to-.patch
	0017-ipa-libipa-af_contrast-Time-lens-movements-against-c.patch
	0018-ipa-libipa-af_contrast-Keep-the-Raspberry-Pi-copyrig.patch
	qcam.desktop
	$_tuning_files
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	subpackages="$subpackages $pkgname-raspberrypi"
	;;
esac

case "$CARCH" in
ppc64le|s390x|riscv64|loongarch64)
	# doesn't install any ipa
	;;
*)
	depends="$pkgname-ipa=$pkgver-r$pkgrel"
	subpackages="$subpackages $pkgname-ipa"
	;;
esac

build() {
	abuild-meson \
		-Dpipelines=auto,virtual \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/usr/share/applications "$srcdir"/qcam.desktop

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends=""
	amove usr/lib/libcamera
	amove usr/share/libcamera/ipa

	for _tuning_file in $_tuning_files; do
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/simple \
			"$srcdir"/"$_tuning_file"
	done

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

	amove usr/share/applications/qcam.desktop
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


