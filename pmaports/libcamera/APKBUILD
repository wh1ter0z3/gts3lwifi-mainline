# gts3: postmarketOS temp/libcamera 99990.8.0-r1 plus the gts3 series,
# ported from 0.7.2 (docs/camera.md): S5K5E3, focus statistics, lens
# control, contrast AF and its test, IMX258/S5K5E3 tuning, 0003-0010;
# output buffers padded to 32-line groups (Venus dma-buf import), 0011;
# IMX258 lens settle wait, AF timed against captured frames, Raspberry Pi
# licence kept, continuous AF allowing for exposure changes, 0012-0015.
# pkgrel 100: above the mirror's build of the same version.
# Forked from Alpine for temporary downstream patches
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.8.0
pkgver=9999$_pkgver
pkgrel=100
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-gstreamer
	$pkgname-ipa
	$pkgname-tools
	$pkgname-v4l2
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	qcam
	"
_tuning_files="
	hi846.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx800.yaml
	imx858.yaml
	s5k3l6xx.yaml
	s5kjn1.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-libcamera-software_isp-Allow-limiting-output-sizes.patch
	0002-libcamera-Add-quad-Bayer-CFA-layout-support.patch
	0003-ipa-libipa-camera_sensor_helper-Add-S5K5E3.patch
	0004-libcamera-sensor-Add-S5K5E3-sensor-properties.patch
	0005-libcamera-software_isp-Gather-focus-statistics.patch
	0006-libcamera-software_isp-Pass-focus-lens-controls-to-a.patch
	0007-ipa-libipa-Add-contrast-detection-autofocus-algorith.patch
	0008-test-ipa-libipa-Add-AfContrast-test.patch
	0009-ipa-simple-Add-autofocus-algorithm.patch
	0010-ipa-simple-Add-IMX258-and-S5K5E3-tuning-files.patch
	0011-libcamera-software_isp-Pad-the-output-frame-size-to-.patch
	0012-ipa-simple-imx258-Wait-longer-for-the-focus-lens-to-.patch
	0013-ipa-libipa-af_contrast-Time-lens-movements-against-c.patch
	0014-ipa-libipa-af_contrast-Keep-the-Raspberry-Pi-copyrig.patch
	0015-ipa-libipa-af_contrast-Allow-for-exposure-changes-in.patch
	qcam.desktop
	$_tuning_files
	"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	# must be ordered before the ipa subpackage
	subpackages="$pkgname-raspberrypi $subpackages"
	;;
esac

build() {
	abuild-meson \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/usr/share/applications "$srcdir"/qcam.desktop

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends="$pkgname=$pkgver-r$pkgrel"
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/libcamera/ipa
	amove usr/share/libcamera/ipa

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done

	for _tuning_file in $_tuning_files; do
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/softisp \
			"$srcdir"/"$_tuning_file"
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

	amove usr/share/applications/qcam.desktop
}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


