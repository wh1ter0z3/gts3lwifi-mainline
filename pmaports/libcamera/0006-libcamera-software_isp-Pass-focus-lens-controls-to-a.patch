 };
 
 interface IPASoftIspInterface {
@@ -17,7 +18,8 @@ interface IPASoftIspInterface {
 	     libcamera.SharedFD fdStats,
 	     libcamera.SharedFD fdParams,
 	     libcamera.IPACameraSensorInfo sensorInfo,
-	     libcamera.ControlInfoMap sensorControls)
+	     libcamera.ControlInfoMap sensorControls,
+	     libcamera.ControlInfoMap lensControls)
 		=> (int32 ret,
 		    libcamera.ControlInfoMap ipaControls,
 		    bool ccmEnabled, bool lscEnabled,
@@ -35,7 +37,8 @@ interface IPASoftIspInterface {
 };
 
 interface IPASoftIspEventInterface {
-	setSensorControls(libcamera.ControlList sensorControls);
+	setSensorControls(libcamera.ControlList sensorControls,
+			  libcamera.ControlList lensControls);
 	paramsComputed(uint32 frame);
 	metadataReady(uint32 frame, libcamera.ControlList metadata);
 };
diff --git a/src/ipa/softisp/ipa_context.cpp b/src/ipa/softisp/ipa_context.cpp
index 0c7cbbf7..35410c1a 100644
--- a/src/ipa/softisp/ipa_context.cpp
+++ b/src/ipa/softisp/ipa_context.cpp
@@ -48,6 +48,10 @@ namespace libcamera::ipa::softisp {
  *
  * \var IPAContext::activeState
  * \brief The current state of IPA algorithms
+ *
+ * \var IPAContext::lensControls
+ * \brief The V4L2 controls of the focus lens, empty if the camera has no
+ * controllable focus lens
  */
 
 /**
@@ -99,4 +103,15 @@ namespace libcamera::ipa::softisp {
  * \brief Black level used for the gamma table computation
  */
 
+/**
+ * \var IPAActiveState::lens
+ * \brief Focus lens state
+ *
+ * \var IPAActiveState::lens.focusPosition
+ * \brief Focus lens position to apply, in lens driver units
+ *
+ * Algorithms set the position when the lens has to move. The value is reset
+ * once the lens control has been sent to the pipeline handler.
+ */
+
 } /* namespace libcamera::ipa::softisp */
diff --git a/src/ipa/softisp/ipa_context.h b/src/ipa/softisp/ipa_context.h
index 1c5db17e..614298d4 100644
--- a/src/ipa/softisp/ipa_context.h
+++ b/src/ipa/softisp/ipa_context.h
@@ -58,6 +58,10 @@ struct IPAActiveState {
 	} knobs;
 
 	ipa::lsc::ActiveState lsc;
+
+	struct {
+		std::optional<int32_t> focusPosition;
+	} lens;
 };
 
 struct IPAFrameContext : public FrameContext {
@@ -84,6 +88,7 @@ struct IPAContext {
 
 	IPACameraSensorInfo sensorInfo;
 	ControlInfoMap sensorControls;
+	ControlInfoMap lensControls;
 	std::unique_ptr<CameraSensorHelper> camHelper;
 	IPASessionConfiguration configuration;
 	IPAActiveState activeState;
diff --git a/src/ipa/softisp/softisp.cpp b/src/ipa/softisp/softisp.cpp
index a166176b..bb872e47 100644
--- a/src/ipa/softisp/softisp.cpp
+++ b/src/ipa/softisp/softisp.cpp
@@ -6,6 +6,8 @@
  */
 
 #include <chrono>
+#include <cmath>
+#include <optional>
 #include <stdint.h>
 #include <sys/mman.h>
 
@@ -57,6 +59,7 @@ public:
 		 const SharedFD &fdParams,
 		 const IPACameraSensorInfo &sensorInfo,
 		 const ControlInfoMap &sensorControls,
+		 const ControlInfoMap &lensControls,
 		 ControlInfoMap *ipaControls,
 		 bool *ccmEnabled,
 		 bool *lscEnabled,
@@ -98,6 +101,7 @@ int IPASoftIsp::init(const IPASettings &settings,
 		     const SharedFD &fdParams,
 		     const IPACameraSensorInfo &sensorInfo,
 		     const ControlInfoMap &sensorControls,
+		     const ControlInfoMap &lensControls,
 		     ControlInfoMap *ipaControls,
 		     bool *ccmEnabled,
 		     bool *lscEnabled,
@@ -112,6 +116,7 @@ int IPASoftIsp::init(const IPASettings &settings,
 
 	context_.sensorInfo = sensorInfo;
 	context_.sensorControls = sensorControls;
+	context_.lensControls = lensControls;
 
 	/* Load the tuning data file */
 	File file(settings.configurationFile);
@@ -210,6 +215,7 @@ int IPASoftIsp::init(const IPASettings &settings,
 int IPASoftIsp::configure(const IPAConfigInfo &configInfo, ControlInfoMap *ipaControls)
 {
 	context_.sensorControls = configInfo.sensorControls;
+	context_.lensControls = configInfo.lensControls;
 
 	/* Clear the IPA context before the streaming session. */
 	context_.configuration = {};
@@ -274,7 +280,16 @@ void IPASoftIsp::processStats(const uint32_t frame,
 	ControlList ctrls(context_.sensorControls);
 	agc::prepareControls(ctrls, context_.camHelper.get(),
 			     frameContext.agc.exposure, frameContext.agc.gain);
-	setSensorControls.emit(ctrls);
+
+	ControlList lensCtrls;
+	std::optional<int32_t> &focusPosition = context_.activeState.lens.focusPosition;
+	if (focusPosition) {
+		lensCtrls = ControlList(context_.lensControls);
+		lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE, *focusPosition);
+		focusPosition.reset();
+	}
+
+	setSensorControls.emit(ctrls, lensCtrls);
 }
 
 std::string IPASoftIsp::logPrefix() const
