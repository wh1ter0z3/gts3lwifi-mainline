From b63113f38101f830a5a686337fc458d650f31f57 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 11 Nov 2026 04:00:00 +0530
Subject: [PATCH] media: venus: vdec: Bitstream dma-bufs as large as the client
 asked

The input queue held every buffer to the larger of the client's
sizeimage and the driver's worst case for a compressed frame. Android's
v4l2_codec2 allocates its bitstream buffers at the size it asks for
(1 MB up to 1080p) and queued them against the worst case (1.5 MB at
1080p): failed to attach dmabuf. With dma-bufs, take the size the client
asked for at S_FMT when it is smaller; the firmware reads only what a
buffer is filled with.

On msm8996 with OneUI 8 the bitstream is now queued; decoding then stops
at a firmware session error ("Output2 upscale not supported"), still to
be looked into.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/venus/core.h | 1 +
 drivers/media/platform/qcom/venus/vdec.c | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index cb042ddd9..5fc0b325e 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -486,6 +486,7 @@ struct venus_inst {
 	struct list_head dpbbufs;
 	struct list_head internalbufs;
 	struct list_head registeredbufs;
+	u32 input_buf_size_req;
 	struct venus_bounce_buf *bounce;
 	unsigned int num_bounce;
 	u32 bounce_size;
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 95b211a4a..a16984761 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -362,6 +362,7 @@ static int vdec_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
 		inst->quantization = pixmp->quantization;
 		inst->xfer_func = pixmp->xfer_func;
 		inst->input_buf_size = pixmp->plane_fmt[0].sizeimage;
+		inst->input_buf_size_req = orig_pixmp.plane_fmt[0].sizeimage;
 	}
 
 	memset(&format, 0, sizeof(format));
@@ -988,6 +989,14 @@ static int vdec_queue_setup(struct vb2_queue *q,
 						    inst->out_width,
 						    inst->out_height);
 		sizes[0] = max(sizes[0], inst->input_buf_size);
+		/*
+		 * Bitstream dma-bufs (Android's v4l2_codec2) are as large as
+		 * the client asked at S_FMT, not our worst case for a frame;
+		 * the firmware only reads what a buffer is filled with
+		 */
+		if (q->memory == VB2_MEMORY_DMABUF && inst->input_buf_size_req &&
+		    inst->input_buf_size_req < sizes[0])
+			sizes[0] = inst->input_buf_size_req;
 		inst->input_buf_size = sizes[0];
 		*num_buffers = max(*num_buffers, in_num);
 		inst->num_input_bufs = *num_buffers;
-- 
