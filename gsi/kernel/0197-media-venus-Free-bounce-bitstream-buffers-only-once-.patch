From d15ee1b3bfd9e9f0f940653207d2dcc7d0dad44c Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Wed, 11 Nov 2026 02:48:44 +0530
Subject: [PATCH] media: venus: Free bounce bitstream buffers only once the
 session is gone

The driver's own bitstream buffers (HFI v3 encoders with dma-buf capture)
were freed right after their unset command, while the firmware session
still existed (stop, unload, unset, then deinit). Free them after the
session deinit (or abort), in stop_streaming and when the instance
releases a session that never stopped (a failed start); a new set frees
a leftover one first.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/media/platform/qcom/venus/helpers.c | 12 ++++++++----
 drivers/media/platform/qcom/venus/helpers.h |  1 +
 drivers/media/platform/qcom/venus/venc.c    |  1 +
 3 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/helpers.c b/drivers/media/platform/qcom/venus/helpers.c
index e88de7919..bc9fdd6fc 100644
--- a/drivers/media/platform/qcom/venus/helpers.c
+++ b/drivers/media/platform/qcom/venus/helpers.c
@@ -438,7 +438,7 @@ static bool venus_bounce_needed(struct venus_inst *inst)
 	       q->memory == VB2_MEMORY_DMABUF;
 }
 
-static void venus_bounce_free(struct venus_inst *inst)
+void venus_helper_bounce_free(struct venus_inst *inst)
 {
 	struct device *dev = inst->core->dev;
 	unsigned int i;
@@ -450,12 +450,14 @@ static void venus_bounce_free(struct venus_inst *inst)
 	inst->bounce = NULL;
 	inst->num_bounce = 0;
 }
+EXPORT_SYMBOL_GPL(venus_helper_bounce_free);
 
 static int venus_bounce_alloc(struct venus_inst *inst)
 {
 	struct device *dev = inst->core->dev;
 	unsigned int i;
 
+	venus_helper_bounce_free(inst);
 	inst->bounce = kcalloc(inst->num_output_bufs, sizeof(*inst->bounce),
 			       GFP_KERNEL);
 	if (!inst->bounce)
@@ -469,7 +471,7 @@ static int venus_bounce_alloc(struct venus_inst *inst)
 						     &inst->bounce[i].da,
 						     GFP_KERNEL, 0);
 		if (!inst->bounce[i].va) {
-			venus_bounce_free(inst);
+			venus_helper_bounce_free(inst);
 			return -ENOMEM;
 		}
 		inst->bounce[i].owner = -1;
@@ -730,7 +732,6 @@ int venus_helper_unregister_bufs(struct venus_inst *inst)
 			bd.response_required = true;
 			ret |= hfi_session_unset_buffers(inst, &bd);
 		}
-		venus_bounce_free(inst);
 
 		list_for_each_entry_safe(buf, n, &inst->registeredbufs, reg_list)
 			list_del_init(&buf->reg_list);
@@ -774,8 +775,8 @@ static int session_register_bufs(struct venus_inst *inst)
 			bd.device_addr = inst->bounce[i].da;
 			ret = hfi_session_set_buffers(inst, &bd);
 			if (ret) {
+				/* freed when the session is gone */
 				dev_err(dev, "%s: set buffer failed\n", __func__);
-				venus_bounce_free(inst);
 				break;
 			}
 		}
@@ -1774,6 +1775,9 @@ void venus_helper_vb2_stop_streaming(struct vb2_queue *q)
 		if (ret)
 			hfi_session_abort(inst);
 
+		/* only now: the firmware is done with them */
+		venus_helper_bounce_free(inst);
+
 		venus_helper_free_dpb_bufs(inst);
 
 		venus_pm_load_scale(inst);
diff --git a/drivers/media/platform/qcom/venus/helpers.h b/drivers/media/platform/qcom/venus/helpers.h
index 01a2ea8eb..c67e07fef 100644
--- a/drivers/media/platform/qcom/venus/helpers.h
+++ b/drivers/media/platform/qcom/venus/helpers.h
@@ -45,6 +45,7 @@ int venus_helper_set_raw_format(struct venus_inst *inst, u32 hfi_format,
 				u32 buftype);
 int venus_helper_set_color_format(struct venus_inst *inst, u32 fmt);
 bool venus_helper_is_dynamic_bufmode(struct venus_inst *inst);
+void venus_helper_bounce_free(struct venus_inst *inst);
 void venus_helper_bounce_done(struct venus_inst *inst,
 			      struct vb2_v4l2_buffer *vbuf,
 			      u32 offset, u32 bytesused);
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 65d6da4b6..ca153557d 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -1276,6 +1276,7 @@ static void venc_release_session(struct venus_inst *inst)
 	ret = hfi_session_deinit(inst);
 	if (ret || inst->session_error)
 		hfi_session_abort(inst);
+	venus_helper_bounce_free(inst);
 
 	mutex_unlock(&inst->lock);
 
-- 
2.53.0

