# Codec2 V4L2 components (AOSP external/v4l2_codec2, from GloDroid's RPi4
# build: a VNDK-less vendor, so its libraries come along, kept apart for
# this service): the Venus H.264 encoder (/dev/video7) for MediaCodec
service vendor.media.c2-v4l2 /odm/bin/hw/android.hardware.media.c2@1.0-service-v4l2
    class hal
    user media
    group mediadrm drmrpc camera graphics system
    ioprio rt 4
    task_profiles ProcessCapacityHigh
    setenv LD_LIBRARY_PATH /odm/lib64/c2v4l2
    # GPU texture usage for the decoder's buffers (c2-gpu-usage/): without
    # it SurfaceFlinger draws the decoded video black
    setenv LD_PRELOAD /odm/lib64/c2v4l2/libc2_gpu_usage.so
    seclabel u:r:mediacodec:s0

# The decoder takes its output pools from the plugin's allocators (21 to a
# surface, 22 for byte buffers; the app side gets them from c2plugin-shim):
# let CCodec have them made (the vendor's mask allows 18 and 19 only)
on boot
    setprop debug.stagefright.c2-poolmask 0x6c0000
