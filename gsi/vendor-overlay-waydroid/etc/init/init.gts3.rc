# Galaxy Tab S3, native boot of the Waydroid (LineageOS) vendor: system,
# vendor, product and system_ext are mounted by the boot ramdisk (gsi-init).

on fs
    mount_all /vendor/etc/fstab.gts3 --early
    swapon_all /vendor/etc/fstab.gts3

on late-fs
    mount_all /vendor/etc/fstab.gts3 --late

on init
    write /sys/block/zram0/comp_algorithm lz4
    symlink /sdcard /storage/sdcard0
    # MSM8996: CPUs 0-1 little, 2-3 big
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3
